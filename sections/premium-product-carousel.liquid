      var candidates = activeProduct.variants.filter(function(variant) {
        return variant.options[optionIndex] === optionValue;
      });

      var nextVariant = candidates.find(function(variant) {
        if (!variant.available) {
          return false;
        }
        return variant.options.every(function(value, index) {
          if (index === optionIndex) {
            return true;
          }
          var selected = selectedOptions[index];
          return selected == null || selected === value;
        });
      });

      if (!nextVariant) {
        nextVariant = candidates.find(function(variant) {
          return variant.available;
        });
      }

      if (!nextVariant) {
        nextVariant = candidates[0] || null;
      }

      if (!nextVariant) {
        nextVariant = findFirstVariantMatching(selectedOptions, true) || findFirstVariantMatching(selectedOptions, false);
      }

      if (nextVariant) {
        selectedOptions = nextVariant.options.slice();
      }

      updateOptionStates();
      syncDrawer();
    }

    function syncDrawer() {
