      if (!variant) {
        drawerSubmit.disabled = true;
        drawerSubmit.textContent = 'Unavailable';
        drawerSubmit.removeAttribute('data-variant-id');
        if (drawerVariantInput) {
          drawerVariantInput.value = '';
        }
        return;
      }

      drawerSubmit.dataset.variantId = String(variant.id);
      drawerSubmit.disabled = !variant.available;
      drawerSubmit.textContent = variant.available ? 'Add to bag' : 'Sold out';
