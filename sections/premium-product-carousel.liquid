        wrap.setAttribute('data-option-group', '');

        var label = document.createElement('p');
        label.className = 'premium-product-carousel__drawer-option-label variant-selector__label';
        label.innerHTML = optionName + ': <span class="premium-product-carousel__drawer-option-current" data-ppc-option-current-index="' + index + '"></span>';

        var valuesWrap = document.createElement('div');
        valuesWrap.className = 'premium-product-carousel__drawer-option-values variant-selector__options';

        getUniqueValues(index).forEach(function(value) {
          var button = document.createElement('button');
          button.type = 'button';
          var isColor = optionIsColor(optionName);
          button.className = 'premium-product-carousel__drawer-value ' + (isColor ? 'premium-product-carousel__drawer-swatch swatch' : 'premium-product-carousel__drawer-size size-btn');
          button.dataset.ppcOptionIndex = String(index);
          button.dataset.ppcOptionValue = value;
          button.dataset.optionValue = value;
          button.dataset.optionName = optionName;
          button.setAttribute('data-ppc-option-value', '');

          if (isColor) {
            button.setAttribute('data-swatch-name', value);
            button.setAttribute('title', value);
            button.setAttribute('aria-label', value);
          } else {
            button.textContent = value;
            button.setAttribute('aria-label', optionName + ' ' + value);
          }

          button.addEventListener('pointerdown', function(event) {
            event.preventDefault();
            event.stopPropagation();
            setOption(index, value);
          });

          button.addEventListener('click', function(event) {
            event.preventDefault();
            event.stopPropagation();
            setOption(index, value);
          });

          valuesWrap.appendChild(button);
        });

        wrap.appendChild(label);
        wrap.appendChild(valuesWrap);
        drawerOptions.appendChild(wrap);
      });

      if (window.FlyFlow && window.FlyFlow.SwatchColors && typeof window.FlyFlow.SwatchColors.apply === 'function') {
        window.FlyFlow.SwatchColors.apply(drawerOptions);
      }

      updateOptionStates();
      if (drawerQtyInput) {
        drawerQtyInput.value = '1';
      }
      syncDrawer();
    }

    function openDrawer(trigger, productData) {
      if (!drawer || !productData) return;
      lastTrigger = trigger;
      buildDrawer(productData);
      drawer.hidden = false;
      drawer.setAttribute('aria-hidden', 'false');
      document.body.classList.add('drawer-open');
      removeTrap = trapFocus(drawer);
      var first = drawer.querySelector('[data-ppc-option-value]:not([disabled]), .premium-product-carousel__drawer-submit, .premium-product-carousel__drawer-close');
      if (first) first.focus();
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        goTo(currentIndex - step, true);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        goTo(currentIndex + step, true);
      });
    }

    viewport.addEventListener('scroll', function() {
      currentIndex = Math.min(maxIndex, getNearestIndex(viewport.scrollLeft));
      syncControls();
    }, { passive: true });

    viewport.addEventListener('keydown', function(event) {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(currentIndex + step, true);
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(currentIndex - step, true);
      }
    });

    dotsWrap.addEventListener('click', function(event) {
      var dot = event.target.closest('[data-ppc-dot]');
      if (!dot) return;
      var index = parseInt(dot.dataset.ppcDot || '0', 10);
      goTo(index * step, true);
    });

    section.addEventListener('click', function(event) {
      var thumbButton = event.target.closest('[data-ppc-thumb-index]');
      if (thumbButton) {
        var thumbIndex = parseInt(thumbButton.dataset.ppcThumbIndex || '', 10);
        if (Number.isFinite(thumbIndex)) {
          setActiveMedia(thumbIndex);
        }
      }

      var open = event.target.closest('[data-ppc-open-drawer]');
      if (open) {
        var card = open.closest('.premium-product-carousel__card');
        var dataNode = card ? card.querySelector('[data-ppc-product-json]') : null;
        if (dataNode) {
          try {
            openDrawer(open, JSON.parse(dataNode.textContent));
          } catch (_e) {
            // Invalid JSON fallback
          }
        }
      }

      var close = event.target.closest('[data-ppc-drawer-close]');
      if (close) {
        closeDrawer();
      }
    });

    if (drawerSubmit) {
      drawerSubmit.addEventListener('click', function() {
        var variantId = parseInt((drawerVariantInput && drawerVariantInput.value) || drawerSubmit.dataset.variantId || '', 10);
        if (!variantId) return;
        var qty = drawerQtyInput ? parseInt(drawerQtyInput.value || '1', 10) : 1;
        addItem(variantId, qty, drawerSubmit).then(closeDrawer);
      });
    }

    if (drawerQtyInput) {
      drawerQtyInput.addEventListener('change', function() {
        var value = parseInt(drawerQtyInput.value || '1', 10) || 1;
        drawerQtyInput.value = String(Math.max(1, Math.min(99, value)));
      });
    }

    if (drawerQtyDec && drawerQtyInput) {
      drawerQtyDec.addEventListener('click', function() {
        var value = parseInt(drawerQtyInput.value || '1', 10) || 1;
        drawerQtyInput.value = String(Math.max(1, value - 1));
      });
    }

    if (drawerQtyInc && drawerQtyInput) {
      drawerQtyInc.addEventListener('click', function() {
        var value = parseInt(drawerQtyInput.value || '1', 10) || 1;
        drawerQtyInput.value = String(Math.min(99, value + 1));
      });
    }

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') closeDrawer();
    });

    window.addEventListener('resize', recalc);

    recalc();
  })();
</script>

