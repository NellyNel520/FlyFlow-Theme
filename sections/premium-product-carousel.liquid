{% comment %}
  FlyFlow Theme - Premium Product Carousel
  Purpose: Premium no-header product rail with side arrows, dots, and quick add overlay.
  Last updated: 2026-02-19
{% endcomment %}

{% liquid
  assign source_mode = section.settings.source_mode | default: 'manual'
  assign collection_source = section.settings.collection
  assign item_limit = section.settings.item_limit | default: 8
  assign desktop_cards = section.settings.cards_per_view_desktop | default: 3
  assign tablet_cards = section.settings.cards_per_view_tablet | default: 2
  assign mobile_cards = section.settings.cards_per_view_mobile | default: 1
  assign slide_step = section.settings.slide_step | default: 1
%}

<section
  class="premium-product-carousel premium-product-carousel--{{ section.id }} chapter-section chapter-section--container-{{ section.settings.container_width | default: 'contained' }}"
  data-section-id="{{ section.id }}"
  data-loop="{{ section.settings.loop }}"
  data-step="{{ slide_step }}"
  data-desktop="{{ desktop_cards }}"
  data-tablet="{{ tablet_cards }}"
  data-mobile="{{ mobile_cards }}"
>
  <div class="container premium-product-carousel__container">
    <div class="premium-product-carousel__rail-shell">
      <button type="button" class="premium-product-carousel__nav premium-product-carousel__nav--prev" data-ppc-prev aria-label="Previous products">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div class="premium-product-carousel__viewport{% if section.settings.peek_next %} is-peek{% endif %}" data-ppc-viewport tabindex="0" aria-label="Featured products carousel">
        <div class="premium-product-carousel__track" data-ppc-track>
          {% assign rendered_count = 0 %}

          {% if source_mode == 'collection' and collection_source != blank %}
            {% for product in collection_source.products limit: item_limit %}
              <article class="premium-product-carousel__card" data-ppc-card>
                <a href="{{ product.url }}" class="premium-product-carousel__card-link">
                  <div class="premium-product-carousel__media">
                    {% if product.featured_image %}
                      {{ product.featured_image | image_url: width: 980 | image_tag: class: 'premium-product-carousel__image', loading: 'lazy', widths: '320,480,640,840,980', sizes: '(min-width: 1100px) 31vw, (min-width: 750px) 45vw, 82vw', alt: product.title }}
                    {% endif %}
                  </div>
                  <div class="premium-product-carousel__meta">
                    <h3 class="premium-product-carousel__title">{{ product.title }}</h3>
                    {% if section.settings.show_price %}
                      <p class="premium-product-carousel__price">{{ product.price | money }}</p>
                    {% endif %}
                    {% render 'premium-product-carousel-swatches', product: product %}
                  </div>
                </a>

                <div class="premium-product-carousel__overlay">
                  {% if product.has_only_default_variant %}
                    <button
                      type="button"
                      class="premium-product-carousel__quick-add"
                      data-add-to-cart
                      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      data-add-text="Quick add"
                      aria-label="Quick add {{ product.title }}"
                    >
                      Quick add
                    </button>
                  {% else %}
                    <button
                      type="button"
                      class="premium-product-carousel__quick-add"
                      data-ppc-open-drawer
                      aria-label="Choose options for {{ product.title }}"
                    >
                      Quick add
                    </button>
                    <script type="application/json" data-ppc-product-json>
                      {
                        "id": {{ product.id }},
                        "title": {{ product.title | json }},
                        "image": {{ product.featured_image | image_url: width: 480 | json }},
                        "description": {{ product.description | strip_html | strip_newlines | truncate: 220 | json }},
                        "media": [
                          {% assign media_output_count = 0 %}
                          {% for media in product.media %}
                            {% if media.media_type == 'image' %}
                              {% if media_output_count > 0 %},{% endif %}
                              {
                                "id": {{ media.id }},
                                "src": {{ media | image_url: width: 960 | json }},
                                "alt": {{ media.alt | default: product.title | json }}
                              }
                              {% assign media_output_count = media_output_count | plus: 1 %}
                            {% endif %}
                          {% endfor %}
                        ],
                        "price": {{ product.price | json }},
                        "options": [{% for option_name in product.options %}{{ option_name | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
                        "variants": [
                          {% for variant in product.variants %}
                            {
                              "id": {{ variant.id }},
                              "available": {{ variant.available | json }},
                              "price": {{ variant.price | json }},
                              "featured_media_id": {{ variant.featured_media.id | default: 0 | json }},
                              "options": [{% for option_value in variant.options %}{{ option_value | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
                            }{% unless forloop.last %},{% endunless %}
                          {% endfor %}
                        ]
                      }
                    </script>
                  {% endif %}
                </div>
              </article>
              {% assign rendered_count = rendered_count | plus: 1 %}
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              {% if rendered_count >= item_limit %}{% break %}{% endif %}
              {% if block.settings.product != blank %}
                {% assign product = block.settings.product %}
                <article class="premium-product-carousel__card" data-ppc-card {{ block.shopify_attributes }}>
                  <a href="{{ product.url }}" class="premium-product-carousel__card-link">
                    <div class="premium-product-carousel__media">
                      {% if product.featured_image %}
                        {{ product.featured_image | image_url: width: 980 | image_tag: class: 'premium-product-carousel__image', loading: 'lazy', widths: '320,480,640,840,980', sizes: '(min-width: 1100px) 31vw, (min-width: 750px) 45vw, 82vw', alt: product.title }}
                      {% endif %}
                    </div>
                    <div class="premium-product-carousel__meta">
                      <h3 class="premium-product-carousel__title">{{ product.title }}</h3>
                      {% if section.settings.show_price %}
                        <p class="premium-product-carousel__price">{{ product.price | money }}</p>
                      {% endif %}
                      {% render 'premium-product-carousel-swatches', product: product %}
                    </div>
                  </a>

                  <div class="premium-product-carousel__overlay">
                    {% if product.has_only_default_variant %}
                      <button
                        type="button"
                        class="premium-product-carousel__quick-add"
                        data-add-to-cart
                        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        data-add-text="Quick add"
                        aria-label="Quick add {{ product.title }}"
                      >
                        Quick add
                      </button>
                    {% else %}
                      <button
                        type="button"
                        class="premium-product-carousel__quick-add"
                        data-ppc-open-drawer
                        aria-label="Choose options for {{ product.title }}"
                      >
                        Quick add
                      </button>
                      <script type="application/json" data-ppc-product-json>
                        {
                          "id": {{ product.id }},
                          "title": {{ product.title | json }},
                          "image": {{ product.featured_image | image_url: width: 480 | json }},
                          "description": {{ product.description | strip_html | strip_newlines | truncate: 220 | json }},
                          "media": [
                            {% assign media_output_count = 0 %}
                            {% for media in product.media %}
                              {% if media.media_type == 'image' %}
                                {% if media_output_count > 0 %},{% endif %}
                                {
                                  "id": {{ media.id }},
                                  "src": {{ media | image_url: width: 960 | json }},
                                  "alt": {{ media.alt | default: product.title | json }}
                                }
                                {% assign media_output_count = media_output_count | plus: 1 %}
                              {% endif %}
                            {% endfor %}
                          ],
                          "price": {{ product.price | json }},
                          "options": [{% for option_name in product.options %}{{ option_name | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
                          "variants": [
                            {% for variant in product.variants %}
                              {
                                "id": {{ variant.id }},
                                "available": {{ variant.available | json }},
                                "price": {{ variant.price | json }},
                                "featured_media_id": {{ variant.featured_media.id | default: 0 | json }},
                                "options": [{% for option_value in variant.options %}{{ option_value | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
                              }{% unless forloop.last %},{% endunless %}
                            {% endfor %}
                          ]
                        }
                      </script>
                    {% endif %}
                  </div>
                </article>
                {% assign rendered_count = rendered_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if rendered_count == 0 %}
            {% for i in (1..4) %}
              <article class="premium-product-carousel__card premium-product-carousel__card--placeholder" data-ppc-card>
                <a href="{{ routes.collections_url }}" class="premium-product-carousel__card-link">
                  <div class="premium-product-carousel__media">
                    {{ 'product-' | append: i | placeholder_svg_tag: 'premium-product-carousel__image premium-product-carousel__placeholder' }}
                  </div>
                  <div class="premium-product-carousel__meta">
                    <h3 class="premium-product-carousel__title">Add products in theme editor</h3>
                  </div>
                </a>
              </article>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <button type="button" class="premium-product-carousel__nav premium-product-carousel__nav--next" data-ppc-next aria-label="Next products">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <div class="premium-product-carousel__dots" data-ppc-dots aria-label="Carousel pagination"></div>
  </div>

  <div class="premium-product-carousel__drawer" data-ppc-drawer aria-hidden="true" hidden>
    <button class="premium-product-carousel__drawer-backdrop" type="button" data-ppc-drawer-close tabindex="-1" aria-label="Close quick add"></button>
    <div class="premium-product-carousel__drawer-panel" role="dialog" aria-modal="true" aria-labelledby="ppc-drawer-title-{{ section.id }}">
      <button class="premium-product-carousel__drawer-close" type="button" data-ppc-drawer-close aria-label="Close quick add">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
      <div class="premium-product-carousel__drawer-media" data-ppc-drawer-media hidden>
        <div class="premium-product-carousel__drawer-main-media">
          <img class="premium-product-carousel__drawer-image" data-ppc-drawer-image alt="" loading="lazy" width="720" height="900">
        </div>
        <div class="premium-product-carousel__drawer-thumbs" data-ppc-drawer-thumbs aria-label="Product image thumbnails"></div>
      </div>
      <p class="premium-product-carousel__drawer-kicker">Quick add</p>
      <h3 class="premium-product-carousel__drawer-title" id="ppc-drawer-title-{{ section.id }}"></h3>
      <p class="premium-product-carousel__drawer-price" data-ppc-drawer-price></p>
      <p class="premium-product-carousel__drawer-description" data-ppc-drawer-description></p>
      <form class="premium-product-carousel__drawer-form" data-product-form>
        <input type="hidden" name="id" data-ppc-variant-id value="">
        <div class="premium-product-carousel__drawer-options" data-ppc-drawer-options></div>
        <div class="premium-product-carousel__drawer-quantity" data-ppc-drawer-quantity>
          <p class="premium-product-carousel__drawer-option-label">Quantity</p>
          <div class="premium-product-carousel__drawer-qty-control">
            <button type="button" class="premium-product-carousel__drawer-qty-btn" data-ppc-qty-dec aria-label="Decrease quantity">-</button>
            <input class="premium-product-carousel__drawer-qty-input" data-ppc-qty-input type="number" min="1" value="1" inputmode="numeric" aria-label="Quantity">
            <button type="button" class="premium-product-carousel__drawer-qty-btn" data-ppc-qty-inc aria-label="Increase quantity">+</button>
          </div>
        </div>
        <button class="premium-product-carousel__drawer-submit" type="button" data-ppc-drawer-submit data-add-to-cart data-add-text="Add to bag" data-sold-out-text="Sold out">Add to bag</button>
      </form>
    </div>
  </div>
</section>

<style>
  .premium-product-carousel--{{ section.id }} {
    --ppc-gap: clamp(14px, 1.8vw, 24px);
    --ppc-radius: 0px;
    --ppc-border: rgba(14, 14, 18, 0.08);
    --ppc-shadow: 0 12px 30px rgba(12, 14, 20, 0.08);
    --ppc-overlay: rgba(10, 12, 18, 0.32);
    --ppc-overlay-blur: none;
    --ppc-peek: {% if section.settings.peek_next %}8%{% else %}0px{% endif %};
    --ppc-cards: {{ desktop_cards }};
    background: transparent;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__container {
    position: relative;
    width: 100%;
  }

  .premium-product-carousel--{{ section.id }}.chapter-section--container-full > .container {
    padding-inline: 0 !important;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__rail-shell {
    position: relative;
    width: 100%;
    padding-inline: 0;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--ppc-radius);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__viewport::-webkit-scrollbar {
    display: none;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--ppc-cards) - 1) * var(--ppc-gap) - var(--ppc-peek)) / var(--ppc-cards));
    gap: var(--ppc-gap);
    padding-right: var(--ppc-peek);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__card {
    position: relative;
    scroll-snap-align: start;
    border-radius: 0 0 12px 12px;
    overflow: hidden;
    border: 1px solid var(--ppc-border);
    background: #ffffff;
    box-shadow: var(--ppc-shadow);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__card-link {
    display: block;
    color: inherit;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__media {
    aspect-ratio: 4 / 5;
    background: #ffffff;
    overflow: hidden;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__meta {
    padding: 12px 12px 18px;
    display: grid;
    gap: 6px;
    background: transparent;
    transition: background-color var(--transition-fast);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(0.98rem, 1.15vw, 1.12rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    color: #0f1116;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__price {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__swatches {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__swatch {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.14);
    background: var(--swatch-color, #d4d1cc);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__swatch-overflow {
    font-size: 0.68rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    background: linear-gradient(180deg, transparent 35%, var(--ppc-overlay) 100%);
    backdrop-filter: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-base);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__quick-add {
    width: 100%;
    min-height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: #0f1116;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__card:hover .premium-product-carousel__overlay,
  .premium-product-carousel--{{ section.id }} .premium-product-carousel__card:focus-within .premium-product-carousel__overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__card:hover .premium-product-carousel__image {
    transform: scale(1.02);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__card:hover .premium-product-carousel__meta,
  .premium-product-carousel--{{ section.id }} .premium-product-carousel__card:focus-within .premium-product-carousel__meta {
    background: rgba(239, 240, 243, 0.72);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__quick-add:hover {
    transform: translateY(-1px);
    background: #ffffff;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.36);
    border-radius: 999px;
    background: rgba(20, 22, 28, 0.42);
    backdrop-filter: blur(6px);
    color: #ffffff;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast), opacity var(--transition-fast), background-color var(--transition-fast);
    opacity: 0;
    pointer-events: none;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__nav svg {
    width: 16px;
    height: 16px;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__nav--prev {
    left: clamp(4px, 0.9vw, 12px);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__nav--next {
    right: clamp(4px, 0.9vw, 12px);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__nav:hover {
    transform: translateY(-50%) translateY(-1px);
    background: rgba(20, 22, 28, 0.56);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__rail-shell:hover .premium-product-carousel__nav,
  .premium-product-carousel--{{ section.id }} .premium-product-carousel__rail-shell:focus-within .premium-product-carousel__nav {
    opacity: 1;
    pointer-events: auto;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__nav[disabled] {
    opacity: 0.4;
    pointer-events: none;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__dots {
    position: absolute;
    left: 50%;
    bottom: 10px;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    border: 0;
    background: rgba(10, 12, 18, 0.24);
    transition: width var(--transition-fast), background-color var(--transition-fast);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__dot.is-active {
    width: 20px;
    background: rgba(10, 12, 18, 0.72);
  }

  .premium-product-carousel--{{ section.id }} .premium-product-carousel__nav:focus-visible,
  .premium-product-carousel--{{ section.id }} .premium-product-carousel__dot:focus-visible,
  .premium-product-carousel--{{ section.id }} .premium-product-carousel__quick-add:focus-visible,
  .premium-product-carousel--{{ section.id }} .premium-product-carousel__viewport:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .premium-product-carousel__drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
  }

  .premium-product-carousel__drawer-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.45);
  }

  .premium-product-carousel__drawer-panel {
    position: absolute;
    right: 0;
    top: 0;
    width: min(430px, 100%);
    height: 100%;
    background: #ffffff;
    padding: 16px 16px 18px;
    display: grid;
    grid-template-rows: auto minmax(280px, 60%) auto auto 1fr auto;
    gap: 11px;
    overflow-y: auto;
  }

  .premium-product-carousel__drawer-close {
    width: 36px;
    height: 36px;
    border: 0;
    background: transparent;
    justify-self: end;
  }

  .premium-product-carousel__drawer-kicker {
    margin: 0;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .premium-product-carousel__drawer-title {
    margin: 2px 0 0;
    font-size: 1.08rem;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .premium-product-carousel__drawer-price {
    margin: 0;
    font-size: 0.86rem;
    color: var(--color-text-secondary);
  }

  .premium-product-carousel__drawer-description {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .premium-product-carousel__drawer-options {
    display: grid;
    gap: 14px;
    align-content: start;
    padding-top: 4px;
  }

  .premium-product-carousel__drawer-option,
  .premium-product-carousel__drawer .variant-selector {
    display: grid;
    gap: 8px;
  }

  .premium-product-carousel__drawer-option-label,
  .premium-product-carousel__drawer .variant-selector__label {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .premium-product-carousel__drawer-option-current,
