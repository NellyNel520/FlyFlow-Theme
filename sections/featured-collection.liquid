{% comment %}
  FlyFlow Theme - Featured Collection Section
  Purpose: Display a grid of products from a selected collection.
  Dependencies: snippets/product-card.liquid, theme.css
  Last modified: 2026-02-17
{% endcomment %}

<section
  class="section featured-collection featured-collection--{{ section.id }} chapter-section chapter-section--spacing-{{ section.settings.section_density | default: section.settings.section_spacing | default: 'standard' }} chapter-section--container-{{ section.settings.container_width | default: 'contained' }}{% if section.settings.show_divider_top %} chapter-section--divider-top{% endif %}{% if section.settings.enable_reveal %} chapter-section--reveal{% endif %}"
  data-section-id="{{ section.id }}"
  data-enable-reveal="{{ section.settings.enable_reveal }}"
>
  <div class="container">
    {% if section.settings.heading != blank %}
      <div class="collection-header" style="padding-bottom:var(--space-xl)">
        <h2 class="collection-header__title">{{ section.settings.heading }}</h2>
        {% if section.settings.collection %}
          <a href="{{ section.settings.collection.url }}" class="text-accent text-sm mt-sm" style="display:inline-block">
            {{ 'general.view_all' | t }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="product-grid featured-collection__grid">
      {% if section.settings.collection %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product, dual_actions: true, show_vendor: false, force_quick_buy: true, use_premium_quick_add: true %}
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          <div class="product-card">
            <div class="product-card__media">
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'product-card__image' }}
            </div>
            <div class="product-card__info">
              <p class="product-card__vendor">FlyFlow</p>
              <h3 class="product-card__title">
                {%- case forloop.index -%}
                  {%- when 1 -%}Aero Runner Sneaker
                  {%- when 2 -%}Midnight Crossbody Bag
                  {%- when 3 -%}Velocity Slim Jogger
                  {%- when 4 -%}Cloud 9 Platform Boot
                  {%- when 5 -%}Drift Oversized Hoodie
                  {%- when 6 -%}Flyknit Lace-Up Oxford
                  {%- when 7 -%}Horizon Aviator Sunglasses
                  {%- when 8 -%}Stealth Cargo Pant
                  {%- else -%}FlyFlow Essential {{ forloop.index }}
                {%- endcase -%}
              </h3>
              <div class="product-card__price">
                <span>
                  {%- case forloop.index -%}
                    {%- when 1 -%}$185.00
                    {%- when 2 -%}$245.00
                    {%- when 3 -%}$128.00
                    {%- when 4 -%}$295.00
                    {%- when 5 -%}$165.00
                    {%- when 6 -%}$220.00
                    {%- when 7 -%}$175.00
                    {%- when 8 -%}$155.00
                    {%- else -%}$150.00
                  {%- endcase -%}
                </span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  .featured-collection--{{ section.id }} .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.4vw, 18px);
  }

  .featured-collection--{{ section.id }} .product-card {
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 8px 20px rgba(10, 12, 16, 0.06);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .featured-collection--{{ section.id }} .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(10, 12, 16, 0.1);
  }

  .featured-collection--{{ section.id }} .product-card__media {
    border-radius: 0;
    aspect-ratio: 4 / 4.75;
    background: #fff;
  }

  @media (hover: hover) and (pointer: fine) {
    .featured-collection--{{ section.id }} .product-card__image--hover {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
    }

    .featured-collection--{{ section.id }} .product-card:hover .product-card__image--hover,
    .featured-collection--{{ section.id }} .product-card:focus-within .product-card__image--hover {
      opacity: 1;
    }

    .featured-collection--{{ section.id }} .product-card:hover .product-card__image {
      transform: scale(1.03);
    }
  }

  .featured-collection--{{ section.id }} .product-card__info {
    padding: 12px 12px 18px;
  }

  .featured-collection--{{ section.id }} .product-card__title {
    margin: 0 0 4px;
    font-size: clamp(0.98rem, 1.15vw, 1.12rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .featured-collection--{{ section.id }} .product-card__quick-buy--dual {
    padding: 12px;
    background: linear-gradient(180deg, rgba(10, 12, 16, 0) 0%, rgba(10, 12, 16, 0.3) 100%);
  }

  .featured-collection--{{ section.id }} .product-card__quick-buy {
    opacity: 0;
    transform: translateY(100%);
    pointer-events: none;
  }

  .featured-collection--{{ section.id }} .product-card:hover .product-card__quick-buy,
  .featured-collection--{{ section.id }} .product-card:focus-within .product-card__quick-buy {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .featured-collection--{{ section.id }} .product-card__quick-buy-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .featured-collection--{{ section.id }} .product-card__quick-buy-actions .btn {
    min-height: 40px;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    border-radius: 999px;
  }

  .featured-collection--{{ section.id }} .product-card__quick-buy-actions .btn--primary {
    background: #0f1116;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .featured-collection--{{ section.id }} .product-card__quick-buy-actions .btn--secondary {
    background: rgba(255, 255, 255, 0.93);
    color: #0f1116;
    border: 1px solid rgba(0, 0, 0, 0.12);
  }

  .featured-collection--{{ section.id }} .product-card__price {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  .featured-collection--{{ section.id }} .product-card__swatches {
    margin-top: 4px;
  }

  .featured-collection--{{ section.id }} .product-card__swatch {
    width: 12px;
    height: 12px;
  }

  @media (max-width: 1023px) {
    .featured-collection--{{ section.id }} .featured-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .featured-collection--{{ section.id }} .product-card__media {
      aspect-ratio: 4 / 4.9;
    }

    .featured-collection--{{ section.id }} .product-card__info {
      padding: 10px 10px 14px;
    }

    .featured-collection--{{ section.id }} .product-card__title {
      font-size: 0.98rem;
    }

    .featured-collection--{{ section.id }} .product-card__quick-buy--dual {
      padding: 10px;
    }

    .featured-collection--{{ section.id }} .product-card__quick-buy {
      position: absolute;
      left: 10px;
      right: 10px;
      bottom: 10px;
      opacity: 0;
      transform: translateY(100%);
      padding: 0;
      margin-top: 0;
      z-index: 3;
      pointer-events: none;
    }

    .featured-collection--{{ section.id }} .product-card__quick-buy--dual {
      background: none;
    }
  }

  @media (max-width: 767px) {
    .featured-collection--{{ section.id }} .featured-collection__grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .featured-collection--{{ section.id }} .product-card {
      max-width: none;
      width: 100%;
      margin-inline: auto;
      border-radius: 14px;
    }

    .featured-collection--{{ section.id }} .product-card__media {
      aspect-ratio: 4 / 4.45;
    }

    .featured-collection--{{ section.id }} .product-card__info {
      padding: 9px 10px 11px;
    }

    .featured-collection--{{ section.id }} .product-card__title {
      font-size: 0.93rem;
      letter-spacing: 0.02em;
    }

    .featured-collection--{{ section.id }} .product-card__price {
      font-size: 0.77rem;
    }

    .featured-collection--{{ section.id }} .product-card__quick-buy-actions .btn {
      min-height: 36px;
      font-size: 0.66rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .featured-collection--{{ section.id }} .product-card {
      transition: none;
    }

    .featured-collection--{{ section.id }} .product-card:hover {
      transform: none;
    }
  }
</style>

<script>
  (function() {
    var section = document.querySelector('.featured-collection--{{ section.id }}');
    if (!section) return;

    function parseProductData(trigger) {
      var card = trigger.closest('[data-product-card]');
      if (!card) return null;
      var dataNode = card.querySelector('[data-featured-product-json]');
      if (!dataNode) return null;
      try {
        return JSON.parse(dataNode.textContent);
      } catch (error) {
        return null;
      }
    }

    function openPremiumQuickAdd(trigger, productData) {
      var registry = window.FlyFlow && window.FlyFlow.PremiumQuickAdd;
      if (!registry) return false;
      var ids = Object.keys(registry);
      if (!ids.length) return false;
      for (var i = 0; i < ids.length; i += 1) {
        var adapter = registry[ids[i]];
        if (adapter && typeof adapter.open === 'function') {
          adapter.open(trigger, productData);
          return true;
        }
      }
      return false;
    }

    section.addEventListener('click', function(event) {
      var trigger = event.target.closest('[data-featured-open-drawer]');
      if (!trigger || !section.contains(trigger)) return;
      event.preventDefault();
      var productData = parseProductData(trigger);
      if (!productData) return;

      if (openPremiumQuickAdd(trigger, productData)) return;

      if (productData.handle) {
        var fallback = document.createElement('button');
        fallback.type = 'button';
        fallback.hidden = true;
        fallback.setAttribute('data-quick-view', productData.handle);
        document.body.appendChild(fallback);
        fallback.click();
        fallback.remove();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "section_density",
      "label": "Section density",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "Section spacing",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_divider_top",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "contained",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Enable reveal",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
