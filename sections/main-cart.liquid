{% comment %}
  FlyFlow Theme - Main Cart Page Section
  Purpose: Full cart page with shipping progress bar, order notes,
           upsell section, trust badges, and AJAX quantity updates.
  Dependencies: theme.js (Cart module)
  Last modified: 2026-02-17
{% endcomment %}

<section class="section" data-section-id="{{ section.id }}" data-cart-page>
  <div class="container" style="max-width:1060px">

    {%- comment -%} Page heading with item count {%- endcomment -%}
    <div class="text-center mb-xl">
      <p class="overline mb-sm">{{ 'cart.title' | t }}</p>
      <h1>{{ 'cart.title' | t }}{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</h1>
    </div>

    {% if cart.item_count > 0 %}

      {%- comment -%} Shipping progress bar {%- endcomment -%}
      {% if settings.cart_shipping_threshold != blank and settings.cart_shipping_threshold != '0' %}
        {% assign threshold_cents = settings.cart_shipping_threshold | times: 100 %}
        {% assign remaining_cents = threshold_cents | minus: cart.total_price %}
        {% assign progress = cart.total_price | times: 100 | divided_by: threshold_cents %}
        {% if progress > 100 %}{% assign progress = 100 %}{% endif %}
        {%- capture spend_msg %}{{ 'cart.shipping_bar.spend_more' | t: amount: 'AMOUNT_PLACEHOLDER' }}{% endcapture -%}

        <div
          class="shipping-bar{% if remaining_cents <= 0 %} shipping-bar--qualified{% endif %}"
          style="margin-bottom:var(--space-2xl);padding:var(--space-md) var(--space-lg);background:var(--color-surface)"
          data-shipping-bar
          data-threshold="{{ settings.cart_shipping_threshold }}"
          data-spend-message="{{ spend_msg }}"
          data-qualified-message="{{ 'cart.shipping_bar.qualified' | t }}"
        >
          <div class="shipping-bar__text" style="text-align:center;margin-bottom:var(--space-sm)">
            <span data-shipping-message style="font-size:0.8125rem;letter-spacing:0.04em">
              {% if remaining_cents > 0 %}
                {{ spend_msg | replace: 'AMOUNT_PLACEHOLDER', remaining_cents | money }}
              {% else %}
                {{ 'cart.shipping_bar.qualified' | t }}
              {% endif %}
            </span>
          </div>
          <div class="shipping-bar__track" style="height:3px;background:var(--color-border);overflow:hidden">
            <div class="shipping-bar__fill" data-shipping-fill style="height:100%;background:var(--color-accent);width:{{ progress }}%;transition:width 0.6s cubic-bezier(0.25,0.1,0.25,1)"></div>
          </div>
        </div>
      {% endif %}

      <div style="display:grid;grid-template-columns:1fr 380px;gap:var(--space-2xl);align-items:start" class="cart-page__grid">

        {%- comment -%} Cart items column {%- endcomment -%}
        <div>
          {%- comment -%} Column headers {%- endcomment -%}
          <div class="hidden-mobile" style="display:grid;grid-template-columns:auto 1fr auto auto;gap:var(--space-lg);padding-bottom:var(--space-sm);border-bottom:1px solid var(--color-border);margin-bottom:var(--space-md)">
            <span style="width:100px"></span>
            <span class="overline" style="font-size:0.625rem">Product</span>
            <span class="overline" style="font-size:0.625rem">Quantity</span>
            <span class="overline" style="font-size:0.625rem;text-align:right">Total</span>
          </div>

          <form action="{{ routes.cart_url }}" method="post" id="cart-form">
            <div data-cart-page-items>
              {% for item in cart.items %}
                <div class="cart-item" style="display:grid;grid-template-columns:100px 1fr auto auto;gap:var(--space-lg);padding:var(--space-lg) 0;border-bottom:1px solid var(--color-border);align-items:center" data-cart-item data-line-key="{{ item.key }}">

                  {%- comment -%} Product image {%- endcomment -%}
                  <a href="{{ item.url }}" style="aspect-ratio:3/4;overflow:hidden;display:block">
                    {% if item.image %}
                      {{ item.image | image_url: width: 200 | image_tag: alt: item.title, loading: 'lazy', style: 'width:100%;height:100%;object-fit:cover' }}
                    {% endif %}
                  </a>

                  {%- comment -%} Product info {%- endcomment -%}
                  <div>
                    <a href="{{ item.url }}" class="cart-item__title" style="font-size:0.9375rem;font-weight:600;letter-spacing:0.02em">{{ item.product.title }}</a>
                    {% unless item.variant.title == 'Default Title' %}
                      <p class="cart-item__variant" style="font-size:0.8125rem;color:var(--color-text-secondary);margin-top:2px">{{ item.variant.title }}</p>
                    {% endunless %}
                    <p style="font-size:0.8125rem;color:var(--color-text-secondary);margin-top:var(--space-xs)">{{ item.original_price | money }}</p>
                    <button type="button" class="cart-item__remove" data-cart-remove="{{ item.key }}" style="font-size:0.6875rem;text-transform:uppercase;letter-spacing:0.1em;margin-top:var(--space-sm);opacity:0.5;transition:opacity var(--transition-fast)">{{ 'cart.remove' | t }}</button>
                  </div>

                  {%- comment -%} Quantity selector {%- endcomment -%}
                  <div class="quantity-selector">
                    <button type="button" class="quantity-selector__btn" data-cart-qty="minus" data-line-key="{{ item.key }}" aria-label="{{ 'products.decrease_quantity' | t }}">&minus;</button>
                    <input type="number" class="quantity-selector__input" name="updates[]" value="{{ item.quantity }}" min="0" data-cart-qty-input aria-label="{{ 'products.quantity' | t }}">
                    <button type="button" class="quantity-selector__btn" data-cart-qty="plus" data-line-key="{{ item.key }}" aria-label="{{ 'products.increase_quantity' | t }}">&plus;</button>
                  </div>

                  {%- comment -%} Line total {%- endcomment -%}
                  <div style="text-align:right;min-width:80px">
                    <span style="font-weight:600;font-size:0.9375rem;letter-spacing:0.02em">{{ item.final_line_price | money }}</span>
                    {% if item.original_line_price != item.final_line_price %}
                      <br><span style="text-decoration:line-through;color:var(--color-text-secondary);font-size:0.8125rem">{{ item.original_line_price | money }}</span>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          </form>

          {%- comment -%} Order notes {%- endcomment -%}
          <div style="margin-top:var(--space-xl)">
            <label class="overline" style="font-size:0.625rem;display:block;margin-bottom:var(--space-sm)" for="cart-note">Order Notes</label>
            <textarea
              id="cart-note"
              name="note"
              form="cart-form"
              class="form__input"
              rows="3"
              placeholder="{{ 'cart.note_placeholder' | t }}"
              style="resize:vertical;font-size:0.8125rem"
              data-cart-note
            >{{ cart.note }}</textarea>
          </div>
        </div>

        {%- comment -%} Summary sidebar {%- endcomment -%}
        <div style="position:sticky;top:calc(var(--space-xl) + 80px)">
          <div style="background:var(--color-surface);padding:var(--space-xl)">
            <h2 class="overline" style="font-size:0.6875rem;margin-bottom:var(--space-lg)">Order Summary</h2>

            <div style="display:flex;justify-content:space-between;padding:var(--space-sm) 0;font-size:0.875rem">
              <span>Subtotal</span>
              <span data-cart-subtotal>{{ cart.total_price | money }}</span>
            </div>

            <div style="display:flex;justify-content:space-between;padding:var(--space-sm) 0;font-size:0.875rem;color:var(--color-text-secondary)">
              <span>Shipping</span>
              <span>Calculated at checkout</span>
            </div>

            {% if cart.total_discount > 0 %}
              <div style="display:flex;justify-content:space-between;padding:var(--space-sm) 0;font-size:0.875rem;color:var(--color-sale)">
                <span>Discount</span>
                <span>-{{ cart.total_discount | money }}</span>
              </div>
            {% endif %}

            <div class="divider" style="margin:var(--space-md) 0"></div>

            <div style="display:flex;justify-content:space-between;padding:var(--space-sm) 0;font-size:1.125rem;font-weight:600;letter-spacing:0.03em">
              <span>Total</span>
              <span data-cart-total>{{ cart.total_price | money }}</span>
            </div>

            <a href="/checkout" class="btn btn--primary btn--full btn--lg" style="margin-top:var(--space-lg)">
              {{ 'cart.checkout' | t }}
            </a>

            <a href="{{ routes.all_products_collection_url }}" style="display:block;text-align:center;margin-top:var(--space-md);font-size:0.6875rem;text-transform:uppercase;letter-spacing:0.12em;color:var(--color-text-secondary)">
              {{ 'cart.continue_shopping' | t }}
            </a>

            {%- comment -%} Trust badges {%- endcomment -%}
            <div style="margin-top:var(--space-xl);padding-top:var(--space-lg);border-top:1px solid var(--color-border)">
              <div style="display:flex;flex-direction:column;gap:var(--space-sm)">
                <div style="display:flex;align-items:center;gap:var(--space-sm);font-size:0.75rem;color:var(--color-text-secondary)">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  Secure Checkout
                </div>
                <div style="display:flex;align-items:center;gap:var(--space-sm);font-size:0.75rem;color:var(--color-text-secondary)">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  </svg>
                  Authenticity Guaranteed
                </div>
                <div style="display:flex;align-items:center;gap:var(--space-sm);font-size:0.75rem;color:var(--color-text-secondary)">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
                  </svg>
                  Complimentary Returns
                </div>
              </div>
            </div>
          </div>

          {%- comment -%} Upsell / Complete the Look {%- endcomment -%}
          {% if section.settings.upsell_collection != blank %}
            <div style="margin-top:var(--space-xl)">
              <h3 class="overline" style="font-size:0.6875rem;margin-bottom:var(--space-md)">{{ 'cart.upsell_title' | t }}</h3>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-md)">
                {% for product in section.settings.upsell_collection.products limit: 2 %}
                  {% assign in_cart = false %}
                  {% for item in cart.items %}
                    {% if item.product.id == product.id %}{% assign in_cart = true %}{% endif %}
                  {% endfor %}
                  {% unless in_cart %}
                    <div style="text-align:center">
                      <a href="{{ product.url }}" style="display:block;aspect-ratio:3/4;overflow:hidden;margin-bottom:var(--space-sm)">
                        {{ product.featured_image | image_url: width: 300 | image_tag: alt: product.title, loading: 'lazy', style: 'width:100%;height:100%;object-fit:cover' }}
                      </a>
                      <a href="{{ product.url }}" style="font-size:0.75rem;font-weight:600;letter-spacing:0.02em">{{ product.title }}</a>
                      <p style="font-size:0.75rem;color:var(--color-text-secondary);margin-top:2px">{{ product.price | money }}</p>
                    </div>
                  {% endunless %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

    {% else %}

      {%- comment -%} Empty cart state {%- endcomment -%}
      <div class="text-center" style="padding:var(--space-3xl) 0">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="var(--color-border)" stroke-width="1" aria-hidden="true" style="margin:0 auto var(--space-lg)">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <p class="text-secondary mb-lg" style="font-size:1.125rem">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ 'cart.continue_shopping' | t }}</a>
      </div>

    {% endif %}
  </div>
</section>

<style>
  @media (max-width: 767px) {
    .cart-page__grid {
      grid-template-columns: 1fr !important;
    }
    .cart-item {
      grid-template-columns: 80px 1fr !important;
      grid-template-rows: auto auto;
    }
    .cart-item .quantity-selector {
      grid-column: 2;
    }
    .cart-item > div:last-child {
      grid-column: 2;
      text-align: left !important;
    }
  }
  .cart-item__remove:hover {
    opacity: 1 !important;
  }
</style>

<script>
  /**
   * Cart Page AJAX Updates
   * Handles quantity changes and note saving without full page reload.
   */
  (function() {
    var noteInput = document.querySelector('[data-cart-note]');
    if (noteInput) {
      var saveTimer;
      noteInput.addEventListener('input', function() {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(function() {
          fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ note: noteInput.value })
          });
        }, 600);
      });
    }

    /* Listen for cart updates to refresh page totals */
    document.addEventListener('click', function(e) {
      var qtyBtn = e.target.closest('[data-cart-qty]');
      var removeBtn = e.target.closest('[data-cart-remove]');
      if (qtyBtn || removeBtn) {
        /* After a short delay, refresh the page to get updated server-rendered totals */
        setTimeout(function() {
          fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
            .then(function(r) { return r.json(); })
            .then(function(cart) {
              var subtotal = document.querySelector('[data-cart-subtotal]');
              var total = document.querySelector('[data-cart-total]');
              if (subtotal) subtotal.textContent = FlyFlow.formatMoney(cart.total_price);
              if (total) total.textContent = FlyFlow.formatMoney(cart.total_price);
            });
        }, 500);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Cart Page",
  "settings": [
    {
      "type": "collection",
      "id": "upsell_collection",
      "label": "Upsell collection",
      "info": "Products shown as \"Complete the Look\" suggestions"
    }
  ]
}
{% endschema %}
