{% comment %}
  FlyFlow Theme - Related Products (Premium Carousel)
  Purpose: Display related products with a premium carousel layout.
  Notes: Keeps current related-product source logic intact.
{% endcomment %}

{{ 'section-related-products-premium.css' | asset_url | stylesheet_tag }}
<script src="{{ 'related-products-carousel.js' | asset_url }}" defer></script>

{% assign rp_products = product.collections.first.products %}
{% assign rp_count = 0 %}
{% capture rp_cards %}
  {% for item in rp_products limit: section.settings.products_to_show %}
    {% if item.id != product.id and rp_count < section.settings.products_to_show %}
      {% assign rp_count = rp_count | plus: 1 %}
      {% render 'related-product-card-premium', product: item, section: section %}
    {% endif %}
  {% endfor %}
{% endcapture %}

{% if rp_count == 0 %}
  {% assign rp_cards = '' %}
  {% capture rp_cards %}
    {% for item in collections.all.products limit: section.settings.products_to_show %}
      {% if item.id != product.id %}
        {% render 'related-product-card-premium', product: item, section: section %}
      {% endif %}
    {% endfor %}
  {% endcapture %}
{% endif %}

<section
  class="rp-premium section"
  data-section-id="{{ section.id }}"
  style="
    --rp-max-width: {{ section.settings.section_max_width }}px;
    --rp-padding-top: {{ section.settings.section_padding_top }}px;
    --rp-padding-bottom: {{ section.settings.section_padding_bottom }}px;
    --rp-cards-desktop: {{ section.settings.cards_per_view_desktop }};
    --rp-cards-tablet: {{ section.settings.cards_per_view_tablet }};
    --rp-card-radius: 17px;
  "
>
  <div class="rp-premium__inner">
    <header class="rp-premium__header">
      <div>
        <h2 class="rp-premium__heading">{{ section.settings.heading | default: 'You may also like' }}</h2>
      </div>
      {% if section.settings.enable_carousel %}
        <div class="rp-premium__controls">
          <button type="button" class="rp-premium__arrow" data-rp-prev aria-label="Previous related products">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 4.5L7 10l5.5 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="rp-premium__arrow" data-rp-next aria-label="Next related products">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 4.5L13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {% endif %}
    </header>

    <div
      class="rp-premium__track-wrap{% unless section.settings.enable_carousel %} rp-premium__track-wrap--grid{% endunless %}"
      data-rp-carousel
      tabindex="0"
      aria-label="Related products"
    >
      <div class="rp-premium__track">
        {{ rp_cards }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Enable carousel",
      "default": true
    },
    {
      "type": "range",
      "id": "cards_per_view_desktop",
      "label": "Cards per view (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "cards_per_view_tablet",
      "label": "Cards per view (tablet)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "section_max_width",
      "label": "Section max width",
      "min": 1100,
      "max": 1600,
      "step": 20,
      "default": 1360,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section padding top",
      "min": 40,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section padding bottom",
      "min": 40,
      "max": 120,
      "step": 4,
      "default": 84,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_new_badge",
      "label": "Show new badge",
      "default": true
    },
    {
      "type": "select",
      "id": "new_badge_rule",
      "label": "New badge rule",
      "default": "tag",
      "options": [
        { "value": "tag", "label": "Tag" },
        { "value": "days_since_publish", "label": "Days since publish" }
      ]
    },
    {
      "type": "text",
      "id": "new_badge_tag",
      "label": "New badge tag",
      "default": "new"
    },
    {
      "type": "range",
      "id": "new_badge_days",
      "label": "New badge days",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_metafield_namespace_key",
      "label": "Rating metafield (namespace.key)",
      "default": "reviews.rating"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show swatches",
      "default": true
    },
    {
      "type": "select",
      "id": "swatch_source",
      "label": "Swatch source",
      "default": "variant_option",
      "options": [
        { "value": "variant_option", "label": "Variant option" },
        { "value": "metafield", "label": "Metafield" }
      ]
    },
    {
      "type": "text",
      "id": "swatch_option_name",
      "label": "Swatch option name",
      "default": "Color"
    },
    {
      "type": "checkbox",
      "id": "show_specs_row",
      "label": "Show specs row",
      "default": true
    },
    {
      "type": "text",
      "id": "driver_size_key",
      "label": "Driver size metafield key",
      "default": "custom.driver_size"
    },
    {
      "type": "text",
      "id": "product_weight_key",
      "label": "Product weight metafield key",
      "default": "custom.product_weight"
    },
    {
      "type": "text",
      "id": "battery_life_key",
      "label": "Battery life metafield key",
      "default": "custom.battery_life"
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
