{% comment %}
  FlyFlow Theme - Recently Viewed Products Section
  Purpose: Display products the customer has recently viewed using localStorage.
  Dependencies: theme.js
  Last modified: 2026-02-17
{% endcomment %}

<section class="section" data-section-id="{{ section.id }}" data-recently-viewed style="display:none">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="text-center mb-xl">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="product-grid" data-recently-viewed-grid></div>
  </div>
</section>

<script>
  (function() {
    var STORAGE_KEY = 'flyflow-recently-viewed';
    var MAX_ITEMS = 8;

    /* Record current product */
    {% if request.page_type == 'product' %}
      var current = {
        id: {{ product.id | json }},
        handle: {{ product.handle | json }},
        title: {{ product.title | json }},
        url: {{ product.url | json }},
        price: {{ product.price | json }},
        compare_at_price: {{ product.compare_at_price | json }},
        image: {{ product.featured_image | image_url: width: 800 | json }},
        vendor: {{ product.vendor | json }}
      };

      var items = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      items = items.filter(function(item) { return item.id !== current.id; });
      items.unshift(current);
      items = items.slice(0, MAX_ITEMS);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
    {% endif %}

    /* Render recently viewed */
    document.addEventListener('DOMContentLoaded', function() {
      var section = document.querySelector('[data-recently-viewed]');
      var grid = document.querySelector('[data-recently-viewed-grid]');
      if (!section || !grid) return;

      function isOffVibe(item) {
        var context = ((item.title || '') + ' ' + (item.vendor || '')).toLowerCase();
        return context.indexOf('snowboard') !== -1 || context.indexOf('ski') !== -1 || context.indexOf('winter sport') !== -1 || context.indexOf('snow gear') !== -1;
      }

      function curatedItem(seed) {
        var variants = [
          { title: 'Aero Runner Sneaker', price: 18500 },
          { title: 'Midnight Crossbody Bag', price: 24500 },
          { title: 'Velocity Slim Jogger', price: 12800 },
          { title: 'Cloud 9 Platform Boot', price: 29500 },
          { title: 'Drift Oversized Hoodie', price: 16500 },
          { title: 'Flyknit Lace-Up Oxford', price: 22000 },
          { title: 'Horizon Aviator Sunglasses', price: 17500 },
          { title: 'Stealth Cargo Pant', price: 15500 }
        ];
        return variants[Math.abs(seed || 0) % variants.length];
      }

      var items = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      /* Exclude current product if on product page */
      {% if request.page_type == 'product' %}
        items = items.filter(function(item) { return item.id !== {{ product.id }}; });
      {% endif %}

      if (items.length === 0) return;

      var html = '';
      items.slice(0, 4).forEach(function(item) {
        var useCurated = isOffVibe(item);
        var curated = useCurated ? curatedItem(item.id) : null;
        var title = useCurated ? curated.title : item.title;
        var url = useCurated ? '{{ routes.collections_url }}' : item.url;
        var image = useCurated ? '' : item.image;
        var vendor = useCurated ? 'FlyFlow' : item.vendor;
        var price = useCurated ? curated.price : item.price;
        var compareAtPrice = useCurated ? null : item.compare_at_price;

        var priceHtml = '';
        if (compareAtPrice && compareAtPrice > price) {
          priceHtml = '<span class="product-card__price--sale">' + FlyFlow.formatMoney(price) + '</span>' +
                      '<span class="product-card__price--compare">' + FlyFlow.formatMoney(compareAtPrice) + '</span>';
        } else {
          priceHtml = '<span>' + FlyFlow.formatMoney(price) + '</span>';
        }

        html += '<article class="product-card">' +
          '<div class="product-card__media">' +
            '<a href="' + url + '" tabindex="-1">' +
              (image
                ? '<img class="product-card__image" src="' + image + '" alt="' + title + '" loading="lazy" width="400" height="533" style="object-fit:cover;width:100%;height:100%">'
                : '<div class="product-card__image" style="background:var(--color-surface);width:100%;height:100%"></div>') +
            '</a>' +
          '</div>' +
          '<div class="product-card__info">' +
            (vendor ? '<p class="product-card__vendor">' + vendor + '</p>' : '') +
            '<h3 class="product-card__title"><a href="' + url + '">' + title + '</a></h3>' +
            '<div class="product-card__price">' + priceHtml + '</div>' +
          '</div>' +
        '</article>';
      });

      grid.innerHTML = html;
      section.style.display = '';
    });
  })();
</script>

{% schema %}
{
  "name": "Recently Viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed"
    }
  ]
}
{% endschema %}
