{% comment %}
  FlyFlow Theme - Password Page Section
  Purpose: Store password page shown when store is password-protected.
  Last modified: 2026-02-17
{% endcomment %}

<section style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:var(--space-xl)">
  <div style="max-width:480px;width:100%;text-align:center">
    <h1 style="font-size:clamp(2rem,5vw,3rem);margin-bottom:var(--space-sm)"><span class="ff-wordmark">{{ shop.name }}</span></h1>
    <p class="text-secondary mb-xl">{{ section.settings.heading | default: 'We are coming soon.' }}</p>

    {% if section.settings.show_password_form %}
      {% form 'storefront_password' %}
        {% if form.errors %}
          <p class="text-sale text-sm mb-md">{{ form.errors | default_errors }}</p>
        {% endif %}
        <div class="flex flex--gap-sm" style="max-width:360px;margin-inline:auto">
          <input
            type="password"
            name="password"
            class="form__input"
            placeholder="Enter store password"
            aria-label="Store password"
            required
          >
          <button type="submit" class="btn btn--primary">Enter</button>
        </div>
      {% endform %}
    {% endif %}

    {% if section.settings.show_newsletter %}
      <div style="margin-top:var(--space-2xl);padding-top:var(--space-xl);border-top:1px solid var(--color-border)">
        <p class="text-sm" style="font-weight:600;margin-bottom:var(--space-md)">Get notified when we launch</p>
        {% form 'customer', class: 'newsletter__form', style: 'max-width:360px;margin-inline:auto' %}
          <input type="hidden" name="contact[tags]" value="prospect,password-page">
          <input type="email" name="contact[email]" class="newsletter__input" placeholder="{{ 'newsletter.placeholder' | t }}" required aria-label="Email">
          <button type="submit" class="btn btn--accent">{{ 'newsletter.submit' | t }}</button>
        {% endform %}
      </div>
    {% endif %}

    <p class="text-xs text-secondary" style="margin-top:var(--space-2xl)">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Password Page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something extraordinary is on its way."
    },
    {
      "type": "checkbox",
      "id": "show_password_form",
      "label": "Show password form",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    }
  ]
}
{% endschema %}
