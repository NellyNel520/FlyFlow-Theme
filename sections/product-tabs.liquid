{% comment %}
  FlyFlow Theme - Product Tabs Section
  Purpose: Tabbed content (desktop) / accordion (mobile) for product details,
           size guide, reviews, and shipping info.
  Dependencies: theme.js (Accordion module)
  Last modified: 2026-02-17
{% endcomment %}

<section class="product-tabs section" data-section-id="{{ section.id }}">
  <div class="container">
    {% assign has_reviews_app_block = false %}
    {% for block in section.blocks %}
      {% if block.type == '@app' %}
        {% assign has_reviews_app_block = true %}
      {% endif %}
    {% endfor %}

    {%- comment -%} Desktop tabs {%- endcomment -%}
    {% assign first_tab_assigned = false %}
    <div class="product-tabs__nav" role="tablist">
      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          {% continue %}
        {% endif %}
        {% assign tab_active = false %}
        {% if first_tab_assigned == false %}
          {% assign tab_active = true %}
          {% assign first_tab_assigned = true %}
        {% endif %}
        <button
          class="product-tabs__btn{% if tab_active %} product-tabs__btn--active{% endif %}"
          role="tab"
          aria-selected="{% if tab_active %}true{% else %}false{% endif %}"
          aria-controls="tab-panel-{{ block.id }}"
          id="tab-{{ block.id }}"
          data-tab-btn="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          {% case block.type %}
            {% when 'description' %}{{ 'products.tabs.description' | t }}
            {% when 'size-guide' %}{{ 'products.tabs.size_guide' | t }}
            {% when 'reviews' %}{{ 'products.tabs.reviews' | t }}
            {% when 'shipping' %}{{ 'products.tabs.shipping' | t }}
            {% when 'custom' %}{{ block.settings.title }}
          {% endcase %}
        </button>
      {% endfor %}
    </div>

    {%- comment -%} Tab panels (desktop) {%- endcomment -%}
    {% assign first_panel_assigned = false %}
    {% for block in section.blocks %}
      {% if block.type == '@app' %}
        {% continue %}
      {% endif %}
      {% assign panel_active = false %}
      {% if first_panel_assigned == false %}
        {% assign panel_active = true %}
        {% assign first_panel_assigned = true %}
      {% endif %}
      <div
        class="product-tabs__content{% if panel_active %} product-tabs__content--active{% endif %} hidden-mobile"
        role="tabpanel"
        id="tab-panel-{{ block.id }}"
        aria-labelledby="tab-{{ block.id }}"
        data-tab-panel="{{ block.id }}"
      >
        {% case block.type %}
          {% when 'description' %}
            <div class="product-description-card">
              <div class="rte">{{ product.description }}</div>
            </div>
          {% when 'size-guide' %}
            <p class="text-sm text-secondary mb-md">Find your perfect fit with our size guide.</p>
            <button class="btn btn--secondary btn--sm" data-modal-open="size-guide-modal">
              {{ 'products.size_guide.title' | t }}
            </button>
          {% when 'reviews' %}
            <div id="product-reviews">
              {% if has_reviews_app_block %}
                {% for app_block in section.blocks %}
                  {% if app_block.type == '@app' %}
                    <div class="product-tabs__app-block" {{ app_block.shopify_attributes }}>
                      {% render app_block %}
                    </div>
                  {% endif %}
                {% endfor %}
              {% else %}
                {% if section.settings.show_reviews_placeholder %}
                  <p class="product-tabs__reviews-placeholder">Reviews app not enabled. Add a reviews app block to display ratings and customer feedback here.</p>
                {% endif %}
              {% endif %}
            </div>
          {% when 'shipping' %}
            <div class="rte text-sm">{{ block.settings.content }}</div>
          {% when 'custom' %}
            <div class="rte text-sm">{{ block.settings.content }}</div>
        {% endcase %}
      </div>
    {% endfor %}

    {%- comment -%} Accordion (mobile) {%- endcomment -%}
    {% assign first_accordion_assigned = false %}
    {% for block in section.blocks %}
      {% if block.type == '@app' %}
        {% continue %}
      {% endif %}
      {% assign accordion_open = false %}
      {% if first_accordion_assigned == false %}
        {% assign accordion_open = true %}
        {% assign first_accordion_assigned = true %}
      {% endif %}
      <div class="accordion" {{ block.shopify_attributes }}>
        <button
          class="accordion__trigger"
          data-accordion-trigger
          aria-expanded="{% if accordion_open %}true{% else %}false{% endif %}"
          aria-controls="accordion-{{ block.id }}"
        >
          {% case block.type %}
            {% when 'description' %}{{ 'products.tabs.description' | t }}
            {% when 'size-guide' %}{{ 'products.tabs.size_guide' | t }}
            {% when 'reviews' %}{{ 'products.tabs.reviews' | t }}
            {% when 'shipping' %}{{ 'products.tabs.shipping' | t }}
            {% when 'custom' %}{{ block.settings.title }}
          {% endcase %}
          <svg class="accordion__icon" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" fill="none" stroke="currentColor" stroke-width="2"/>
          </svg>
        </button>
        <div class="accordion__content{% if accordion_open %} accordion__content--open{% endif %}" id="accordion-{{ block.id }}">
          <div class="accordion__body text-sm">
            {% case block.type %}
              {% when 'description' %}
                <div class="product-description-card">
                  <div class="rte">{{ product.description }}</div>
                </div>
              {% when 'size-guide' %}
                <button class="btn btn--secondary btn--sm" data-modal-open="size-guide-modal">
                  {{ 'products.size_guide.title' | t }}
                </button>
              {% when 'reviews' %}
                {% if has_reviews_app_block %}
                  {% for app_block in section.blocks %}
                    {% if app_block.type == '@app' %}
                      <div class="product-tabs__app-block" {{ app_block.shopify_attributes }}>
                        {% render app_block %}
                      </div>
                    {% endif %}
                  {% endfor %}
                {% else %}
                  {% if section.settings.show_reviews_placeholder %}
                    <p class="product-tabs__reviews-placeholder">Reviews app not enabled. Add a reviews app block to display ratings and customer feedback here.</p>
                  {% endif %}
                {% endif %}
              {% when 'shipping' %}
                <div class="rte">{{ block.settings.content }}</div>
              {% when 'custom' %}
                <div class="rte">{{ block.settings.content }}</div>
            {% endcase %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<script>
  /* Tab switching logic */
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-tab-btn]');
    if (!btn) return;
    var id = btn.dataset.tabBtn;
    var section = btn.closest('.product-tabs');
    section.querySelectorAll('[data-tab-btn]').forEach(function(b) {
      b.classList.remove('product-tabs__btn--active');
      b.setAttribute('aria-selected', 'false');
    });
    section.querySelectorAll('[data-tab-panel]').forEach(function(p) {
      p.classList.remove('product-tabs__content--active');
    });
    btn.classList.add('product-tabs__btn--active');
    btn.setAttribute('aria-selected', 'true');
    var panel = section.querySelector('[data-tab-panel="' + id + '"]');
    if (panel) panel.classList.add('product-tabs__content--active');
  });
</script>

{% schema %}
{
  "name": "Product Tabs",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_reviews_placeholder",
      "label": "Show compact reviews placeholder when no app is installed",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "size-guide",
      "name": "Size Guide",
      "limit": 1
    },
    {
      "type": "reviews",
      "name": "Reviews",
      "limit": 1
    },
    {
      "type": "shipping",
      "name": "Shipping & Returns",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Free standard shipping on orders over $75. Express shipping available at checkout.</p><p>Returns accepted within 30 days of purchase. Items must be unworn with tags attached.</p>"
        }
      ]
    },
    {
      "type": "custom",
      "name": "Custom Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab title",
          "default": "Custom Tab"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
