{% comment %}
  FlyFlow Theme - Main Collection Section
  Purpose: Collection product grid with toolbar, filtering sidebar,
           mobile filter drawer, sorting, and pagination.
  Dependencies: theme.js (Filters module), snippets/product-card.liquid
  Last modified: 2026-02-17
{% endcomment %}

<section class="section" data-section-id="{{ section.id }}">
  <div class="container">
    {%- comment -%} Toolbar: filter button (mobile), sort, view toggle {%- endcomment -%}
    <div class="collection-toolbar">
      <div class="flex flex--gap-md" style="align-items:center">
        <button class="btn btn--secondary btn--sm hidden-desktop" data-filter-open>
          <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true" style="margin-right:4px">
            <line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/>
            <line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/>
            <line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/>
            <line x1="17" y1="16" x2="23" y2="16"/>
          </svg>
          {{ 'collections.filter' | t }}
        </button>
        <span class="collection-toolbar__count">
          {{ 'collections.results_count' | t: count: collection.products_count }}
        </span>
      </div>

      <div class="collection-toolbar__actions">
        {%- comment -%} Sort {%- endcomment -%}
        <div>
          <label for="sort-select" class="sr-only">{{ 'collections.sort' | t }}</label>
          <select id="sort-select" class="sort-select" onchange="window.location.href=this.value">
            {% for option in collection.sort_options %}
              <option
                value="{{ collection.url }}?sort_by={{ option.value }}"
                {% if collection.sort_by == option.value %}selected{% endif %}
              >
                {{ option.name }}
              </option>
            {% endfor %}
          </select>
        </div>

        {%- comment -%} Grid/List toggle {%- endcomment -%}
        {% if settings.collection_grid_toggle %}
          <div class="view-toggle" role="group" aria-label="View mode">
            <button class="view-toggle__btn view-toggle__btn--active" data-view="grid" aria-label="{{ 'collections.grid_view' | t }}">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
              </svg>
            </button>
            <button class="view-toggle__btn" data-view="list" aria-label="{{ 'collections.list_view' | t }}">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <rect x="3" y="4" width="18" height="3"/><rect x="3" y="10.5" width="18" height="3"/>
                <rect x="3" y="17" width="18" height="3"/>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>
    </div>

    {%- comment -%} Active filters {%- endcomment -%}
    {% if collection.filters.size > 0 %}
      {% assign has_active_filter = false %}
      {% for filter in collection.filters %}
        {% if filter.active_values.size > 0 %}{% assign has_active_filter = true %}{% endif %}
      {% endfor %}

      {% if has_active_filter %}
        <div class="active-filters">
          {% for filter in collection.filters %}
            {% for value in filter.active_values %}
              <span class="active-filters__tag">
                {{ value.label }}
                <a href="{{ value.url_to_remove }}" class="active-filters__remove" aria-label="Remove {{ value.label }} filter">
                  <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                </a>
              </span>
            {% endfor %}
          {% endfor %}
          <a href="{{ collection.url }}" class="active-filters__clear">{{ 'collections.clear_all' | t }}</a>
        </div>
      {% endif %}
    {% endif %}

    <div class="collection-layout">
      {%- comment -%} Filter sidebar (desktop) {%- endcomment -%}
      {% if collection.filters.size > 0 %}
        <aside class="filter-sidebar" aria-label="{{ 'collections.filter' | t }}">
          {% for filter in collection.filters %}
            <div class="filter-group">
              <button
                class="filter-group__title"
                data-filter-toggle
                aria-expanded="true"
              >
                {{ filter.label }}
                <svg class="accordion__icon" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9" fill="none" stroke="currentColor" stroke-width="2"/>
                </svg>
              </button>
              <div class="accordion__content accordion__content--open">
                <div class="accordion__body">
                  {% case filter.type %}
                    {% when 'list' %}
                      {% if filter.label == 'Color' %}
                        <div class="filter-swatches">
                          {% for value in filter.values %}
                            <a
                              href="{{ value.url }}"
                              class="filter-swatch{% if value.active %} filter-swatch--active{% endif %}"
                              style="background-color: {{ value.label | handleize }}"
                              title="{{ value.label }} ({{ value.count }})"
                              aria-label="{{ value.label }}, {{ value.count }} products"
                            >
                              {% if value.count > 0 %}
                                <span class="filter-swatch__count">{{ value.count }}</span>
                              {% endif %}
                            </a>
                          {% endfor %}
                        </div>
                      {% else %}
                        {% for value in filter.values %}
                          <label style="display:flex;align-items:center;gap:var(--space-sm);padding:var(--space-xs) 0;font-size:0.875rem;cursor:pointer;min-height:36px">
                            <input
                              type="checkbox"
                              {% if value.active %}checked{% endif %}
                              onchange="window.location.href='{{ value.url }}'"
                              style="width:18px;height:18px;accent-color:var(--color-accent)"
                            >
                            {{ value.label }}
                            <span class="text-secondary text-xs">({{ value.count }})</span>
                          </label>
                        {% endfor %}
                      {% endif %}
                    {% when 'price_range' %}
                      <div class="price-range">
                        <div class="price-range__values">
                          <span>{{ filter.min_value.value | default: 0 | money }}</span>
                          <span>{{ filter.range_max | money }}</span>
                        </div>
                        <form>
                          <div class="flex flex--gap-sm mt-sm">
                            <input
                              type="number"
                              name="{{ filter.min_value.param_name }}"
                              class="form__input"
                              placeholder="Min"
                              value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"
                              min="0"
                              max="{{ filter.range_max | money_without_currency | remove: ',' }}"
                              style="font-size:0.8125rem"
                            >
                            <span style="align-self:center">&ndash;</span>
                            <input
                              type="number"
                              name="{{ filter.max_value.param_name }}"
                              class="form__input"
                              placeholder="Max"
                              value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"
                              min="0"
                              max="{{ filter.range_max | money_without_currency | remove: ',' }}"
                              style="font-size:0.8125rem"
                            >
                          </div>
                        </form>
                      </div>
                  {% endcase %}
                </div>
              </div>
            </div>
          {% endfor %}
        </aside>
      {% endif %}

      {%- comment -%} Product grid {%- endcomment -%}
      <div>
        {% if collection.products.size > 0 %}
          <div class="product-grid" id="product-grid">
            {% paginate collection.products by section.settings.products_per_page %}
              {% for product in collection.products %}
                {% render 'product-card', product: product %}
              {% endfor %}
            {% endpaginate %}
          </div>

          {%- comment -%} Pagination {%- endcomment -%}
          {% paginate collection.products by section.settings.products_per_page %}
            {% if paginate.pages > 1 %}
              {% if settings.collection_pagination == 'load_more' %}
                <div class="load-more">
                  {% if paginate.next %}
                    <a href="{{ paginate.next.url }}" class="btn btn--secondary">
                      {{ 'collections.load_more' | t }}
                    </a>
                  {% endif %}
                </div>
              {% else %}
                <nav class="pagination" aria-label="Pagination">
                  {% if paginate.previous %}
                    <a href="{{ paginate.previous.url }}" class="pagination__link" aria-label="{{ 'general.pagination.previous' | t }}">
                      &larr;
                    </a>
                  {% endif %}

                  {% for part in paginate.parts %}
                    {% if part.is_link %}
                      <a href="{{ part.url }}" class="pagination__link" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                        {{ part.title }}
                      </a>
                    {% else %}
                      {% if part.title == paginate.current_page %}
                        <span class="pagination__link pagination__link--active" aria-current="page">
                          {{ part.title }}
                        </span>
                      {% else %}
                        <span class="pagination__link">{{ part.title }}</span>
                      {% endif %}
                    {% endif %}
                  {% endfor %}

                  {% if paginate.next %}
                    <a href="{{ paginate.next.url }}" class="pagination__link" aria-label="{{ 'general.pagination.next' | t }}">
                      &rarr;
                    </a>
                  {% endif %}
                </nav>
              {% endif %}
            {% endif %}
          {% endpaginate %}
        {% else %}
          <div class="text-center" style="padding:var(--space-3xl) 0">
            <p class="text-secondary">{{ 'collections.no_products' | t }}</p>
            <a href="/collections/all" class="btn btn--secondary mt-md">{{ 'cart.continue_shopping' | t }}</a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {%- comment -%} Mobile filter drawer {%- endcomment -%}
  {% if collection.filters.size > 0 %}
    <div class="filter-drawer" data-filter-drawer aria-label="{{ 'collections.filter' | t }}" role="dialog" aria-modal="true">
      <div class="filter-drawer__header">
        <h3 style="font-size:1rem;font-weight:700">{{ 'collections.filter' | t }}</h3>
        <button class="header__icon-btn" data-filter-close aria-label="{{ 'general.close' | t }}">
          <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="1.5" fill="none" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <div class="filter-drawer__body">
        {% for filter in collection.filters %}
          <div class="filter-group">
            <button class="filter-group__title" data-filter-toggle aria-expanded="true">
              {{ filter.label }}
              <svg class="accordion__icon" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                <polyline points="6 9 12 15 18 9" fill="none" stroke="currentColor" stroke-width="2"/>
              </svg>
            </button>
            <div class="accordion__content accordion__content--open">
              <div class="accordion__body">
                {% for value in filter.values %}
                  <label style="display:flex;align-items:center;gap:var(--space-sm);padding:var(--space-sm) 0;font-size:0.875rem;cursor:pointer;min-height:44px">
                    <input
                      type="checkbox"
                      {% if value.active %}checked{% endif %}
                      onchange="window.location.href='{{ value.url }}'"
                      style="width:20px;height:20px;accent-color:var(--color-accent)"
                    >
                    {{ value.label }}
                    <span class="text-secondary text-xs">({{ value.count }})</span>
                  </label>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="filter-drawer__footer">
        <a href="{{ collection.url }}" class="btn btn--secondary">{{ 'collections.clear_all' | t }}</a>
        <button class="btn btn--primary" data-filter-close>{{ 'collections.apply_filters' | t }}</button>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Collection Products",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12
    }
  ]
}
{% endschema %}
