{% comment %}
  FlyFlow Theme - Main Product Section
  Purpose: Block-based OS 2.0 product template with gallery, variant selectors,
           inventory messaging, app blocks, and dynamic checkout support.
  Dependencies: theme.js (VariantSelector, ProductGallery, StickyATC, Cart modules)
  Last modified: 2026-02-18
{% endcomment %}

<section class="section" data-section-id="{{ section.id }}" style="--pdp-sticky-top: {{ section.settings.sticky_top_offset | default: 80 }}px;">
  <div class="container">
    <nav class="breadcrumbs mb-lg" aria-label="Breadcrumb" style="font-size:0.8125rem;color:var(--color-text-secondary)">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      {% if product.collections.size > 0 %}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        <span aria-hidden="true">/</span>
      {% endif %}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product">
      {% render 'product-gallery', product: product, parent_section_id: section.id %}

      <div class="product-info">
        {% assign has_product_app_block = false %}
        {% for section_block in section.blocks %}
          {% if section_block.type == '@app' %}
            {% assign has_product_app_block = true %}
          {% endif %}
        {% endfor %}

        {% form 'product', product, data-product-form: '' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% assign purchase_panel_types = 'variant_picker,quantity_selector,buy_buttons' | split: ',' %}
          {% assign purchase_panel_open = false %}

          {% for block in section.blocks %}
            {% assign is_purchase_block = false %}
            {% if purchase_panel_types contains block.type %}
              {% assign is_purchase_block = true %}
            {% endif %}

            {% assign next_index = forloop.index0 | plus: 1 %}
            {% assign next_block_type = '' %}
            {% if next_index < section.blocks.size %}
              {% assign next_block_type = section.blocks[next_index].type %}
            {% endif %}
            {% assign next_is_purchase_block = false %}
            {% if purchase_panel_types contains next_block_type %}
              {% assign next_is_purchase_block = true %}
            {% endif %}

            {% if is_purchase_block and purchase_panel_open == false %}
              <div class="product-purchase-panel">
              {% assign purchase_panel_open = true %}
            {% endif %}

            <div {% if block.type != '@app' %}class="product-block product-block--{{ block.type | replace: '_', '-' }}"{% endif %} {{ block.shopify_attributes }}>
              {% case block.type %}
                {% when 'vendor' %}
                  {% if product.vendor != blank %}
                    <p class="product-info__vendor">{{ product.vendor }}</p>
                  {% endif %}

                {% when 'title' %}
                  <h1 class="product-info__title">{{ product.title }}</h1>

                {% when 'price' %}
                  <div class="product-info__price{% if product.compare_at_price > product.price %} product-info__price--sale{% endif %}">
                    <span class="product-info__price-current" data-product-price>
                      {{ product.selected_or_first_available_variant.price | money }}
                    </span>
                    <span
                      class="product-info__price-compare"
                      data-product-compare-price
                      {% unless product.compare_at_price > product.price %}style="display:none"{% endunless %}
                    >
                      {{ product.compare_at_price | money }}
                    </span>
                  </div>

                {% when 'rating' %}
                  {% assign rating_source = settings.rating_source | default: 'auto' %}
                  {% assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value %}
                  {% assign rating_count = product.metafields.reviews.rating_count | default: product.metafields.spr.reviews %}
                  {% assign show_metafield_rating = false %}

                  {% if settings.show_star_rating %}
                    {% if rating_source == 'metafield_only' %}
                      {% if rating_value != blank %}{% assign show_metafield_rating = true %}{% endif %}
                    {% elsif rating_source == 'app_only' %}
                      {% assign show_metafield_rating = false %}
                    {% else %}
                      {% if has_product_app_block %}
                        {% assign show_metafield_rating = false %}
                      {% elsif rating_value != blank %}
                        {% assign show_metafield_rating = true %}
                      {% endif %}
                    {% endif %}
                  {% endif %}

                  {% if show_metafield_rating %}
                    {% assign rating_value_number = rating_value | plus: 0 %}
                    {% assign rating_percentage = rating_value_number | times: 100.0 | divided_by: 5 %}
                    {% assign rating_clip_id = 'rating-clip-' | append: section.id | append: '-' | append: block.id %}
                    <div class="product-info__rating" aria-label="Rated {{ rating_value_number }} out of 5">
                      <svg class="product-info__rating-svg" viewBox="0 0 120 24" aria-hidden="true" role="img">
                        <defs>
                          <clipPath id="{{ rating_clip_id }}">
                            <rect x="0" y="0" width="{{ rating_percentage }}%" height="100%"></rect>
                          </clipPath>
                        </defs>
                        <g class="product-info__rating-stars-base">
                          <path d="M12 2.5l2.8 5.6 6.2.9-4.5 4.3 1.1 6.1L12 16.6 6.4 19.4l1.1-6.1L3 9l6.2-.9L12 2.5z"></path>
                          <path transform="translate(24 0)" d="M12 2.5l2.8 5.6 6.2.9-4.5 4.3 1.1 6.1L12 16.6 6.4 19.4l1.1-6.1L3 9l6.2-.9L12 2.5z"></path>
                          <path transform="translate(48 0)" d="M12 2.5l2.8 5.6 6.2.9-4.5 4.3 1.1 6.1L12 16.6 6.4 19.4l1.1-6.1L3 9l6.2-.9L12 2.5z"></path>
                          <path transform="translate(72 0)" d="M12 2.5l2.8 5.6 6.2.9-4.5 4.3 1.1 6.1L12 16.6 6.4 19.4l1.1-6.1L3 9l6.2-.9L12 2.5z"></path>
                          <path transform="translate(96 0)" d="M12 2.5l2.8 5.6 6.2.9-4.5 4.3 1.1 6.1L12 16.6 6.4 19.4l1.1-6.1L3 9l6.2-.9L12 2.5z"></path>
                        </g>
                        <g class="product-info__rating-stars-fill" clip-path="url(#{{ rating_clip_id }})">
                          <path d="M12 2.5l2.8 5.6 6.2.9-4.5 4.3 1.1 6.1L12 16.6 6.4 19.4l1.1-6.1L3 9l6.2-.9L12 2.5z"></path>
                          <path transform="translate(24 0)" d="M12 2.5l2.8 5.6 6.2.9-4.5 4.3 1.1 6.1L12 16.6 6.4 19.4l1.1-6.1L3 9l6.2-.9L12 2.5z"></path>
                          <path transform="translate(48 0)" d="M12 2.5l2.8 5.6 6.2.9-4.5 4.3 1.1 6.1L12 16.6 6.4 19.4l1.1-6.1L3 9l6.2-.9L12 2.5z"></path>
                          <path transform="translate(72 0)" d="M12 2.5l2.8 5.6 6.2.9-4.5 4.3 1.1 6.1L12 16.6 6.4 19.4l1.1-6.1L3 9l6.2-.9L12 2.5z"></path>
                          <path transform="translate(96 0)" d="M12 2.5l2.8 5.6 6.2.9-4.5 4.3 1.1 6.1L12 16.6 6.4 19.4l1.1-6.1L3 9l6.2-.9L12 2.5z"></path>
                        </g>
                      </svg>
                      <span class="sr-only">Rated {{ rating_value_number }} out of 5</span>
                      <span class="product-info__rating-text">
                        {{ rating_value_number }}/5{% if settings.show_rating_count and rating_count != blank %} ({{ rating_count }}){% endif %}
                      </span>
                    </div>
                  {% endif %}

                {% when 'inventory' %}
                  {% assign current_variant = product.selected_or_first_available_variant %}
                  <div
                    class="stock-indicator{% if current_variant.available == false %} stock-indicator--out-of-stock{% elsif current_variant.inventory_management and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= settings.product_stock_threshold %} stock-indicator--low-stock{% else %} stock-indicator--in-stock{% endif %}"
                    data-stock-indicator
                    data-threshold="{{ settings.product_stock_threshold }}"
                  >
                    <span class="stock-indicator__dot"></span>
                    {% if current_variant.available == false %}
                      {{ 'products.stock.out_of_stock' | t }}
                    {% elsif current_variant.inventory_management and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= settings.product_stock_threshold %}
                      {{ 'products.stock.low_stock' | t: count: current_variant.inventory_quantity }}
                    {% else %}
                      {{ 'products.stock.in_stock' | t }}
                    {% endif %}
                  </div>

                {% when 'variant_picker' %}
                  {% for option in product.options_with_values %}
                    <div class="variant-selector" data-option-group>
                      <div class="variant-selector__label">
                        <span>{{ option.name }}:</span>
                        <span class="variant-selector__selected" data-option-selected>
                          {{ option.selected_value }}
                        </span>
                      </div>

                      <div class="variant-selector__options">
                        {% for value in option.values %}
                          {% assign found_available = false %}
                          {% for variant in product.variants %}
                            {% if variant.available %}
                              {% case option.position %}
                                {% when 1 %}
                                  {% if variant.option1 == value %}{% assign found_available = true %}{% endif %}
                                {% when 2 %}
                                  {% if variant.option2 == value %}{% assign found_available = true %}{% endif %}
                                {% when 3 %}
                                  {% if variant.option3 == value %}{% assign found_available = true %}{% endif %}
                              {% endcase %}
                            {% endif %}
                          {% endfor %}

                          {% assign option_name_downcase = option.name | downcase %}
                          {% if option_name_downcase contains 'color' or option_name_downcase contains 'colour' %}
                            {% capture swatch_color %}{% render 'swatch-color', value: value %}{% endcapture %}
                            <button
                              type="button"
                              class="swatch{% if option.selected_value == value %} swatch--active{% endif %}{% unless found_available %} swatch--sold-out{% endunless %}"
                              style="--swatch-color: {{ swatch_color | strip }}; background-color: {{ swatch_color | strip }};"
                              data-swatch-name="{{ value | escape }}"
                              data-option-value="{{ value }}"
                              data-option-name="{{ option.name }}"
                              title="{{ value }}{% unless found_available %} - {{ 'products.sold_out' | t }}{% endunless %}"
                              aria-label="{{ value }}{% unless found_available %} - {{ 'products.sold_out' | t }}{% endunless %}"
                              {% unless found_available %}aria-disabled="true"{% endunless %}
                            ></button>
                          {% else %}
                            <button
                              type="button"
                              class="size-btn{% if option.selected_value == value %} size-btn--active{% endif %}{% unless found_available %} size-btn--sold-out{% endunless %}"
                              data-option-value="{{ value }}"
                              data-option-name="{{ option.name }}"
                              aria-label="{{ value }}{% unless found_available %} - {{ 'products.sold_out' | t }}{% endunless %}"
                              {% unless found_available %}aria-disabled="true"{% endunless %}
                            >
                              {{ value }}
                            </button>
                          {% endif %}
                        {% endfor %}
                      </div>

                      {% if option.name == 'Size' and block.settings.show_size_guide %}
                        <button
                          class="text-accent text-sm mt-sm"
                          data-modal-open="size-guide-modal"
                          type="button"
                          style="background:none;border:none;cursor:pointer;text-decoration:underline;text-underline-offset:2px"
                        >
                          {{ 'products.tabs.size_guide' | t }}
                        </button>
                      {% endif %}
                    </div>
                  {% endfor %}

                {% when 'quantity_selector' %}
                  <div class="quantity-selector">
                    <button type="button" class="quantity-selector__btn" data-qty-minus aria-label="{{ 'products.decrease_quantity' | t }}">
                      &minus;
                    </button>
                    <input
                      type="number"
                      class="quantity-selector__input"
                      name="quantity"
                      value="1"
                      min="1"
                      aria-label="{{ 'products.quantity' | t }}"
                    >
                    <button type="button" class="quantity-selector__btn" data-qty-plus aria-label="{{ 'products.increase_quantity' | t }}">
                      &plus;
                    </button>
                  </div>

                {% when 'buy_buttons' %}
                  <div class="product-info__add-to-cart" data-add-to-cart-section>
                    <button
                      type="submit"
                      name="add"
                      class="btn btn--primary btn--lg"
                      data-add-to-cart
                      data-add-text="{{ 'products.add_to_cart' | t }}"
                      data-sold-out-text="{{ 'products.sold_out' | t }}"
                      {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                    >
                      {% if product.selected_or_first_available_variant.available %}
                        {{ 'products.add_to_cart' | t }}
                      {% else %}
                        {{ 'products.sold_out' | t }}
                      {% endif %}
                    </button>

                    {% if block.settings.show_dynamic_checkout %}
                      <div class="product-info__dynamic-checkout">
                        {{ form | payment_button }}
                      </div>
                    {% endif %}
                  </div>

                {% when 'product_share' %}
                  {% if settings.show_product_share %}
                    {% render 'product-share', product: product, current_variant: product.selected_or_first_available_variant, section_id: section.id, block_id: block.id %}
                  {% endif %}

                {% when 'description' %}
                  {% if product.description != blank %}
                    <div class="product-info__description text-sm" style="color:var(--color-text-secondary);line-height:1.7">
                      {{ product.description }}
                    </div>
                  {% endif %}

                {% when 'back_in_stock' %}
                  {% unless product.available %}
                    <div class="back-in-stock" style="padding:var(--space-md);background:var(--color-surface);border-radius:var(--border-radius)">
                      <p class="text-sm" style="font-weight:600;margin-bottom:var(--space-sm)">
                        {{ 'products.stock.back_in_stock_title' | t }}
                      </p>
                      <div class="flex flex--gap-sm">
                        <input
                          type="email"
                          class="form__input"
                          placeholder="your@email.com"
                          required
                          aria-label="Email for back-in-stock notification"
                        >
                        <button type="button" class="btn btn--secondary btn--sm">
                          {{ 'products.stock.back_in_stock_button' | t }}
                        </button>
                      </div>
                    </div>
                  {% endunless %}

                {% when '@app' %}
                  {% render block %}
              {% endcase %}
            </div>

            {% if is_purchase_block and next_is_purchase_block == false and purchase_panel_open %}
              </div>
              {% assign purchase_panel_open = false %}
            {% endif %}
          {% endfor %}

          {% if purchase_panel_open %}
            </div>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>

  {% render 'size-guide-modal' %}

  {% if settings.product_sticky_atc %}
    <div class="sticky-atc" data-sticky-atc>
      <div class="sticky-atc__inner container">
        <div class="sticky-atc__info">
          <span class="sticky-atc__title">{{ product.title }}</span>
          <span class="sticky-atc__price" data-product-price>
            {{ product.selected_or_first_available_variant.price | money }}
          </span>
        </div>
        <button
          class="btn btn--primary"
          data-add-to-cart
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          data-add-text="{{ 'products.add_to_cart' | t }}"
          data-sold-out-text="{{ 'products.sold_out' | t }}"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
          {% if product.selected_or_first_available_variant.available %}
            {{ 'products.add_to_cart' | t }}
          {% else %}
            {{ 'products.sold_out' | t }}
          {% endif %}
        </button>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Main Product",
  "settings": [
    {
      "type": "range",
      "id": "sticky_top_offset",
      "label": "Sticky info top offset",
      "min": 56,
      "max": 140,
      "step": 4,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1
    },
    {
      "type": "inventory",
      "name": "Inventory status",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_size_guide",
          "label": "Show size guide link",
          "default": true
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Quantity selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "default": true
        }
      ]
    },
    {
      "type": "product_share",
      "name": "Product share",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "back_in_stock",
      "name": "Back in stock",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Main Product",
      "blocks": [
        { "type": "vendor" },
        { "type": "title" },
        { "type": "price" },
        { "type": "rating" },
        { "type": "inventory" },
        { "type": "variant_picker" },
        { "type": "quantity_selector" },
        { "type": "buy_buttons" },
        { "type": "product_share" },
        { "type": "description" }
      ]
    }
  ]
}
{% endschema %}
