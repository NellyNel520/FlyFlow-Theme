{% liquid
  assign rail_limit = section.settings.rail_item_limit | default: 8
  assign rail_source = section.settings.rail_source | default: 'products'
%}

<section
  class="premium-carousel premium-carousel--{{ section.id }} chapter-section chapter-section--spacing-{{ section.settings.section_density | default: section.settings.section_spacing | default: 'standard' }} chapter-section--container-{{ section.settings.container_width | default: 'contained' }}{% if section.settings.show_divider_top %} chapter-section--divider-top{% endif %}{% if section.settings.enable_reveal %} chapter-section--reveal{% endif %}"
  data-section-id="{{ section.id }}"
  data-enable-reveal="{{ section.settings.enable_reveal }}"
>
  <div class="container">
    <div class="premium-carousel__shell" data-brand-carousel-root>
      <div class="premium-carousel__header">
        {% if section.settings.show_drop_label %}
          <span class="premium-carousel__drop-label">{{ section.settings.drop_label | default: 'DROP' }}</span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="premium-carousel__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.show_controls %}
          <div class="premium-carousel__controls">
            <button class="premium-carousel__btn" type="button" data-pc-prev aria-label="Previous rail items">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="premium-carousel__btn" type="button" data-pc-next aria-label="Next rail items">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        {% endif %}
      </div>

      <div class="premium-carousel__viewport{% if section.settings.peek_next %} is-peek{% endif %}" data-pc-viewport tabindex="0" aria-label="Premium brand rail">
        <div class="premium-carousel__track" data-pc-track>
          {% assign rendered_items = 0 %}

          {% if rail_source == 'products' or rail_source == 'mixed' %}
            {% for product in section.settings.rail_products limit: rail_limit %}
              {% if rendered_items >= rail_limit %}{% break %}{% endif %}
              <article class="premium-carousel__card{% if section.settings.card_style == 'soft-mask' %} premium-carousel__card--soft{% endif %}" data-pc-card>
                <a href="{{ product.url }}" class="premium-carousel__link">
                  <div class="premium-carousel__media">
                    {% if product.featured_image %}
                      {{ product.featured_image | image_url: width: 1200 | image_tag: class: 'premium-carousel__image', loading: 'lazy', widths: '280,420,560,720,900,1200', sizes: '(min-width: 990px) 28vw, 78vw', alt: product.title }}
                    {% endif %}
                  </div>
                  <div class="premium-carousel__meta">
                    <p class="premium-carousel__kicker">Product</p>
                    <h3 class="premium-carousel__title">{{ product.title }}</h3>
                    <p class="premium-carousel__price">{{ product.price | money }}</p>
                  </div>
                </a>
              </article>
              {% assign rendered_items = rendered_items | plus: 1 %}
            {% endfor %}
          {% endif %}

          {% if rail_source == 'collections' or rail_source == 'mixed' %}
            {% for collection in section.settings.rail_collections limit: rail_limit %}
              {% if rendered_items >= rail_limit %}{% break %}{% endif %}
              <article class="premium-carousel__card{% if section.settings.card_style == 'soft-mask' %} premium-carousel__card--soft{% endif %}" data-pc-card>
                <a href="{{ collection.url }}" class="premium-carousel__link">
                  <div class="premium-carousel__media">
                    {% if collection.image %}
                      {{ collection.image | image_url: width: 1200 | image_tag: class: 'premium-carousel__image', loading: 'lazy', widths: '280,420,560,720,900,1200', sizes: '(min-width: 990px) 28vw, 78vw', alt: collection.title }}
                    {% elsif collection.products.first.featured_image %}
                      {{ collection.products.first.featured_image | image_url: width: 1200 | image_tag: class: 'premium-carousel__image', loading: 'lazy', widths: '280,420,560,720,900,1200', sizes: '(min-width: 990px) 28vw, 78vw', alt: collection.title }}
                    {% endif %}
                  </div>
                  <div class="premium-carousel__meta">
                    <p class="premium-carousel__kicker">Collection</p>
                    <h3 class="premium-carousel__title">{{ collection.title }}</h3>
                    <p class="premium-carousel__price">{{ collection.products_count }} items</p>
                  </div>
                </a>
              </article>
              {% assign rendered_items = rendered_items | plus: 1 %}
            {% endfor %}
          {% endif %}
        </div>
      </div>

      {% if section.settings.show_progress == 'bar' %}
        <div class="premium-carousel__progress" aria-hidden="true">
          <span class="premium-carousel__progress-fill" data-pc-progress></span>
        </div>
      {% endif %}

      {% if section.settings.show_hairline_divider %}
        <div class="premium-carousel__divider" aria-hidden="true"></div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .premium-carousel--{{ section.id }} .premium-carousel__shell {
    padding: clamp(12px, 1.8vw, 20px) 0;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__drop-label {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.14);
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(3px);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__heading {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.9rem);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__controls {
    display: inline-flex;
    gap: 8px;
    margin-left: auto;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__btn {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.14);
    background: #ffffff;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__btn svg {
    width: 16px;
    height: 16px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__btn:hover {
    transform: translateY(-1px);
    border-color: rgba(0, 0, 0, 0.24);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__viewport {
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    min-width: 0;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__viewport::-webkit-scrollbar {
    display: none;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, 30%);
    gap: 18px;
    padding-right: 18px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__viewport.is-peek .premium-carousel__track {
    grid-auto-columns: minmax(220px, 30%);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__viewport:not(.is-peek) .premium-carousel__track {
    grid-auto-columns: minmax(220px, 33.333%);
    padding-right: 0;
  }

  @media (max-width: 1023px) {
    .premium-carousel--{{ section.id }} .premium-carousel__track {
      grid-auto-columns: minmax(220px, 46%);
    }
  }

  @media (max-width: 767px) {
    .premium-carousel--{{ section.id }} .premium-carousel__track {
      grid-auto-columns: minmax(210px, 84%);
      gap: 12px;
    }

    .premium-carousel--{{ section.id }} .premium-carousel__btn {
      width: 34px;
      height: 34px;
    }
  }

  .premium-carousel--{{ section.id }} .premium-carousel__card {
    scroll-snap-align: start;
    border-radius: 16px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: #ffffff;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__card--soft {
    border-radius: 20px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__link:hover .premium-carousel__image {
    transform: scale(1.04);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__meta {
    padding: 12px 12px 14px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__kicker {
    margin: 0 0 4px;
    font-size: 0.62rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__title {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__price {
    margin: 6px 0 0;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__progress {
    margin-top: 10px;
    height: 2px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.12);
    overflow: hidden;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__progress-fill {
    display: block;
    width: 0;
    height: 100%;
    background: #111111;
    transition: width var(--transition-fast);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__divider {
    margin-top: 16px;
    height: 1px;
    background: rgba(0, 0, 0, 0.08);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__btn:focus-visible,
  .premium-carousel--{{ section.id }} .premium-carousel__viewport:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .premium-carousel--{{ section.id }} [data-pc-card] {
    opacity: 1;
    transform: none;
  }

  .premium-carousel--{{ section.id }}.is-pending-reveal [data-pc-card] {
    opacity: 0;
    transform: translateY(12px);
  }

  .premium-carousel--{{ section.id }}.is-revealed [data-pc-card] {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-carousel--{{ section.id }} .premium-carousel__btn,
    .premium-carousel--{{ section.id }} .premium-carousel__image,
    .premium-carousel--{{ section.id }} .premium-carousel__progress-fill,
    .premium-carousel--{{ section.id }} [data-pc-card] {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  (function() {
    var section = document.querySelector('.premium-carousel--{{ section.id }}');
    if (!section) return;

    var viewport = section.querySelector('[data-pc-viewport]');
    var prev = section.querySelector('[data-pc-prev]');
    var next = section.querySelector('[data-pc-next]');
    var progress = section.querySelector('[data-pc-progress]');
    var cards = section.querySelectorAll('[data-pc-card]');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function clamp(n, min, max) {
      return Math.min(Math.max(n, min), max);
    }

    function updateProgress() {
      if (!viewport || !progress) return;
      var maxScroll = viewport.scrollWidth - viewport.clientWidth;
      var ratio = maxScroll > 0 ? viewport.scrollLeft / maxScroll : 0;
      progress.style.width = (clamp(ratio, 0, 1) * 100) + '%';
    }

    function scrollByPage(direction) {
      if (!viewport) return;
      var amount = viewport.clientWidth * ({% if section.settings.peek_next %}0.86{% else %}1{% endif %});
      viewport.scrollBy({ left: amount * direction, behavior: reduceMotion ? 'auto' : 'smooth' });
    }

    if (prev) {
      prev.addEventListener('click', function() { scrollByPage(-1); });
    }

    if (next) {
      next.addEventListener('click', function() { scrollByPage(1); });
    }

    if (viewport) {
      viewport.addEventListener('scroll', updateProgress, { passive: true });
      viewport.addEventListener('keydown', function(event) {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          scrollByPage(1);
        }
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          scrollByPage(-1);
        }
      });
      updateProgress();
    }

    if (section.dataset.enableReveal === 'true' && !reduceMotion) {
      section.classList.add('is-pending-reveal');
      cards.forEach(function(card, index) {
        card.style.transitionDelay = (120 + (index * 70)) + 'ms';
      });

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            section.classList.add('is-revealed');
            observer.disconnect();
          }
        });
      }, { threshold: 0.22 });

      observer.observe(section);
    }
  })();
</script>

{% schema %}
{
  "name": "Premium Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brand Carousel"
    },
    {
      "type": "select",
      "id": "rail_source",
      "label": "Rail source",
      "default": "products",
      "options": [
        { "value": "products", "label": "Products" },
        { "value": "collections", "label": "Collections" },
        { "value": "mixed", "label": "Mixed" }
      ]
    },
    {
      "type": "product_list",
      "id": "rail_products",
      "label": "Rail products"
    },
    {
      "type": "collection_list",
      "id": "rail_collections",
      "label": "Rail collections"
    },
    {
      "type": "range",
      "id": "rail_item_limit",
      "label": "Rail item limit",
      "min": 3,
      "max": 16,
      "step": 1,
      "default": 9
    },
    {
      "type": "select",
      "id": "show_progress",
      "label": "Progress indicator",
      "default": "bar",
      "options": [
        { "value": "bar", "label": "Bar" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show controls",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "peek_next",
      "label": "Peek next card",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_drop_label",
      "label": "Show DROP label",
      "default": false
    },
    {
      "type": "text",
      "id": "drop_label",
      "label": "DROP label text",
      "default": "DROP"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "clean-edge",
      "options": [
        { "value": "clean-edge", "label": "Clean edge" },
        { "value": "soft-mask", "label": "Soft mask" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Enable reveal motion",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_hairline_divider",
      "label": "Show hairline divider",
      "default": true
    },
    {
      "type": "select",
      "id": "section_density",
      "label": "Section density",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "Section spacing",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_divider_top",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "contained",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "contained", "label": "Contained" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Carousel"
    }
  ]
}
{% endschema %}
