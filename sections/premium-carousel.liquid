{% comment %}
  FlyFlow Theme - Premium Carousel
  Purpose: High-end editorial carousel with 3/2/1 responsive cards, infinite looping,
           group-based navigation, autoplay, keyboard, and swipe support.
{% endcomment %}

<section
  class="premium-carousel premium-carousel--{{ section.id }} chapter-section chapter-section--spacing-{{ section.settings.section_density | default: section.settings.section_spacing | default: 'standard' }} chapter-section--container-{{ section.settings.container_width | default: 'contained' }}{% if section.settings.show_divider_top %} chapter-section--divider-top{% endif %}{% if section.settings.enable_reveal %} chapter-section--reveal{% endif %}"
  data-section-id="{{ section.id }}"
  data-enable-reveal="{{ section.settings.enable_reveal }}"
  style="
    --pc-bg: {{ section.settings.background_color }};
    --pc-pt: {{ section.settings.padding_top }}px;
    --pc-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="container">
    <div class="premium-carousel__shell">
      <div
        class="premium-carousel__viewport"
        data-premium-carousel
        data-autoplay="{{ section.settings.autoplay }}"
        data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
        aria-label="Featured carousel"
      >
        <div class="premium-carousel__track" data-premium-carousel-track>
          {% for block in section.blocks %}
            {% assign slide_link = block.settings.link | default: routes.collections_url %}
            <article class="premium-carousel__slide" data-premium-carousel-slide {{ block.shopify_attributes }}>
              <a class="premium-carousel__card" href="{{ slide_link }}" aria-label="{{ block.settings.heading | default: 'View item' }}">
                <div class="premium-carousel__media">
                  {% if block.settings.image %}
                    {{
                      block.settings.image
                      | image_url: width: 1600
                      | image_tag:
                        class: 'premium-carousel__image',
                        loading: 'lazy',
                        widths: '480, 720, 960, 1200, 1440, 1600',
                        sizes: '(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 90vw',
                        alt: block.settings.heading
                    }}
                  {% else %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'premium-carousel__image premium-carousel__placeholder' }}
                  {% endif %}
                </div>
                <div class="premium-carousel__overlay">
                  {% if block.settings.subheading != blank %}
                    <p class="premium-carousel__label">{{ block.settings.subheading }}</p>
                  {% endif %}
                  {% if block.settings.heading != blank %}
                    <h3 class="premium-carousel__title">{{ block.settings.heading }}</h3>
                  {% endif %}
                </div>
              </a>
            </article>
          {% endfor %}
        </div>

        <button class="premium-carousel__control premium-carousel__control--prev" type="button" data-premium-carousel-prev aria-label="Previous slides">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="premium-carousel__control premium-carousel__control--next" type="button" data-premium-carousel-next aria-label="Next slides">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="premium-carousel__dots" data-premium-carousel-dots aria-label="Carousel pagination"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .premium-carousel--{{ section.id }} {
    background: var(--pc-bg);
    padding-top: var(--pc-pt);
    padding-bottom: var(--pc-pb);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__shell {
    position: relative;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__viewport {
    --pc-gap: 24px;
    --pc-per-view: 3;
    position: relative;
    outline: none;
  }

  @media (max-width: 1023px) {
    .premium-carousel--{{ section.id }} .premium-carousel__viewport {
      --pc-per-view: 2;
      --pc-gap: 18px;
    }
  }

  @media (max-width: 767px) {
    .premium-carousel--{{ section.id }} .premium-carousel__viewport {
      --pc-per-view: 1;
      --pc-gap: 14px;
    }
  }

  .premium-carousel--{{ section.id }} .premium-carousel__track {
    display: flex;
    gap: var(--pc-gap);
    will-change: transform;
    transform: translate3d(0, 0, 0);
    transition: transform 520ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__slide {
    flex: 0 0 calc((100% - ((var(--pc-per-view) - 1) * var(--pc-gap))) / var(--pc-per-view));
    min-width: 0;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__card {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.09);
    transform: translate3d(0, 0, 0);
    transition:
      transform 320ms ease,
      box-shadow 320ms ease;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.12);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 600ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__card:hover .premium-carousel__image {
    transform: scale(1.045);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 18px 18px 16px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 8%, rgba(0, 0, 0, 0.72) 100%);
    color: #fff;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__label {
    margin: 0 0 6px;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    opacity: 0.85;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1rem;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(12, 12, 12, 0.65);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: background-color 180ms ease;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__control:hover {
    background: rgba(12, 12, 12, 0.85);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__control--prev {
    left: 10px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__control--next {
    right: 10px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__control svg {
    width: 18px;
    height: 18px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__dots {
    margin-top: 18px;
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.24);
    border: none;
    transition:
      transform 180ms ease,
      background-color 180ms ease;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__dot.is-active {
    background: var(--color-accent);
    transform: scale(1.25);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__viewport:focus-visible,
  .premium-carousel--{{ section.id }} .premium-carousel__control:focus-visible,
  .premium-carousel--{{ section.id }} .premium-carousel__dot:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-carousel--{{ section.id }} .premium-carousel__track,
    .premium-carousel--{{ section.id }} .premium-carousel__card,
    .premium-carousel--{{ section.id }} .premium-carousel__image,
    .premium-carousel--{{ section.id }} .premium-carousel__dot {
      transition: none !important;
    }
  }
</style>

<script>
  (function() {
    var root = document.querySelector('.premium-carousel--{{ section.id }} [data-premium-carousel]');
    if (!root) return;

    var track = root.querySelector('[data-premium-carousel-track]');
    var prevBtn = root.querySelector('[data-premium-carousel-prev]');
    var nextBtn = root.querySelector('[data-premium-carousel-next]');
    var dotsWrap = root.querySelector('[data-premium-carousel-dots]');
    var autoplay = root.dataset.autoplay === 'true';
    var autoplaySpeed = parseInt(root.dataset.autoplaySpeed || '4000', 10);
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function debounce(fn, delay) {
      var timeout;
      return function() {
        var args = arguments;
        var context = this;
        window.clearTimeout(timeout);
        timeout = window.setTimeout(function() {
          fn.apply(context, args);
        }, delay);
      };
    }

    var timer = null;
    var currentIndex = 0;
    var perView = 3;
    var totalSlides = 0;
    var totalGroups = 0;
    var isTransitioning = false;
    var startX = 0;
    var isTouch = false;

    var originalSlides = Array.prototype.slice.call(track.querySelectorAll('[data-premium-carousel-slide]'));
    totalSlides = originalSlides.length;
    if (totalSlides < 1) return;

    function getPerView() {
      if (window.matchMedia('(max-width: 767px)').matches) return 1;
      if (window.matchMedia('(max-width: 1023px)').matches) return 2;
      return 3;
    }

    function buildTrack() {
      perView = getPerView();
      root.style.setProperty('--pc-per-view', String(perView));

      var fragment = document.createDocumentFragment();
      var prepend = originalSlides.map(function(node) { return node.cloneNode(true); });
      var middle = originalSlides.map(function(node) { return node.cloneNode(true); });
      var append = originalSlides.map(function(node) { return node.cloneNode(true); });

      prepend.forEach(function(node) { fragment.appendChild(node); });
      middle.forEach(function(node) { fragment.appendChild(node); });
      append.forEach(function(node) { fragment.appendChild(node); });

      track.innerHTML = '';
      track.appendChild(fragment);

      currentIndex = totalSlides;
      totalGroups = Math.ceil(totalSlides / perView);
      buildDots();
      setPosition(false);
      updateDots();
    }

    function getOffsetFor(index) {
      var items = track.children;
      if (!items[index]) return 0;
      return items[index].offsetLeft;
    }

    function setPosition(animate) {
      if (!animate || reduceMotion) {
        track.style.transition = 'none';
      } else {
        track.style.transition = 'transform 520ms cubic-bezier(0.22, 0.61, 0.36, 1)';
      }

      var offset = getOffsetFor(currentIndex);
      track.style.transform = 'translate3d(' + (-offset) + 'px, 0, 0)';

      if (!animate || reduceMotion) {
        track.offsetHeight;
        track.style.transition = 'transform 520ms cubic-bezier(0.22, 0.61, 0.36, 1)';
      }
    }

    function normalizeIndex() {
      if (currentIndex >= totalSlides * 2) {
        currentIndex -= totalSlides;
        setPosition(false);
      } else if (currentIndex < totalSlides) {
        currentIndex += totalSlides;
        setPosition(false);
      }
    }

    function next() {
      if (isTransitioning) return;
      isTransitioning = true;
      currentIndex += perView;
      setPosition(true);
    }

    function prev() {
      if (isTransitioning) return;
      isTransitioning = true;
      currentIndex -= perView;
      setPosition(true);
    }

    function goToGroup(groupIndex) {
      if (isTransitioning) return;
      var targetLogical = (groupIndex * perView) % totalSlides;
      currentIndex = totalSlides + targetLogical;
      setPosition(true);
      isTransitioning = true;
    }

    function getLogicalIndex() {
      var logical = (currentIndex - totalSlides) % totalSlides;
      return logical < 0 ? logical + totalSlides : logical;
    }

    function getActiveGroup() {
      return Math.floor(getLogicalIndex() / perView);
    }

    function buildDots() {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = '';
      for (var i = 0; i < totalGroups; i += 1) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'premium-carousel__dot';
        dot.setAttribute('aria-label', 'Go to slide group ' + (i + 1));
        dot.addEventListener('click', (function(group) {
          return function() {
            stopAutoplay();
            goToGroup(group);
            startAutoplay();
          };
        })(i));
        dotsWrap.appendChild(dot);
      }
    }

    function updateDots() {
      if (!dotsWrap) return;
      var active = getActiveGroup();
      Array.prototype.forEach.call(dotsWrap.children, function(dot, idx) {
        dot.classList.toggle('is-active', idx === active);
      });
    }

    function startAutoplay() {
      if (!autoplay || reduceMotion) return;
      stopAutoplay();
      timer = window.setInterval(next, autoplaySpeed);
    }

    function stopAutoplay() {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    function onResize() {
      var nextPerView = getPerView();
      if (nextPerView === perView) return;
      buildTrack();
    }

    prevBtn.addEventListener('click', function() {
      stopAutoplay();
      prev();
      startAutoplay();
    });

    nextBtn.addEventListener('click', function() {
      stopAutoplay();
      next();
      startAutoplay();
    });

    track.addEventListener('transitionend', function() {
      isTransitioning = false;
      normalizeIndex();
      updateDots();
    });

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);

    root.setAttribute('tabindex', '0');
    root.addEventListener('keydown', function(event) {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        stopAutoplay();
        next();
        startAutoplay();
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        stopAutoplay();
        prev();
        startAutoplay();
      }
    });

    root.addEventListener('touchstart', function(event) {
      if (!event.touches || !event.touches.length) return;
      isTouch = true;
      startX = event.touches[0].clientX;
      stopAutoplay();
    }, { passive: true });

    root.addEventListener('touchend', function(event) {
      if (!isTouch || !event.changedTouches || !event.changedTouches.length) return;
      var diff = event.changedTouches[0].clientX - startX;
      if (Math.abs(diff) > 40) {
        if (diff < 0) {
          next();
        } else {
          prev();
        }
      }
      isTouch = false;
      startAutoplay();
    }, { passive: true });

    window.addEventListener('resize', debounce(onResize, 160));

    buildTrack();
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "Premium Carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "unit": "s"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "section_density",
      "label": "Section density",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "Section spacing",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_divider_top",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "contained",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Enable reveal",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Editorial Feature"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "New Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Premium Carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
