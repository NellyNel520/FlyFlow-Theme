{% comment %}
  FlyFlow Theme - Premium Carousel
  Purpose: Product/collection rail under hero with manual controls and progress.
  Last modified: 2026-02-19
{% endcomment %}

{% liquid
  assign rail_limit = section.settings.rail_item_limit | default: 8
%}

<section
  class="premium-carousel premium-carousel--{{ section.id }} chapter-section chapter-section--spacing-{{ section.settings.section_density | default: section.settings.section_spacing | default: 'standard' }} chapter-section--container-{{ section.settings.container_width | default: 'contained' }}{% if section.settings.show_divider_top %} chapter-section--divider-top{% endif %}{% if section.settings.enable_reveal %} chapter-section--reveal{% endif %}"
  data-section-id="{{ section.id }}"
  data-enable-reveal="{{ section.settings.enable_reveal }}"
>
  <div class="container">
    <div class="premium-carousel__shell">
      <div class="premium-carousel__head">
        {% if section.settings.heading != blank %}
          <h2 class="premium-carousel__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.show_controls %}
          <div class="premium-carousel__controls">
            <button type="button" class="premium-carousel__btn" data-pc-prev aria-label="Previous rail items">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="premium-carousel__btn" data-pc-next aria-label="Next rail items">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        {% endif %}
      </div>

      <div class="premium-carousel__viewport{% if section.settings.peek_next %} is-peek{% endif %}" data-pc-viewport tabindex="0" aria-label="FlyFlow gallery rail">
        <div class="premium-carousel__track" data-pc-track>
          {% assign rendered_items = 0 %}

          {% if section.settings.rail_source == 'products' %}
            {% for block in section.blocks %}
              {% if rendered_items >= rail_limit %}{% break %}{% endif %}
              {% if block.settings.product != blank %}
                {% assign product = block.settings.product %}
                <article class="premium-carousel__card" data-pc-card {{ block.shopify_attributes }}>
                  <a href="{{ product.url }}" class="premium-carousel__card-link">
                    <div class="premium-carousel__media">
                      {% if product.featured_image %}
                        {{ product.featured_image | image_url: width: 960 | image_tag: class: 'premium-carousel__image', loading: 'lazy', widths: '280,420,640,840,960', sizes: '(min-width: 990px) 23vw, 76vw', alt: product.title }}
                      {% endif %}
                    </div>
                    <div class="premium-carousel__meta">
                      <p class="premium-carousel__kicker">Product</p>
                      <h3 class="premium-carousel__title">{{ product.title }}</h3>
                      <p class="premium-carousel__price">{{ product.price | money }}</p>
                    </div>
                  </a>

                  {% if section.settings.enable_quick_add and product.selected_or_first_available_variant != blank %}
                    <button
                      type="button"
                      class="premium-carousel__quick-add"
                      data-add-to-cart
                      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      data-add-text="Quick add"
                      aria-label="Quick add {{ product.title }}"
                    >
                      Quick add
                    </button>
                  {% endif %}
                </article>
                {% assign rendered_items = rendered_items | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if section.settings.rail_source == 'collections' %}
            {% for block in section.blocks %}
              {% if rendered_items >= rail_limit %}{% break %}{% endif %}
              {% if block.settings.collection != blank %}
                {% assign collection = block.settings.collection %}
                <article class="premium-carousel__card" data-pc-card {{ block.shopify_attributes }}>
                  <a href="{{ collection.url }}" class="premium-carousel__card-link">
                    <div class="premium-carousel__media">
                      {% if collection.image %}
                        {{ collection.image | image_url: width: 960 | image_tag: class: 'premium-carousel__image', loading: 'lazy', widths: '280,420,640,840,960', sizes: '(min-width: 990px) 23vw, 76vw', alt: collection.title }}
                      {% elsif collection.products.first.featured_image %}
                        {{ collection.products.first.featured_image | image_url: width: 960 | image_tag: class: 'premium-carousel__image', loading: 'lazy', widths: '280,420,640,840,960', sizes: '(min-width: 990px) 23vw, 76vw', alt: collection.title }}
                      {% endif %}
                    </div>
                    <div class="premium-carousel__meta">
                      <p class="premium-carousel__kicker">Collection</p>
                      <h3 class="premium-carousel__title">{{ collection.title }}</h3>
                      <p class="premium-carousel__price">{{ collection.products_count }} items</p>
                    </div>
                  </a>
                </article>
                {% assign rendered_items = rendered_items | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if rendered_items == 0 %}
            {% for block in section.blocks %}
              {% if rendered_items >= rail_limit %}{% break %}{% endif %}
              {% if block.settings.image != blank or block.settings.heading != blank %}
                <article class="premium-carousel__card" data-pc-card {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.link | default: routes.collections_url }}" class="premium-carousel__card-link">
                    <div class="premium-carousel__media">
                      {% if block.settings.image %}
                        {{ block.settings.image | image_url: width: 960 | image_tag: class: 'premium-carousel__image', loading: 'lazy', widths: '280,420,640,840,960', sizes: '(min-width: 990px) 23vw, 76vw', alt: block.settings.heading }}
                      {% else %}
                        {{ 'lifestyle-2' | placeholder_svg_tag: 'premium-carousel__image premium-carousel__placeholder' }}
                      {% endif %}
                    </div>
                    <div class="premium-carousel__meta">
                      {% if block.settings.subheading != blank %}<p class="premium-carousel__kicker">{{ block.settings.subheading }}</p>{% endif %}
                      {% if block.settings.heading != blank %}<h3 class="premium-carousel__title">{{ block.settings.heading }}</h3>{% endif %}
                    </div>
                  </a>
                </article>
                {% assign rendered_items = rendered_items | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>

      {% if section.settings.show_progress == 'bar' %}
        <div class="premium-carousel__progress" aria-hidden="true">
          <span class="premium-carousel__progress-fill" data-pc-progress></span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .premium-carousel--{{ section.id }} .premium-carousel__shell {
    padding-block: clamp(10px, 1.8vw, 18px);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__heading {
    margin: 0;
    font-size: clamp(1rem, 1.8vw, 1.45rem);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__controls {
    display: inline-flex;
    gap: 8px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__btn {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    border: 0;
    background: transparent;
    transition: transform var(--transition-fast);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__btn:hover {
    transform: translateY(-1px);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__btn svg {
    width: 16px;
    height: 16px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    min-width: 0;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__viewport::-webkit-scrollbar {
    display: none;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(190px, 23%);
    gap: 14px;
    padding-right: 14px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__viewport.is-peek .premium-carousel__track {
    grid-auto-columns: minmax(190px, 23%);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__viewport:not(.is-peek) .premium-carousel__track {
    grid-auto-columns: minmax(190px, 24%);
    padding-right: 0;
  }

  @media (max-width: 1280px) {
    .premium-carousel--{{ section.id }} .premium-carousel__track {
      grid-auto-columns: minmax(190px, 29%);
    }
  }

  @media (max-width: 1023px) {
    .premium-carousel--{{ section.id }} .premium-carousel__track {
      grid-auto-columns: minmax(190px, 42%);
    }
  }

  @media (max-width: 767px) {
    .premium-carousel--{{ section.id }} .premium-carousel__track {
      grid-auto-columns: minmax(180px, 74%);
      gap: 12px;
    }

    .premium-carousel--{{ section.id }} .premium-carousel__btn {
      width: 34px;
      height: 34px;
    }
  }

  .premium-carousel--{{ section.id }} .premium-carousel__card {
    scroll-snap-align: start;
    border-radius: 0;
    border: 0;
    background: #ffffff;
    box-shadow: none;
    overflow: hidden;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__card-link {
    display: block;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #ffffff;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__card-link:hover .premium-carousel__image {
    transform: scale(1.04);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__meta {
    padding: 11px 12px 13px;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__kicker {
    margin: 0 0 4px;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__title {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__price {
    margin: 5px 0 0;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__quick-add {
    width: calc(100% - 20px);
    min-height: 36px;
    margin: 0 10px 10px;
    border-radius: 0;
    border: 0;
    background: #f7f7f7;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__progress {
    margin-top: 10px;
    height: 2px;
    border-radius: 0;
    background: rgba(0, 0, 0, 0.12);
    overflow: hidden;
  }

  .premium-carousel--{{ section.id }} .premium-carousel__progress-fill {
    display: block;
    width: 0;
    height: 100%;
    background: #101014;
    transition: width var(--transition-fast);
  }

  .premium-carousel--{{ section.id }} .premium-carousel__btn:focus-visible,
  .premium-carousel--{{ section.id }} .premium-carousel__viewport:focus-visible,
  .premium-carousel--{{ section.id }} .premium-carousel__quick-add:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .premium-carousel--{{ section.id }} [data-pc-card] {
    opacity: 1;
    transform: none;
  }

  .premium-carousel--{{ section.id }}.is-pending-reveal [data-pc-card] {
    opacity: 0;
    transform: translateY(12px);
  }

  .premium-carousel--{{ section.id }}.is-revealed [data-pc-card] {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-carousel--{{ section.id }} .premium-carousel__btn,
    .premium-carousel--{{ section.id }} .premium-carousel__image,
    .premium-carousel--{{ section.id }} .premium-carousel__progress-fill,
    .premium-carousel--{{ section.id }} [data-pc-card] {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  (function() {
    var section = document.querySelector('.premium-carousel--{{ section.id }}');
    if (!section) return;

    var viewport = section.querySelector('[data-pc-viewport]');
    var prev = section.querySelector('[data-pc-prev]');
    var next = section.querySelector('[data-pc-next]');
    var progress = section.querySelector('[data-pc-progress]');
    var cards = section.querySelectorAll('[data-pc-card]');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function clamp(n, min, max) {
      return Math.min(Math.max(n, min), max);
    }

    function updateProgress() {
      if (!viewport || !progress) return;
      var maxScroll = viewport.scrollWidth - viewport.clientWidth;
      var ratio = maxScroll > 0 ? viewport.scrollLeft / maxScroll : 0;
      progress.style.width = (clamp(ratio, 0, 1) * 100) + '%';
    }

    function scrollByPage(direction) {
      if (!viewport) return;
      var amount = viewport.clientWidth * ({% if section.settings.peek_next %}0.86{% else %}1{% endif %});
      viewport.scrollBy({ left: amount * direction, behavior: reduceMotion ? 'auto' : 'smooth' });
    }

    if (prev) {
      prev.addEventListener('click', function() { scrollByPage(-1); });
    }

    if (next) {
      next.addEventListener('click', function() { scrollByPage(1); });
    }

    if (viewport) {
      viewport.addEventListener('scroll', updateProgress, { passive: true });
      viewport.addEventListener('keydown', function(event) {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          scrollByPage(1);
        }
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          scrollByPage(-1);
        }
      });
      updateProgress();
    }

    if (section.dataset.enableReveal === 'true' && !reduceMotion) {
      section.classList.add('is-pending-reveal');
      cards.forEach(function(card, idx) {
        card.style.transitionDelay = (120 + (idx * 58)) + 'ms';
      });

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            section.classList.add('is-revealed');
            observer.disconnect();
          }
        });
      }, { threshold: 0.22 });

      observer.observe(section);
    }
  })();
</script>

{% schema %}
{
  "name": "Premium Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gallery Rail"
    },
    {
      "type": "select",
      "id": "rail_source",
      "label": "Rail source",
      "default": "products",
      "options": [
        { "value": "products", "label": "Products" },
        { "value": "collections", "label": "Collections" }
      ]
    },
    {
      "type": "range",
      "id": "rail_item_limit",
      "label": "Rail item limit",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show controls",
      "default": true
    },
    {
      "type": "select",
      "id": "show_progress",
      "label": "Progress style",
      "default": "bar",
      "options": [
        { "value": "bar", "label": "Bar" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "checkbox",
      "id": "peek_next",
      "label": "Peek next",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable quick add",
      "default": false
    },
    {
      "type": "select",
      "id": "section_density",
      "label": "Section density",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "Section spacing",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_divider_top",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "contained",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Enable reveal",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Rail item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Fallback heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Fallback subheading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Premium Carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
