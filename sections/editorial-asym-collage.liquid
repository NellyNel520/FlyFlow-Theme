{% liquid
  assign overlay_alpha = section.settings.overlay_tint_opacity | divided_by: 100.0
  assign style_mode = section.settings.style_mode | default: 'clean'
%}

<section
  class="section editorial-asym-collage editorial-asym-collage--{{ section.id }} editorial-asym-collage--mode-{{ style_mode }} editorial-asym-collage--layout-{{ section.settings.collage_layout | default: 'mosaic' }} chapter-section chapter-section--spacing-{{ section.settings.section_density | default: 'standard' }} chapter-section--container-{{ section.settings.container_width | default: 'contained' }}{% if section.settings.show_divider_top %} chapter-section--divider-top{% endif %}{% if section.settings.enable_reveal %} chapter-section--reveal{% endif %}"
  data-section-id="{{ section.id }}"
  data-enable-reveal="{{ section.settings.enable_reveal }}"
  data-style-mode="{{ style_mode }}"
>
  <div class="container">
    <div class="editorial-asym-collage__grid">
      <article class="editorial-asym-collage__campaign" data-asym-reveal data-reveal-order="0">
        {% if section.settings.campaign_media_type == 'video' and section.settings.campaign_video != blank %}
          {{
            section.settings.campaign_video
            | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '2400x'
          }}
        {% elsif section.settings.campaign_media != blank %}
          {{
            section.settings.campaign_media
            | image_url: width: 2400
            | image_tag:
              class: 'editorial-asym-collage__campaign-media',
              loading: 'lazy',
              widths: '720,1080,1440,1800,2200',
              sizes: '(min-width: 990px) 58vw, 100vw',
              alt: section.settings.headline_text
          }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'editorial-asym-collage__campaign-media editorial-asym-collage__placeholder' }}
        {% endif %}

        {% if section.settings.overlay_tint_opacity > 0 %}
          <div
            class="editorial-asym-collage__campaign-tint"
            style="--asym-tint-color: {{ section.settings.overlay_tint_color }}; --asym-tint-alpha: {{ overlay_alpha }}"
          ></div>
        {% endif %}

        {% if style_mode == 'collage' and section.settings.show_scribble_overlay %}
          <svg class="editorial-asym-collage__scribble" viewBox="0 0 220 80" role="presentation" aria-hidden="true" focusable="false">
            <path d="M8 62 C42 10, 88 12, 136 40 S190 76, 212 22" />
            <path d="M6 72 C38 24, 84 24, 130 48 S186 84, 214 30" />
          </svg>
        {% endif %}

        <div class="editorial-asym-collage__campaign-copy editorial-asym-collage__campaign-copy--{{ section.settings.overlay_position }}">
          {% if section.settings.label_text != blank %}
            <p class="editorial-asym-collage__label" data-asym-reveal data-reveal-order="1">{{ section.settings.label_text }}</p>
          {% endif %}
          {% if section.settings.headline_text != blank %}
            <h2 class="editorial-asym-collage__headline" data-asym-reveal data-reveal-order="2">{{ section.settings.headline_text }}</h2>
          {% endif %}
          {% if section.settings.subheading_text != blank %}
            <p class="editorial-asym-collage__subheading" data-asym-reveal data-reveal-order="3">{{ section.settings.subheading_text }}</p>
          {% endif %}
          {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
            <a class="editorial-asym-collage__cta" href="{{ section.settings.cta_link }}" data-asym-reveal data-reveal-order="4">{{ section.settings.cta_label }}</a>
          {% endif %}
        </div>
      </article>

      {% for block in section.blocks %}
        {% liquid
          assign tilt = block.settings.tilt | default: '0'
          assign aspect_ratio = block.settings.aspect_ratio | default: 'auto'
          assign tile_size = block.settings.tile_size | default: 'medium'
        %}
        <article
          class="editorial-asym-collage__tile editorial-asym-collage__tile--{{ forloop.index }} editorial-asym-collage__tile--size-{{ tile_size }} editorial-asym-collage__tile--ratio-{{ aspect_ratio }}{% if style_mode == 'collage' and block.settings.paper_backing %} has-paper-backing{% endif %}"
          style="--tile-tilt: {{ tilt }}deg;"
          data-asym-reveal
          data-reveal-order="{{ forloop.index | plus: 4 }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1800
              | image_tag:
                class: 'editorial-asym-collage__tile-image',
                loading: 'lazy',
                widths: '260,380,560,760,980,1200',
                sizes: '(min-width: 990px) 32vw, 100vw',
                alt: block.settings.caption
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'editorial-asym-collage__tile-image editorial-asym-collage__placeholder' }}
          {% endif %}
          {% if block.settings.caption != blank %}
            <p class="editorial-asym-collage__tile-caption">{{ block.settings.caption }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(150px, auto);
    gap: clamp(var(--space-sm), 1.4vw, var(--space-md));
    align-items: stretch;
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__campaign {
    grid-column: 1 / span 7;
    grid-row: 1 / span 2;
    position: relative;
    min-height: clamp(460px, 64vw, 780px);
    border-radius: 14px;
    overflow: hidden;
    isolation: isolate;
    background: #0f1115;
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__campaign video,
  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__campaign-media {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__campaign-tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(10, 12, 15, 0.06) 8%, color-mix(in srgb, var(--asym-tint-color) 100%, transparent) 100%);
    opacity: var(--asym-tint-alpha);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__scribble {
    position: absolute;
    right: 4%;
    top: 7%;
    width: clamp(90px, 12vw, 170px);
    height: auto;
    z-index: 2;
    stroke: rgba(255, 255, 255, 0.62);
    stroke-width: 2.2;
    fill: none;
    opacity: 0.56;
    pointer-events: none;
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__campaign-copy {
    position: absolute;
    z-index: 3;
    color: #fff;
    max-width: min(88%, 620px);
    display: grid;
    gap: var(--space-sm);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__campaign-copy--bottom_left {
    left: clamp(var(--space-md), 2.2vw, var(--space-2xl));
    right: clamp(var(--space-md), 2.2vw, var(--space-2xl));
    bottom: clamp(var(--space-md), 2.4vw, var(--space-2xl));
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__campaign-copy--center_left {
    left: clamp(var(--space-md), 2.2vw, var(--space-2xl));
    right: clamp(var(--space-md), 2.2vw, var(--space-2xl));
    top: 50%;
    transform: translateY(-50%);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__campaign-copy--bottom_center {
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    bottom: clamp(var(--space-md), 2.4vw, var(--space-2xl));
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__label {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__headline {
    margin: 0;
    font-size: clamp(2.3rem, 4.9vw, 5.4rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__subheading {
    margin: 0;
    font-size: clamp(0.92rem, 1.16vw, 1.06rem);
    line-height: 1.45;
    max-width: 34ch;
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__cta {
    display: inline-flex;
    width: fit-content;
    color: #fff;
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: #121419;
    box-shadow: 0 10px 22px rgba(10, 12, 16, 0.12);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .editorial-asym-collage--{{ section.id }}.editorial-asym-collage--mode-collage .editorial-asym-collage__tile.has-paper-backing {
    background: #f5f3ef;
    border: 1px solid rgba(12, 14, 18, 0.1);
    box-shadow: 0 12px 28px rgba(10, 12, 16, 0.16);
    padding: clamp(6px, 0.85vw, 10px);
  }

  .editorial-asym-collage--{{ section.id }}.editorial-asym-collage--mode-collage .editorial-asym-collage__tile {
    transform: rotate(var(--tile-tilt));
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile:hover {
    transform: rotate(var(--tile-tilt)) scale(1.02);
    box-shadow: 0 14px 32px rgba(10, 12, 16, 0.2);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile:hover .editorial-asym-collage__tile-image {
    transform: scale(1.02);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile-caption {
    margin: 0;
    position: absolute;
    left: var(--space-sm);
    bottom: var(--space-sm);
    font-size: 0.67rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--1 {
    grid-column: 8 / span 5;
    grid-row: 1;
    min-height: clamp(180px, 22vw, 280px);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--2 {
    grid-column: 8 / span 3;
    grid-row: 2;
    min-height: clamp(170px, 18vw, 240px);
    margin-top: clamp(6px, 1.1vw, 14px);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--3 {
    grid-column: 11 / span 2;
    grid-row: 2;
    min-height: clamp(170px, 18vw, 240px);
    margin-top: clamp(12px, 1.6vw, 20px);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--4 {
    grid-column: 8 / span 5;
    grid-row: 3;
    min-height: clamp(160px, 16vw, 210px);
    margin-top: clamp(8px, 1.2vw, 16px);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--5 {
    grid-column: 1 / span 4;
    grid-row: 3;
    min-height: clamp(150px, 16vw, 210px);
    margin-top: clamp(12px, 1.4vw, 18px);
  }

  .editorial-asym-collage--{{ section.id }}.editorial-asym-collage--layout-stacked .editorial-asym-collage__tile--1 {
    grid-column: 8 / span 5;
    grid-row: 1;
  }

  .editorial-asym-collage--{{ section.id }}.editorial-asym-collage--layout-stacked .editorial-asym-collage__tile--2 {
    grid-column: 8 / span 5;
    grid-row: 2;
    margin-top: 0;
  }

  .editorial-asym-collage--{{ section.id }}.editorial-asym-collage--layout-stacked .editorial-asym-collage__tile--3 {
    grid-column: 8 / span 5;
    grid-row: 3;
    margin-top: 0;
  }

  .editorial-asym-collage--{{ section.id }}.editorial-asym-collage--layout-stacked .editorial-asym-collage__tile--4,
  .editorial-asym-collage--{{ section.id }}.editorial-asym-collage--layout-stacked .editorial-asym-collage__tile--5 {
    grid-column: auto;
    grid-row: auto;
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--size-micro {
    min-height: clamp(130px, 14vw, 185px);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--size-small {
    min-height: clamp(150px, 17vw, 220px);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--size-medium {
    min-height: clamp(170px, 19vw, 260px);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--size-wide {
    min-height: clamp(130px, 14vw, 180px);
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--ratio-1_1 {
    aspect-ratio: 1 / 1;
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--ratio-4_5 {
    aspect-ratio: 4 / 5;
  }

  .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--ratio-3_2 {
    aspect-ratio: 3 / 2;
  }

  .editorial-asym-collage--{{ section.id }} [data-asym-reveal] {
    opacity: 1;
    transform: none;
  }

  .editorial-asym-collage--{{ section.id }}.is-pending-reveal [data-asym-reveal] {
    opacity: 0;
    transform: translateY(20px);
  }

  .editorial-asym-collage--{{ section.id }}.is-revealed [data-asym-reveal] {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--transition-base), transform var(--transition-base);
    transition-delay: var(--reveal-delay, 0ms);
  }

  @media (max-width: 1199px) {
    .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
    }

    .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__campaign {
      grid-column: 1 / -1;
      grid-row: 1;
      min-height: clamp(400px, 66vw, 620px);
    }

    .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile {
      grid-column: auto;
      grid-row: auto;
      margin-top: 0 !important;
      min-height: clamp(180px, 30vw, 280px);
    }

    .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile--5 {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 989px) {
    .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__campaign {
      min-height: clamp(340px, 76vw, 540px);
    }

    .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__campaign-copy {
      left: var(--space-md);
      right: var(--space-md);
      max-width: min(92%, 540px);
    }

    .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__campaign-copy--bottom_center {
      left: var(--space-md);
      right: var(--space-md);
      transform: none;
      text-align: left;
    }

    .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile {
      transform: none !important;
      min-height: 0;
      aspect-ratio: 4 / 5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-asym-collage--{{ section.id }} [data-asym-reveal] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile,
    .editorial-asym-collage--{{ section.id }} .editorial-asym-collage__tile-image {
      transition: none !important;
    }
  }
</style>

<script>
  (function() {
    var section = document.querySelector('.editorial-asym-collage--{{ section.id }}');
    if (!section) return;

    if (section.dataset.enableReveal !== 'true' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    var revealEls = section.querySelectorAll('[data-asym-reveal]');
    if (!revealEls.length) return;

    section.classList.add('is-pending-reveal');
    revealEls.forEach(function(el) {
      var order = parseInt(el.getAttribute('data-reveal-order') || '0', 10);
      el.style.setProperty('--reveal-delay', (Math.max(0, order) * 90) + 'ms');
    });

    if (!('IntersectionObserver' in window)) {
      section.classList.add('is-revealed');
      return;
    }

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-revealed');
          observer.disconnect();
        }
      });
    }, { threshold: 0.2 });

    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Editorial Asym Collage",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "contained",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "select",
      "id": "section_density",
      "label": "Section density",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_divider_top",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Enable reveal",
      "default": true
    },
    {
      "type": "select",
      "id": "style_mode",
      "label": "Style mode",
      "default": "clean",
      "options": [
        { "value": "clean", "label": "Clean" },
        { "value": "collage", "label": "Collage" }
      ]
    },
    {
      "type": "select",
      "id": "collage_layout",
      "label": "Collage layout",
      "default": "mosaic",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "mosaic", "label": "Mosaic" }
      ]
    },
    {
      "type": "header",
      "content": "Campaign tile"
    },
    {
      "type": "select",
      "id": "campaign_media_type",
      "label": "Campaign media type",
      "default": "image",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ]
    },
    {
      "type": "image_picker",
      "id": "campaign_media",
      "label": "Campaign image"
    },
    {
      "type": "video",
      "id": "campaign_video",
      "label": "Campaign video"
    },
    {
      "type": "color",
      "id": "overlay_tint_color",
      "label": "Overlay tint color",
      "default": "#0B0D11"
    },
    {
      "type": "range",
      "id": "overlay_tint_opacity",
      "label": "Overlay tint opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label text",
      "default": "FLYFLOW / DROP 02"
    },
    {
      "type": "text",
      "id": "headline_text",
      "label": "Headline text",
      "default": "STREETWEAR"
    },
    {
      "type": "text",
      "id": "subheading_text",
      "label": "Subheading text",
      "default": "Built for movement. Styled for impact."
    },
    {
      "type": "select",
      "id": "overlay_position",
      "label": "Overlay position",
      "default": "bottom_left",
      "options": [
        { "value": "bottom_left", "label": "Bottom left" },
        { "value": "center_left", "label": "Center left" },
        { "value": "bottom_center", "label": "Bottom center" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_scribble_overlay",
      "label": "Show scribble overlay",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "support_tile",
      "name": "Support tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "tile_size",
          "label": "Tile size",
          "default": "medium",
          "options": [
            { "value": "micro", "label": "Micro" },
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "wide", "label": "Wide" }
          ]
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "checkbox",
          "id": "paper_backing",
          "label": "Paper backing",
          "default": false
        },
        {
          "type": "select",
          "id": "tilt",
          "label": "Tilt",
          "default": "0",
          "options": [
            { "value": "-2", "label": "-2" },
            { "value": "0", "label": "0" },
            { "value": "2", "label": "+2" }
          ]
        },
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Aspect ratio",
          "default": "auto",
          "options": [
            { "value": "auto", "label": "Auto" },
