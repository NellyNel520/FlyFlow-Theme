{% comment %}
  FlyFlow Theme - Editorial Asymmetric Feature Grid
  Purpose: Conversion-focused editorial hero with asymmetric feature tiles.
  Last modified: 2026-02-19
{% endcomment %}

<section
  class="section editorial-landing editorial-landing--{{ section.id }} chapter-section chapter-section--spacing-{{ section.settings.section_density | default: section.settings.section_spacing | default: 'standard' }} chapter-section--container-{{ section.settings.container_width | default: 'contained' }}{% if section.settings.show_divider_top %} chapter-section--divider-top{% endif %}{% if section.settings.enable_reveal %} chapter-section--reveal{% endif %}"
  data-section-id="{{ section.id }}"
  data-enable-reveal="{{ section.settings.enable_reveal }}"
>
  <div class="container">
    <div class="editorial-landing__grid">
      <article class="editorial-landing__hero editorial-landing__hero--{{ section.settings.overlay_position }}">
        <div class="editorial-landing__hero-media" aria-hidden="true">
          {% if section.settings.media_type == 'video' and section.settings.video != blank %}
            {{ section.settings.video | video_tag: autoplay: true, muted: true, loop: true, controls: false, image_size: '1800x' }}
          {% else %}
            {% if section.settings.mobile_image != blank %}
              {{ section.settings.mobile_image | image_url: width: 1200 | image_tag: class: 'editorial-landing__hero-image editorial-landing__hero-image--mobile', loading: 'lazy', widths: '420,640,900,1200', sizes: '(max-width: 767px) 100vw, 0px', alt: section.settings.heading }}
            {% endif %}
            {% if section.settings.image != blank %}
              {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'editorial-landing__hero-image editorial-landing__hero-image--desktop', loading: 'lazy', widths: '720,960,1280,1600,1800', sizes: '(min-width: 990px) 58vw, 100vw', alt: section.settings.heading }}
            {% endif %}
          {% endif %}
        </div>

        <div class="editorial-landing__hero-overlay"></div>

        <div class="editorial-landing__hero-content">
          {% if section.settings.overline != blank %}
            <p class="editorial-landing__overline">{{ section.settings.overline }}</p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="editorial-landing__heading">{{ section.settings.heading }}</h2>
          {% endif %}

          {% if section.settings.subheading != blank %}
            <p class="editorial-landing__subheading">{{ section.settings.subheading }}</p>
          {% endif %}

          <div class="editorial-landing__actions">
            {% if section.settings.primary_button_text != blank and section.settings.primary_button_link != blank %}
              <a href="{{ section.settings.primary_button_link }}" class="btn btn--primary">{{ section.settings.primary_button_text }}</a>
            {% endif %}
            {% if section.settings.secondary_button_text != blank and section.settings.secondary_button_link != blank %}
              <a href="{{ section.settings.secondary_button_link }}" class="btn btn--ghost">{{ section.settings.secondary_button_text }}</a>
            {% endif %}
          </div>

          {% if section.settings.show_product_highlight and section.settings.highlight_product != blank %}
            {% assign highlight_product = section.settings.highlight_product %}
            <a class="editorial-landing__highlight" href="{{ highlight_product.url }}" aria-label="View featured product {{ highlight_product.title }}">
              <div class="editorial-landing__highlight-media">
                {% if highlight_product.featured_image %}
                  {{ highlight_product.featured_image | image_url: width: 320 | image_tag: class: 'editorial-landing__highlight-image', loading: 'lazy', widths: '160,240,320', sizes: '80px', alt: highlight_product.title }}
                {% endif %}
              </div>
              <div class="editorial-landing__highlight-meta">
                <p class="editorial-landing__highlight-label">Product Highlight</p>
                <p class="editorial-landing__highlight-title">{{ highlight_product.title }}</p>
                <p class="editorial-landing__highlight-price">{{ highlight_product.price | money }}</p>
              </div>
            </a>
          {% endif %}
        </div>
      </article>

      <div class="editorial-landing__tiles">
        {% for block in section.blocks %}
          <article class="editorial-landing__tile" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="editorial-landing__tile-media">
                {{ block.settings.image | image_url: width: 960 | image_tag: class: 'editorial-landing__tile-image', loading: 'lazy', widths: '280,420,640,960', sizes: '(min-width: 990px) 20vw, 100vw', alt: block.settings.title }}
              </div>
            {% endif %}
            <div class="editorial-landing__tile-content">
              {% if block.settings.title != blank %}
                <h3 class="editorial-landing__tile-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="editorial-landing__tile-text">{{ block.settings.text }}</p>
              {% endif %}
              {% if block.settings.link_label != blank and block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="editorial-landing__tile-link">{{ block.settings.link_label }}</a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.show_hairline_divider %}
      <div class="editorial-landing__hairline" aria-hidden="true"></div>
    {% endif %}
  </div>
</section>

<style>
  .editorial-landing--{{ section.id }} .editorial-landing__grid {
    display: grid;
    gap: clamp(14px, 2vw, 22px);
  }

  @media (min-width: 990px) {
    .editorial-landing--{{ section.id }} .editorial-landing__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      align-items: stretch;
    }
  }

  .editorial-landing--{{ section.id }} .editorial-landing__hero {
    position: relative;
    min-height: clamp(420px, 58vw, 700px);
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: #0f0f12;
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.12);
  }

  .editorial-landing--{{ section.id }} .editorial-landing__hero-media,
  .editorial-landing--{{ section.id }} .editorial-landing__hero-overlay,
  .editorial-landing--{{ section.id }} .editorial-landing__hero-content {
    position: absolute;
    inset: 0;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__hero-media video,
  .editorial-landing--{{ section.id }} .editorial-landing__hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__hero-image--mobile {
    display: none;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__hero-overlay {
    background: linear-gradient(135deg, rgba(10, 10, 12, 0.72), rgba(10, 10, 12, 0.38));
  }

  .editorial-landing--{{ section.id }} .editorial-landing__hero-content {
    z-index: 2;
    display: grid;
    align-content: end;
    justify-items: start;
    gap: 12px;
    padding: clamp(18px, 2.6vw, 30px);
    color: #ffffff;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__hero--center .editorial-landing__hero-content {
    align-content: center;
    justify-items: center;
    text-align: center;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__hero--right .editorial-landing__hero-content {
    justify-items: end;
    text-align: right;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__overline {
    margin: 0;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.84;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__heading {
    margin: 0;
    font-size: clamp(1.8rem, 3.5vw, 3.15rem);
    line-height: 1.06;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__subheading {
    margin: 0;
    max-width: 36ch;
    font-size: clamp(0.95rem, 1.15vw, 1.08rem);
    line-height: 1.5;
    opacity: 0.9;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__highlight {
    margin-top: 6px;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 10px;
    min-height: 74px;
    width: min(100%, 360px);
    padding: 8px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.26);
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(4px);
  }

  .editorial-landing--{{ section.id }} .editorial-landing__highlight-media {
    width: 58px;
    height: 58px;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.2);
  }

  .editorial-landing--{{ section.id }} .editorial-landing__highlight-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__highlight-meta {
    min-width: 0;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__highlight-label,
  .editorial-landing--{{ section.id }} .editorial-landing__highlight-price {
    margin: 0;
    font-size: 0.68rem;
    opacity: 0.84;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__highlight-title {
    margin: 3px 0;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__tiles {
    display: grid;
    gap: clamp(10px, 1.6vw, 16px);
    grid-template-columns: 1fr;
  }

  @media (min-width: 990px) {
    .editorial-landing--{{ section.id }} .editorial-landing__tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(150px, auto);
    }

    .editorial-landing--{{ section.id }} .editorial-landing__tile:first-child {
      grid-column: 1 / -1;
      min-height: 220px;
    }
  }

  .editorial-landing--{{ section.id }} .editorial-landing__tile {
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: #ffffff;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.07);
    display: grid;
    min-height: 150px;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__tile-media {
    max-height: 170px;
    overflow: hidden;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__tile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__tile-content {
    padding: 12px;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__tile-title {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__tile-text {
    margin: 6px 0 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .editorial-landing--{{ section.id }} .editorial-landing__tile-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
  }

  .editorial-landing--{{ section.id }} .editorial-landing__hairline {
    margin-top: clamp(14px, 2.2vw, 24px);
    height: 1px;
    background: rgba(0, 0, 0, 0.08);
  }

  @media (max-width: 767px) {
    .editorial-landing--{{ section.id }} .editorial-landing__hero-image--mobile {
      display: block;
    }

    .editorial-landing--{{ section.id }} .editorial-landing__hero-image--desktop {
      display: none;
    }

    .editorial-landing--{{ section.id }} .editorial-landing__hero {
      min-height: 420px;
    }

    .editorial-landing--{{ section.id }} .editorial-landing__actions .btn {
      min-height: 42px;
    }
  }
</style>

{% schema %}
{
  "name": "Editorial Landing",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "default": "image",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "select",
      "id": "overlay_position",
      "label": "Overlay text position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Editorial Chapter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FlyFlow Feature Grid"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Structured, elevated merchandising with conversion-focused pathways and premium visual rhythm."
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary CTA",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary CTA",
      "default": "Explore Story"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary CTA link"
    },
    {
      "type": "checkbox",
      "id": "show_product_highlight",
      "label": "Show product highlight",
      "default": true
    },
    {
      "type": "product",
      "id": "highlight_product",
      "label": "Highlighted product"
    },
    {
      "type": "checkbox",
      "id": "show_hairline_divider",
      "label": "Show hairline divider",
      "default": true
    },
    {
      "type": "select",
      "id": "section_density",
      "label": "Section density",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "Section spacing",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_divider_top",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "contained",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Enable reveal",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Editorial Tile"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Supportive merchandising copy for this tile."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "View"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Editorial Landing",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Asymmetric Story Tile",
            "text": "Dominant chapter visual with clean merchandising pathways.",
            "link_label": "Explore"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Drop Focus",
            "text": "Highlight capsule releases and limited quantities.",
            "link_label": "Shop Drop"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Material Story",
            "text": "Showcase fit, fabrication, and performance details.",
            "link_label": "Read More"
          }
        }
      ]
    }
  ]
}
{% endschema %}
