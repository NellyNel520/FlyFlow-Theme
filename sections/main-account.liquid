{% comment %}
  FlyFlow Theme - Customer Account Section
  Purpose: Customer dashboard with order history.
  Last modified: 2026-02-17
{% endcomment %}

<section class="section" data-section-id="{{ section.id }}">
  <div class="container" style="max-width:960px">
    <div class="flex flex--between mb-xl">
      <h1>{{ 'customer.account.title' | t }}</h1>
      <a href="/account/logout" class="btn btn--secondary btn--sm">{{ 'customer.account.logout' | t }}</a>
    </div>

    <h2 class="mb-md" style="font-size:1.25rem">{{ 'customer.account.orders' | t }}</h2>

    {% if customer.orders.size > 0 %}
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:0.875rem">
          <thead>
            <tr style="border-bottom:2px solid var(--color-border);text-align:left">
              <th style="padding:var(--space-sm)">Order</th>
              <th style="padding:var(--space-sm)">Date</th>
              <th style="padding:var(--space-sm)">Status</th>
              <th style="padding:var(--space-sm);text-align:right">Total</th>
            </tr>
          </thead>
          <tbody>
            {% for order in customer.orders %}
              <tr style="border-bottom:1px solid var(--color-border)">
                <td style="padding:var(--space-sm)"><a href="{{ order.customer_url }}" class="text-accent" style="text-decoration:underline">{{ order.name }}</a></td>
                <td style="padding:var(--space-sm)">{{ order.created_at | date: '%B %d, %Y' }}</td>
                <td style="padding:var(--space-sm)">{{ order.fulfillment_status_label }}</td>
                <td style="padding:var(--space-sm);text-align:right">{{ order.total_price | money }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p class="text-secondary">You haven't placed any orders yet.</p>
      <a href="/collections/all" class="btn btn--primary mt-md">Start Shopping</a>
    {% endif %}

    <div class="mt-2xl" style="padding-top:var(--space-xl);border-top:1px solid var(--color-border)">
      <div class="flex flex--between mb-md">
        <h2 style="font-size:1.25rem">{{ 'customer.account.addresses' | t }}</h2>
        <a href="/account/addresses" class="btn btn--secondary btn--sm">Manage Addresses</a>
      </div>
      {% if customer.default_address %}
        <div class="text-sm text-secondary">
          <p>{{ customer.default_address.name }}</p>
          <p>{{ customer.default_address | format_address }}</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Account",
  "settings": []
}
{% endschema %}
