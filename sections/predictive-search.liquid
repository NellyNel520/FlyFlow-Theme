{% comment %}
  FlyFlow Theme - Predictive Search Overlay Section
  Purpose: Full-screen search overlay with predictive results,
           trending searches, and product thumbnails.
  Dependencies: theme.js (Search module)
  Last modified: 2026-02-17
{% endcomment %}

<div
  class="search-overlay"
  data-search-overlay
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'search.title' | t }}"
  aria-hidden="true"
>
  <button class="search-overlay__backdrop" type="button" data-search-close aria-label="{{ 'general.close' | t }}"></button>
  <div class="search-overlay__panel" data-predictive-search>
    {%- comment -%} Search header {%- endcomment -%}
    <div class="search-overlay__header">
      <div class="container search-overlay__header-inner">
        <p class="search-overlay__kicker">Search FlyFlow</p>
        <div class="predictive-search" data-predictive-search>
          <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay__form">
            <div class="predictive-search__input-wrapper search-overlay__input-wrap">
              <svg class="search-overlay__icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            <input
              type="search"
              name="q"
              class="predictive-search__input"
              placeholder="{{ 'search.placeholder' | t }}"
              data-predictive-search-input
              autocomplete="off"
              autofocus
              aria-label="{{ 'search.placeholder' | t }}"
            >
            </div>
            <button
              type="button"
              data-search-close
              aria-label="{{ 'general.close' | t }}"
              class="search-overlay__close"
            >
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>

    <div class="search-overlay__body container">
      <div class="search-overlay__results-column">
        <div class="predictive-search__results" data-predictive-search-results data-no-results-text="{{ 'general.no_results' | t }}"></div>
      </div>

      {%- comment -%} Trending searches (shown when input is empty) {%- endcomment -%}
      <aside class="search-overlay__discover" data-search-trending>
        <p class="predictive-search__trending-title">{{ 'search.trending' | t }}</p>
        <div class="predictive-search__trending-tags">
          {% for block in section.blocks %}
            {% if block.type == 'trending' %}
              <a href="{{ routes.search_url }}?q={{ block.settings.term | url_encode }}" class="predictive-search__trending-tag" {{ block.shopify_attributes }}>
                {{ block.settings.term }}
              </a>
            {% endif %}
          {% endfor %}
        </div>

        {%- comment -%} Popular collections {%- endcomment -%}
        {% if section.settings.show_popular_collections %}
          <div class="search-overlay__collections">
            <p class="predictive-search__trending-title">Popular Collections</p>
            <div class="search-overlay__collections-grid">
              {% for collection in collections limit: 6 %}
                {% unless collection.handle == 'all' %}
                  <a href="{{ collection.url }}" class="search-overlay__collection-card">
                    <div class="search-overlay__collection-media">
                      {% if collection.image %}
                        {{ collection.image | image_url: width: 480 | image_tag: alt: collection.title, loading: 'lazy', widths: '240,360,480', sizes: '(min-width: 990px) 120px, 30vw' }}
                      {% endif %}
                    </div>
                    <span class="search-overlay__collection-title">{{ collection.title }}</span>
                  </a>
                {% endunless %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </aside>
    </div>
  </div>
</div>

<script>
  (function() {
    var overlay = document.querySelector('[data-search-overlay]');
    if (!overlay) return;
    var searchInput = overlay.querySelector('[data-predictive-search-input]');
    var results = overlay.querySelector('[data-predictive-search-results]');
    var trending = overlay.querySelector('[data-search-trending]');

    function openOverlay() {
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.classList.add('drawer-open');
      if (searchInput) setTimeout(function() { searchInput.focus(); }, 100);
    }

    function closeOverlay() {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('drawer-open');
      if (searchInput && searchInput.value.trim().length === 0 && trending) {
        trending.style.display = '';
      }
      if (results && searchInput && searchInput.value.trim().length === 0) {
        results.classList.remove('predictive-search__results--open');
      }
    }

    /* Open search overlay */
    document.addEventListener('click', function(e) {
      var openBtn = e.target.closest('[data-search-open]');
      if (openBtn) {
        e.preventDefault();
        openOverlay();
      }

      var closeBtn = e.target.closest('[data-search-close]');
      if (closeBtn) {
        e.preventDefault();
        closeOverlay();
        return;
      }

      if (overlay.classList.contains('is-open')) {
        var clickedInsideSearch = e.target.closest('[data-predictive-search]');
        var clickedOpenTrigger = e.target.closest('[data-search-open]');
        if (!clickedInsideSearch && !clickedOpenTrigger) {
          closeOverlay();
        }
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
        closeOverlay();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Predictive Search",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_popular_collections",
      "label": "Show popular collections",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "trending",
      "name": "Trending Search",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "term",
          "label": "Search term",
          "default": "Designer Sneakers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Predictive Search"
    }
  ]
}
{% endschema %}
