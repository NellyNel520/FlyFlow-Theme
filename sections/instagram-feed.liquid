<section class="instagram-feed section" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="instagram-feed__header">
      {% if section.settings.overline != blank %}
        <p class="section-overline">{{ section.settings.overline }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="instagram-feed__text">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    {% assign desktop_columns = section.settings.columns_desktop %}
    <div class="instagram-feed__grid instagram-feed__grid--{{ desktop_columns }}">
      {% for block in section.blocks %}
        <a
          class="instagram-feed__card"
          href="{{ block.settings.link | default: section.settings.profile_url | default: '#' }}"
          {% if block.settings.link != blank or section.settings.profile_url != blank %}
            target="_blank" rel="noopener noreferrer"
          {% endif %}
          aria-label="{% if block.settings.caption != blank %}{{ block.settings.caption | escape }}{% else %}Open Instagram post{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="instagram-feed__media">
            {% if block.settings.image %}
              {{
                block.settings.image
                | image_url: width: 960
                | image_tag: loading: 'lazy', widths: '300, 480, 720, 960', class: 'instagram-feed__image', alt: block.settings.caption
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'instagram-feed__placeholder' }}
            {% endif %}
          </div>
          {% if block.settings.caption != blank %}
            <p class="instagram-feed__caption">{{ block.settings.caption }}</p>
          {% endif %}
        </a>
      {% else %}
        {% for i in (1..4) %}
          <div class="instagram-feed__card">
            <div class="instagram-feed__media">
              {{ 'image' | placeholder_svg_tag: 'instagram-feed__placeholder' }}
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>

    {% if section.settings.profile_url != blank %}
      <div class="instagram-feed__actions">
        <a class="btn btn--secondary" href="{{ section.settings.profile_url }}" target="_blank" rel="noopener noreferrer">
          Follow on Instagram
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Instagram feed",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Social"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow the FlyFlow Edit"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Showcase product styling moments from Instagram. Add post images below and link each one to your live post."
    },
    {
      "type": "url",
      "id": "profile_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post URL"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Instagram feed",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
