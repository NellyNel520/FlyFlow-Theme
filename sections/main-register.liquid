{% comment %}
  FlyFlow Theme - Customer Register Section
  Purpose: Account registration form.
  Last modified: 2026-02-17
{% endcomment %}

<section class="section" data-section-id="{{ section.id }}">
  <div class="container" style="max-width:480px">
    <h1 class="text-center mb-xl">{{ 'customer.register.title' | t }}</h1>

    {% form 'create_customer' %}
      {% if form.errors %}
        <div class="form__error mb-md" style="padding:var(--space-sm);background:var(--color-surface);border:1px solid var(--color-error);border-radius:var(--border-radius)">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-md)">
        <div class="form__group">
          <label class="form__label" for="reg-first">{{ 'customer.register.first_name' | t }}</label>
          <input type="text" id="reg-first" name="customer[first_name]" class="form__input" autocomplete="given-name" required>
        </div>
        <div class="form__group">
          <label class="form__label" for="reg-last">{{ 'customer.register.last_name' | t }}</label>
          <input type="text" id="reg-last" name="customer[last_name]" class="form__input" autocomplete="family-name" required>
        </div>
      </div>

      <div class="form__group">
        <label class="form__label" for="reg-email">{{ 'customer.register.email' | t }}</label>
        <input type="email" id="reg-email" name="customer[email]" class="form__input" autocomplete="email" required>
      </div>

      <div class="form__group">
        <label class="form__label" for="reg-password">{{ 'customer.register.password' | t }}</label>
        <input type="password" id="reg-password" name="customer[password]" class="form__input" autocomplete="new-password" required>
      </div>

      <button type="submit" class="btn btn--primary btn--full btn--lg mb-md">
        {{ 'customer.register.submit' | t }}
      </button>

      <p class="text-center text-sm text-secondary">
        Already have an account? <a href="/account/login" class="text-accent" style="text-decoration:underline">{{ 'customer.login.sign_in' | t }}</a>
      </p>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Customer Register",
  "settings": []
}
{% endschema %}
