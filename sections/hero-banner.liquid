{% comment %}
  FlyFlow Theme - Hero Banner
  Purpose: Full-bleed hero media with left-aligned overlay content.
  Last modified: 2026-02-19
{% endcomment %}

{% liquid
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
%}

<section
  class="hero-banner hero-banner--{{ section.id }} chapter-section chapter-section--spacing-{{ section.settings.section_density | default: section.settings.section_spacing | default: 'standard' }} chapter-section--container-{{ section.settings.container_width | default: 'full' }}{% if section.settings.show_divider_top %} chapter-section--divider-top{% endif %}{% if section.settings.enable_reveal %} chapter-section--reveal{% endif %}"
  data-section-id="{{ section.id }}"
  data-enable-reveal="{{ section.settings.enable_reveal }}"
>
  <div class="hero-banner__frame hero-banner__frame--{{ section.settings.hero_height }} hero-banner__v-{{ section.settings.content_alignment_vertical }}">
    <div class="hero-banner__media" aria-hidden="true">
      {% if section.settings.media_type == 'video' and section.settings.video != blank %}
        {{
          section.settings.video
          | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '2400x'
        }}
      {% elsif section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'hero-banner__image hero-banner__image--desktop',
            loading: 'eager',
            widths: '900,1200,1600,2000,2400',
            sizes: '100vw',
            alt: section.settings.heading
        }}
        {% if section.settings.mobile_image != blank %}
          {{
            section.settings.mobile_image
            | image_url: width: 1400
            | image_tag:
              class: 'hero-banner__image hero-banner__image--mobile',
              loading: 'lazy',
              widths: '420,640,900,1200,1400',
              sizes: '100vw',
              alt: section.settings.heading
          }}
        {% endif %}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-banner__image hero-banner__placeholder' }}
      {% endif %}
    </div>

    {% if section.settings.overlay_gradient != 'none' and section.settings.overlay_opacity > 0 %}
      <div class="hero-banner__overlay hero-banner__overlay--{{ section.settings.overlay_gradient }}" style="--hero-overlay-alpha: {{ overlay_alpha }}"></div>
    {% endif %}

    {% if section.settings.show_drop_label and section.settings.drop_label_text != blank %}
      <span class="hero-banner__drop-label">{{ section.settings.drop_label_text }}</span>
    {% endif %}

    <div class="container hero-banner__content-wrap">
      <div class="hero-banner__content" style="--hero-content-max: {{ section.settings.content_max_width }}px;" data-hero-reveal>
        {% if section.settings.eyebrow != blank %}
          <p class="hero-banner__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p class="hero-banner__subheading">{{ section.settings.subheading }}</p>
        {% endif %}

        <div class="hero-banner__actions">
          {% if section.settings.primary_cta_label != blank and section.settings.primary_cta_link != blank %}
            <a href="{{ section.settings.primary_cta_link }}" class="btn btn--primary">{{ section.settings.primary_cta_label }}</a>
          {% endif %}
          {% if section.settings.secondary_cta_label != blank and section.settings.secondary_cta_link != blank %}
            <a href="{{ section.settings.secondary_cta_link }}" class="btn btn--ghost">{{ section.settings.secondary_cta_label }}</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% if section.settings.show_hairline_divider %}
    <div class="hero-banner__hairline" aria-hidden="true"></div>
  {% endif %}
</section>

<style>
  .hero-banner--{{ section.id }} .hero-banner__frame {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: 72vh;
  }

  .hero-banner--{{ section.id }} .hero-banner__frame--small {
    min-height: 62vh;
  }

  .hero-banner--{{ section.id }} .hero-banner__frame--medium {
    min-height: 72vh;
  }

  .hero-banner--{{ section.id }} .hero-banner__frame--large {
    min-height: 84vh;
  }

  .hero-banner--{{ section.id }} .hero-banner__media,
  .hero-banner--{{ section.id }} .hero-banner__overlay {
    position: absolute;
    inset: 0;
  }

  .hero-banner--{{ section.id }} .hero-banner__media {
    z-index: -2;
  }

  .hero-banner--{{ section.id }} .hero-banner__media video,
  .hero-banner--{{ section.id }} .hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-banner--{{ section.id }} .hero-banner__image--mobile {
    display: none;
  }

  .hero-banner--{{ section.id }} .hero-banner__overlay {
    z-index: -1;
    pointer-events: none;
  }

  .hero-banner--{{ section.id }} .hero-banner__overlay--bottom {
    background: linear-gradient(180deg, rgba(10, 10, 12, 0) 10%, rgba(10, 10, 12, var(--hero-overlay-alpha)) 100%);
  }

  .hero-banner--{{ section.id }} .hero-banner__overlay--left {
    background: linear-gradient(90deg, rgba(10, 10, 12, var(--hero-overlay-alpha)) 0%, rgba(10, 10, 12, 0.08) 58%, rgba(10, 10, 12, 0) 100%);
  }

  .hero-banner--{{ section.id }} .hero-banner__drop-label {
    position: absolute;
    left: var(--space-lg);
    top: var(--space-lg);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.34);
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-banner--{{ section.id }} .hero-banner__content-wrap {
    position: relative;
    z-index: 1;
    height: 100%;
    min-height: inherit;
    display: grid;
    justify-items: start;
    padding-block: clamp(24px, 5vh, 54px);
  }

  .hero-banner--{{ section.id }} .hero-banner__v-center .hero-banner__content-wrap {
    align-items: center;
  }

  .hero-banner--{{ section.id }} .hero-banner__v-top .hero-banner__content-wrap {
    align-items: start;
  }

  .hero-banner--{{ section.id }} .hero-banner__content {
    max-width: min(var(--hero-content-max), 94vw);
    color: #ffffff;
    text-align: left;
  }

  .hero-banner--{{ section.id }} .hero-banner__eyebrow {
    margin: 0 0 8px;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.86;
  }

  .hero-banner--{{ section.id }} .hero-banner__heading {
    margin: 0;
    font-size: clamp(2rem, 4.2vw, 4.2rem);
    line-height: 1.03;
    text-wrap: balance;
  }

  .hero-banner--{{ section.id }} .hero-banner__subheading {
    margin: 10px 0 0;
    font-size: clamp(0.95rem, 1.25vw, 1.08rem);
    line-height: 1.45;
    max-width: 58ch;
    text-wrap: pretty;
    opacity: 0.95;
  }

  .hero-banner--{{ section.id }} .hero-banner__actions {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-start;
  }

  .hero-banner--{{ section.id }} .hero-banner__hairline {
    height: 1px;
    background: rgba(0, 0, 0, 0.12);
  }

  .hero-banner--{{ section.id }} [data-hero-reveal] {
    opacity: 1;
    transform: none;
  }

  .hero-banner--{{ section.id }}.is-pending-reveal [data-hero-reveal] {
    opacity: 0;
    transform: translateY(14px);
  }

  .hero-banner--{{ section.id }}.is-revealed [data-hero-reveal] {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  @media (max-width: 767px) {
    .hero-banner--{{ section.id }} .hero-banner__frame--small {
      min-height: 54vh;
    }

    .hero-banner--{{ section.id }} .hero-banner__frame--medium {
      min-height: 62vh;
    }

    .hero-banner--{{ section.id }} .hero-banner__frame--large {
      min-height: 72vh;
    }

    .hero-banner--{{ section.id }} .hero-banner__image--desktop {
      display: none;
    }

    .hero-banner--{{ section.id }} .hero-banner__image--mobile {
      display: block;
    }

    .hero-banner--{{ section.id }} .hero-banner__drop-label {
      left: var(--space-md);
      top: var(--space-md);
    }

    .hero-banner--{{ section.id }} .hero-banner__content-wrap {
      padding-inline: var(--space-md);
    }

    .hero-banner--{{ section.id }} .hero-banner__actions .btn {
      min-height: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-banner--{{ section.id }} [data-hero-reveal] {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  (function() {
    var section = document.querySelector('.hero-banner--{{ section.id }}');
    if (!section) return;

    if (section.dataset.enableReveal !== 'true' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    section.classList.add('is-pending-reveal');

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          section.classList.add('is-revealed');
          observer.disconnect();
        }
      });
    }, { threshold: 0.22 });

    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "default": "image",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "select",
      "id": "hero_height",
      "label": "Hero height",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "overlay_gradient",
      "label": "Overlay gradient",
      "default": "left",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment_vertical",
      "label": "Content vertical alignment",
      "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 480,
      "max": 720,
      "step": 20,
      "default": 600,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FlyFlow Droproom"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built For Streets, Cut For Impact"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Limited chapter drops designed for elevated daily rotation."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary CTA label",
      "default": "Shop Drop"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary CTA label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA link"
    },
    {
      "type": "checkbox",
      "id": "show_drop_label",
      "label": "Show drop label",
      "default": true
    },
    {
      "type": "text",
      "id": "drop_label_text",
      "label": "Drop label text",
      "default": "DROP 01"
    },
    {
      "type": "checkbox",
      "id": "show_hairline_divider",
      "label": "Show hairline divider",
      "default": true
    },
    {
      "type": "select",
      "id": "section_density",
      "label": "Section density",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "Section spacing",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_divider_top",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "full",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Enable reveal",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
