{% comment %}
  FlyFlow Theme - Hero Banner Section
  Purpose: Full-width immersive hero with editorial typography, background image, and CTA.
  Dependencies: theme.css
  Last modified: 2026-02-17
{% endcomment %}

<section class="hero-banner section" data-section-id="{{ section.id }}" style="padding:0">
  <div class="hero-banner__inner" style="
    {% if section.settings.image %}
      background-image: url('{{ section.settings.image | image_url: width: 1920 }}');
    {% endif %}
    background-size: cover;
    background-position: {{ section.settings.image_position }};
    min-height: {{ section.settings.height }}vh;
  ">
    {%- comment -%} Overlay {%- endcomment -%}
    <div style="
      position: absolute; inset: 0;
      background: linear-gradient(to bottom, rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 | times: 0.6 }}), rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}));
    "></div>

    <div class="hero-banner__content">
      {% if section.settings.overline != blank %}
        <p class="hero-banner__overline">{{ section.settings.overline }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="hero-banner__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="btn btn--ghost btn--lg">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Recommended: 1920x1080px or larger. High-fashion editorial imagery works best."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Banner height",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 90,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay intensity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 35,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline text",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your Style"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover curated fashion, designer footwear, and statement accessories crafted for those who move with intention."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
