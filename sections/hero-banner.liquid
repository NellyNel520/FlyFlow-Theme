{% assign media_mode = section.settings.media_mode %}
{% assign has_carousel = false %}
{% if media_mode == 'carousel' and section.blocks.size > 0 %}
  {% assign has_carousel = true %}
{% endif %}
{% assign has_video = false %}
{% if media_mode == 'video' and section.settings.video != blank %}
  {% assign has_video = true %}
{% endif %}
{% assign enable_parallax = section.settings.enable_parallax %}

<section
  class="hero-banner hero-banner--{{ section.id }} section chapter-section chapter-section--spacing-{{ section.settings.section_spacing | default: 'standard' }} chapter-section--container-{{ section.settings.container_width | default: 'full' }}{% if section.settings.show_divider_top %} chapter-section--divider-top{% endif %}{% if section.settings.enable_reveal %} chapter-section--reveal{% endif %}"
  data-section-id="{{ section.id }}"
  data-enable-reveal="{{ section.settings.enable_reveal }}"
  style="padding:0"
>
  <div class="hero-banner__inner" style="min-height: {{ section.settings.height }}vh;">
    <div class="hero-banner__media-stack{% if enable_parallax %} hero-banner__media-stack--parallax{% endif %}" {% if enable_parallax %}data-hero-parallax{% endif %}>
      {% if has_carousel %}
        <div
          class="hero-banner__carousel"
          data-hero-carousel
          data-carousel-autoplay="{{ section.settings.carousel_autoplay }}"
          data-carousel-interval="{{ section.settings.carousel_interval | times: 1000 }}"
        >
          {% for block in section.blocks %}
            <div class="hero-banner__slide{% if forloop.first %} is-active{% endif %}" data-hero-slide {{ block.shopify_attributes }}>
              <div
                class="hero-banner__media hero-banner__media--image{% if enable_parallax %} hero-banner__parallax-target{% endif %}"
                {% if enable_parallax %}data-hero-parallax-target{% endif %}
                {% if block.settings.image %}
                  style="background-image: url('{{ block.settings.image | image_url: width: 2400 }}'); background-position: {{ block.settings.image_position }};"
                {% else %}
                  style="background: linear-gradient(145deg, #1a1a1a, #0f0f0f);"
                {% endif %}
              ></div>
            </div>
          {% endfor %}
          <button class="hero-banner__carousel-btn hero-banner__carousel-btn--prev" type="button" data-hero-carousel-prev aria-label="Previous slide">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button class="hero-banner__carousel-btn hero-banner__carousel-btn--next" type="button" data-hero-carousel-next aria-label="Next slide">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <div class="hero-banner__dots">
            {% for block in section.blocks %}
              <button
                class="hero-banner__dot{% if forloop.first %} is-active{% endif %}"
                type="button"
                data-hero-carousel-dot="{{ forloop.index0 }}"
                aria-label="Go to slide {{ forloop.index }}"
              ></button>
            {% endfor %}
          </div>
        </div>
      {% elsif has_video %}
        <div class="hero-banner__media hero-banner__media--video{% if enable_parallax %} hero-banner__parallax-target{% endif %}" {% if enable_parallax %}data-hero-parallax-target{% endif %}>
          {{
            section.settings.video
            | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '2400x'
          }}
        </div>
      {% else %}
        <div
          class="hero-banner__media hero-banner__media--image{% if enable_parallax %} hero-banner__parallax-target{% endif %}"
          {% if enable_parallax %}data-hero-parallax-target{% endif %}
          {% if section.settings.image %}
            style="background-image: url('{{ section.settings.image | image_url: width: 2400 }}'); background-position: {{ section.settings.image_position }};"
          {% else %}
            style="background: linear-gradient(145deg, #1a1a1a, #0f0f0f);"
          {% endif %}
        ></div>
      {% endif %}
    </div>

    <div
      class="hero-banner__overlay"
      style="background: linear-gradient(to bottom, rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 | times: 0.6 }}), rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}));"
    ></div>

    <div class="hero-banner__content">
      {% if section.settings.overline != blank %}
        <p class="hero-banner__overline">{{ section.settings.overline }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="hero-banner__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="btn btn--ghost btn--lg">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .hero-banner--{{ section.id }} .hero-banner__inner {
    position: relative;
    overflow: hidden;
  }

  .hero-banner--{{ section.id }} .hero-banner__inner::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 82% 18%, rgba(200, 169, 126, 0.28), transparent 36%),
      radial-gradient(circle at 12% 78%, rgba(255, 255, 255, 0.09), transparent 28%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-banner--{{ section.id }} .hero-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-banner--{{ section.id }} .hero-banner__content {
    position: relative;
    z-index: 2;
    max-width: 42rem;
    margin: clamp(3rem, 8vh, 6rem) auto;
    padding: clamp(1.25rem, 2.8vw, 2.5rem);
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: linear-gradient(145deg, rgba(16, 16, 16, 0.46), rgba(16, 16, 16, 0.2));
    backdrop-filter: blur(3px);
  }

  .hero-banner--{{ section.id }} .hero-banner__overline {
    animation: hero-rise-{{ section.id }} 460ms ease both;
  }

  .hero-banner--{{ section.id }} .hero-banner__heading {
    animation: hero-rise-{{ section.id }} 560ms ease 90ms both;
  }

  .hero-banner--{{ section.id }} .hero-banner__subheading {
    animation: hero-rise-{{ section.id }} 620ms ease 150ms both;
  }

  .hero-banner--{{ section.id }} .hero-banner__content .btn {
    animation: hero-rise-{{ section.id }} 680ms ease 220ms both;
  }

  @keyframes hero-rise-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    .hero-banner--{{ section.id }} .hero-banner__content {
      margin: clamp(2rem, 7vh, 4rem) var(--space-md);
      max-width: none;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "select",
      "id": "media_mode",
      "label": "Hero media mode",
      "options": [
        { "value": "image", "label": "Single image" },
        { "value": "video", "label": "Background video" },
        { "value": "carousel", "label": "Image carousel" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Recommended: 1920x1080px or larger. High-fashion editorial imagery works best."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Used when Hero media mode is set to Background video."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Banner height",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 90,
      "unit": "vh"
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "Enable subtle parallax motion",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "Autoplay carousel",
      "default": true
    },
    {
      "type": "range",
      "id": "carousel_interval",
      "label": "Carousel speed",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay intensity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 35,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline text",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your Style"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover curated fashion, designer footwear, and statement accessories crafted for those who move with intention."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "Section spacing",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_divider_top",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "full",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Enable reveal",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Carousel slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Slide focal point",
          "options": [
            { "value": "center top", "label": "Top" },
            { "value": "center center", "label": "Center" },
            { "value": "center bottom", "label": "Bottom" }
          ],
          "default": "center center"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
