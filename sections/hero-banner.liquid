{% comment %}
  FlyFlow Theme - Hero Banner Section
  Purpose: Full-width immersive hero with editorial typography, background image, and CTA.
  Dependencies: theme.css
  Last modified: 2026-02-17
{% endcomment %}

<section class="hero-banner hero-banner--{{ section.id }} section" data-section-id="{{ section.id }}" style="padding:0">
  <div class="hero-banner__inner" style="
    {% if section.settings.image %}
      background-image: url('{{ section.settings.image | image_url: width: 1920 }}');
    {% endif %}
    background-size: cover;
    background-position: {{ section.settings.image_position }};
    min-height: {{ section.settings.height }}vh;
  ">
    {%- comment -%} Overlay {%- endcomment -%}
    <div style="
      position: absolute; inset: 0;
      background: linear-gradient(to bottom, rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 | times: 0.6 }}), rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}));
    "></div>

    <div class="hero-banner__content">
      {% if section.settings.overline != blank %}
        <p class="hero-banner__overline">{{ section.settings.overline }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="hero-banner__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="btn btn--ghost btn--lg">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .hero-banner--{{ section.id }} .hero-banner__inner {
    position: relative;
    overflow: hidden;
  }

  .hero-banner--{{ section.id }} .hero-banner__inner::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 82% 18%, rgba(200, 169, 126, 0.28), transparent 36%),
      radial-gradient(circle at 12% 78%, rgba(255, 255, 255, 0.09), transparent 28%);
    pointer-events: none;
  }

  .hero-banner--{{ section.id }} .hero-banner__content {
    position: relative;
    z-index: 2;
    max-width: 42rem;
    margin: clamp(3rem, 8vh, 6rem) auto;
    padding: clamp(1.25rem, 2.8vw, 2.5rem);
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: linear-gradient(145deg, rgba(16, 16, 16, 0.46), rgba(16, 16, 16, 0.2));
    backdrop-filter: blur(3px);
  }

  .hero-banner--{{ section.id }} .hero-banner__overline {
    animation: hero-rise-{{ section.id }} 460ms ease both;
  }

  .hero-banner--{{ section.id }} .hero-banner__heading {
    animation: hero-rise-{{ section.id }} 560ms ease 90ms both;
  }

  .hero-banner--{{ section.id }} .hero-banner__subheading {
    animation: hero-rise-{{ section.id }} 620ms ease 150ms both;
  }

  .hero-banner--{{ section.id }} .hero-banner__content .btn {
    animation: hero-rise-{{ section.id }} 680ms ease 220ms both;
  }

  @keyframes hero-rise-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    .hero-banner--{{ section.id }} .hero-banner__content {
      margin: clamp(2rem, 7vh, 4rem) var(--space-md);
      max-width: none;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Recommended: 1920x1080px or larger. High-fashion editorial imagery works best."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Banner height",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 90,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay intensity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 35,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline text",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your Style"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover curated fashion, designer footwear, and statement accessories crafted for those who move with intention."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
