{% comment %}
  FlyFlow Theme - Newsletter Section
  Purpose: Email signup section with Shopify customer form.
  Dependencies: None
  Last modified: 2026-02-17
{% endcomment %}

<section
  class="section chapter-section chapter-section--spacing-{{ section.settings.section_density | default: section.settings.section_spacing | default: 'standard' }} chapter-section--container-{{ section.settings.container_width | default: 'contained' }}{% if section.settings.show_divider_top %} chapter-section--divider-top{% endif %}{% if section.settings.enable_reveal %} chapter-section--reveal{% endif %}"
  data-section-id="{{ section.id }}"
  data-enable-reveal="{{ section.settings.enable_reveal }}"
  style="background-color:var(--color-surface)"
>
  <div class="container newsletter-section text-center" style="max-width:720px">
    {% if section.settings.heading != blank %}
      <h2 class="newsletter-section__heading mb-sm">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="newsletter-section__subheading text-secondary text-sm mb-lg">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="newsletter-section__panel">
      {% form 'customer', class: 'newsletter-section__form', style: 'max-width:560px;margin-inline:auto' %}
        {% if form.posted_successfully? %}
          <p class="newsletter-section__message newsletter-section__message--success">{{ 'newsletter.success' | t }}</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-section__fields">
            <input
              type="email"
              name="contact[email]"
              class="newsletter-section__input"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              required
              autocomplete="email"
              aria-label="{{ 'newsletter.placeholder' | t }}"
            >
            <button type="submit" class="newsletter-section__button">
              {{ 'newsletter.submit' | t }}
            </button>
          </div>
          {% if form.errors %}
            <p class="newsletter-section__message newsletter-section__message--error">{{ form.errors.messages['email'] }}</p>
          {% endif %}
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the FlyFlow Circle"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Early access to new drops, exclusive collaborations, and curated style inspiration — delivered to your inbox."
    },
    {
      "type": "select",
      "id": "section_density",
      "label": "Section density",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "Section spacing",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_divider_top",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "contained",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Enable reveal",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
