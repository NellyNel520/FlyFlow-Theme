{% comment %}
  FlyFlow Theme - Password Reset Section
  Last modified: 2026-02-17
{% endcomment %}

<section class="section">
  <div class="container" style="max-width:480px">
    <h1 class="text-center mb-xl">Reset Your Password</h1>
    {% form 'reset_customer_password' %}
      <div class="form__group"><label class="form__label" for="reset-pw">New password</label><input type="password" id="reset-pw" name="customer[password]" class="form__input" required></div>
      <div class="form__group"><label class="form__label" for="reset-pw2">Confirm password</label><input type="password" id="reset-pw2" name="customer[password_confirmation]" class="form__input" required></div>
      <button type="submit" class="btn btn--primary btn--full btn--lg">Reset Password</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Reset Password",
  "settings": []
}
{% endschema %}
