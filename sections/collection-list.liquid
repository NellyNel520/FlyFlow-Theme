{% comment %}
  FlyFlow Theme - Collection List Section
  Purpose: Showcase featured collections in a visual grid with editorial imagery.
  Dependencies: theme.css
  Last modified: 2026-02-17
{% endcomment %}

<section
  class="section collection-list collection-list--{{ section.id }} chapter-section chapter-section--spacing-{{ section.settings.section_spacing | default: 'standard' }} chapter-section--container-{{ section.settings.container_width | default: 'contained' }}{% if section.settings.show_divider_top %} chapter-section--divider-top{% endif %}{% if section.settings.enable_reveal %} chapter-section--reveal{% endif %}"
  data-section-id="{{ section.id }}"
  data-enable-reveal="{{ section.settings.enable_reveal }}"
>
  <div class="container">
    {% if section.settings.heading != blank %}
      <div class="text-center" style="margin-bottom:var(--space-2xl)">
        {% if section.settings.overline != blank %}
          <p class="overline" style="margin-bottom:var(--space-sm)">{{ section.settings.overline }}</p>
        {% endif %}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div style="
      display: grid;
      grid-template-columns: repeat({{ section.blocks.size | at_most: 3 }}, 1fr);
      gap: var(--space-sm);
    ">
      {% for block in section.blocks %}
        {% if block.type == 'collection_card' %}
          <a
            href="{{ block.settings.collection.url | default: '#' }}"
            class="collection-list__card"
            style="
              position: relative;
              display: block;
              overflow: hidden;
              aspect-ratio: {{ section.settings.aspect_ratio }};
            "
            {{ block.shopify_attributes }}
          >
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 800 | image_tag:
                alt: block.settings.collection.title | default: block.settings.title,
                loading: 'lazy',
                widths: '375, 750',
                sizes: '(min-width: 768px) 33vw, 100vw',
                style: 'width:100%;height:100%;object-fit:cover;transition:transform 0.8s cubic-bezier(0.25,0.1,0.25,1)'
              }}
            {% elsif block.settings.collection.image %}
              {{ block.settings.collection.image | image_url: width: 800 | image_tag:
                alt: block.settings.collection.title,
                loading: 'lazy',
                style: 'width:100%;height:100%;object-fit:cover;transition:transform 0.8s cubic-bezier(0.25,0.1,0.25,1)'
              }}
            {% else %}
              <div style="width:100%;height:100%;background:var(--color-surface)"></div>
            {% endif %}

            <div style="
              position: absolute;
              inset: 0;
              background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 60%);
              display: flex;
              align-items: flex-end;
              padding: var(--space-xl);
            ">
              <div style="color:#fff">
                <h3 style="
                  font-size: clamp(1.125rem, 2vw, 1.5rem);
                  color: #fff;
                  margin-bottom: var(--space-xs);
                ">
                  {{ block.settings.title | default: block.settings.collection.title | default: 'Collection' }}
                </h3>
                <span style="
                  font-size: 0.625rem;
                  font-weight: 600;
                  text-transform: uppercase;
                  letter-spacing: 0.2em;
                  opacity: 0.8;
                ">
                  Shop Now
                </span>
              </div>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .collection-list--{{ section.id }} .collection-list__card {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    animation: list-rise-{{ section.id }} 480ms ease both;
  }

  .collection-list--{{ section.id }} .collection-list__card:nth-child(2) {
    animation-delay: 90ms;
  }

  .collection-list--{{ section.id }} .collection-list__card:nth-child(3) {
    animation-delay: 160ms;
  }

  .collection-list--{{ section.id }} .collection-list__card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
    box-shadow: 0 20px 32px rgba(0, 0, 0, 0.14);
  }

  .collection-list--{{ section.id }} .collection-list__card:hover img {
    transform: scale(1.06);
  }

  .collection-list--{{ section.id }} .collection-list__card > div:last-child {
    transition: background var(--transition-base);
  }

  .collection-list--{{ section.id }} .collection-list__card:hover > div:last-child {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.22) 64%);
  }

  @keyframes list-rise-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    .collection-list__card {
      aspect-ratio: 3 / 4 !important;
    }
    [data-section-id="{{ section.id }}"] > .container > div:last-child {
      grid-template-columns: 1fr !important;
      gap: var(--space-sm) !important;
    }
  }
</style>

{% schema %}
{
  "name": "Collection List",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline text",
      "default": "Curated For You"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Card aspect ratio",
      "options": [
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "Section spacing",
      "default": "standard",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "standard", "label": "Standard" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_divider_top",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "contained",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Enable reveal",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection",
      "limit": 6,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title (optional)",
          "info": "Overrides the collection title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (optional)",
          "info": "Overrides the collection image"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Collection List",
      "blocks": [
        {
          "type": "collection_card",
          "settings": { "title": "Sneakers" }
        },
        {
          "type": "collection_card",
          "settings": { "title": "Accessories" }
        },
        {
          "type": "collection_card",
          "settings": { "title": "Apparel" }
        }
      ]
    }
  ]
}
{% endschema %}
