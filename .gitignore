# FlyFlow Theme - Shopify Theme .gitignore
# Purpose: Prevent unnecessary/sensitive files from being tracked
# Last modified: 2026-02-17

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
*.min.js
*.min.css

# Environment & secrets
.env
.env.local
.env.*.local
config.yml
shopify.theme.toml

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# Shopify CLI
.shopify/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Package manager locks (keep one, ignore others)
# Using npm - keep package-lock.json
yarn.lock
pnpm-lock.yaml
