        "primary_cta_label": "Shop New Arrivals",
        "primary_cta_link": "/collections/new-arrivals",
        "secondary_cta_label": "Explore Collection",
        "secondary_cta_link": "/collections/all",
        "show_drop_label": true,
        "drop_label_text": "DROP 01",
        "show_hairline_divider": true,
        "section_density": "standard",
        "container_width": "full",
        "show_divider_top": false,
        "enable_reveal": true,
        "section_spacing": "standard"
      }
    },
    "editorial-landing": {
      "type": "editorial-landing",
      "blocks": {
        "point-1": {
          "type": "feature",
          "settings": {
            "title": "Premium Construction",
            "text": "Durable materials selected for comfort, movement, and longevity."
          }
        },
        "point-2": {
          "type": "feature",
          "settings": {
            "title": "Curated Drops",
            "text": "Limited releases and capsule edits designed to stand out."
          }
        },
        "point-3": {
          "type": "feature",
          "settings": {
            "title": "Fast Fulfillment",
            "text": "Quick dispatch and transparent shipping from checkout to doorstep."
          }
        }
      },
      "block_order": ["point-1", "point-2", "point-3"],
      "settings": {
        "overline": "Manifesto",
        "heading": "Built for movement. Styled for impact.",
        "text": "<p>FlyFlow blends utility and modern design so every look performs as hard as it looks. Curated drops, premium materials, and silhouettes engineered for everyday momentum.</p>",
        "primary_button_text": "Shop New Arrivals",
        "primary_button_link": "/collections/new-arrivals",
        "secondary_button_text": "Read Our Story",
        "secondary_button_link": "/pages/brand-story"
      }
    },
    "premium-product-carousel": {
      "type": "premium-product-carousel",
      "settings": {
        "source_mode": "collection",
        "collection": "best-sellers",
        "item_limit": 8,
        "cards_per_view_desktop": 3,
        "cards_per_view_tablet": 2,
        "cards_per_view_mobile": 1,
        "slide_step": 3,
        "show_price": true,
        "container_width": "full",
        "peek_next": true,
        "loop": false
      },
      "blocks": {},
      "block_order": []
    },
    "collection-list": {
      "type": "collection-list",
      "settings": {
        "overline": "Curated For You",
        "heading": "Shop by Category",
