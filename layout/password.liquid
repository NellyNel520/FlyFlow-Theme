{% comment %}
  FlyFlow Theme - Password Layout
  Purpose: Minimal layout for the store password page (no header/footer).
  Last modified: 2026-02-17
{% endcomment %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="ltr" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>

  {% style %}
    :root {
      --color-primary: {{ settings.color_primary }};
      --color-accent: {{ settings.color_accent }};
      --color-background: {{ settings.color_background }};
      --color-surface: {{ settings.color_surface }};
      --color-text: {{ settings.color_text }};
      --color-text-secondary: {{ settings.color_text_secondary }};
      --color-border: {{ settings.color_border }};
      --color-sale: {{ settings.color_sale }};
      --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
      --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --ff-wordmark-font: {{ settings.flyflow_wordmark_font.family }}, {{ settings.flyflow_wordmark_font.fallback_families }};
      --ff-wordmark-tracking: {{ settings.flyflow_wordmark_tracking | default: -3 | divided_by: 100.0 }}em;
      --ff-wordmark-weight: {{ settings.flyflow_wordmark_weight | default: '700' }};
      --ff-wordmark-transform: {% if settings.flyflow_wordmark_style == 'caps' %}uppercase{% else %}none{% endif %};
      --ff-wordmark-variant: {% if settings.flyflow_wordmark_style == 'smallcaps' %}all-small-caps{% else %}normal{% endif %};
      --font-size-base: {{ settings.font_size_base }}px;
      --border-radius: {{ settings.border_radius }}px;
      --space-sm: 0.5rem;
      --space-md: 1rem;
      --space-lg: 1.5rem;
      --space-xl: 2rem;
      --space-2xl: 3rem;
      --transition-fast: 150ms ease;
      --transition-base: 300ms ease;
    }
  {% endstyle %}

  {% style %}
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    {{ settings.flyflow_wordmark_font | font_face: font_display: 'swap' }}
  {% endstyle %}

  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'flyflow-wordmark.css' | asset_url }}">

  <script>
    (function() {
      var saved = localStorage.getItem('flyflow-theme-preference');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
      else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.setAttribute('data-theme', 'dark');
    })();
  </script>

  {{ content_for_header }}
</head>
<body class="template-password{% if settings.flyflow_wordmark_hover %} ff-wordmark-hover-enabled{% endif %}">
  {{ content_for_layout }}
</body>
</html>
