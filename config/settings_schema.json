        "max": 220,
        "step": 4,
        "default": 140,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "social_rail_offset_side",
        "label": "Side offset",
        "min": 8,
        "max": 32,
        "step": 2,
        "default": 16,
        "unit": "px"
      }
    ]
