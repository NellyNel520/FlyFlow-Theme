  {
    "name": "Analytics & SEO",
    "settings": [
      {
        "type": "header",
        "content": "Analytics"
      },
      {
        "type": "text",
        "id": "ga4_measurement_id",
        "label": "Google Analytics 4 Measurement ID",
        "info": "Format: G-XXXXXXXXXX"
      },
      {
        "type": "text",
        "id": "facebook_pixel_id",
        "label": "Facebook Pixel ID",
        "info": "Your Facebook Pixel ID for conversion tracking"
      },
      {
        "type": "header",
        "content": "SEO"
      },
      {
        "type": "text",
        "id": "seo_title_separator",
