{% comment %}
  FlyFlow Theme - Quick View Modal Snippet
  Purpose: Product quick view modal on collection pages. Shows image,
           title, price, variant selector, quantity, and add to cart
           without leaving the collection page.
  Dependencies: theme.js (Modal, Cart modules)
  Usage: Triggered via data attributes on product cards
  Last modified: 2026-02-17
{% endcomment %}

<div class="modal" id="quick-view-modal" role="dialog" aria-modal="true" aria-labelledby="quick-view-title" style="max-width:800px">
  <div class="modal__header">
    <h2 class="modal__title" id="quick-view-title" data-quick-view-title></h2>
    <button class="modal__close" data-modal-close aria-label="{{ 'accessibility.close_modal' | t }}">
      <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="1.5" fill="none" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="modal__body">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-xl)" class="quick-view__grid">
      {%- comment -%} Product image {%- endcomment -%}
      <div style="aspect-ratio:3/4;overflow:hidden;background:var(--color-surface)">
        <img
          data-quick-view-image
          alt=""
          width="900"
          height="1200"
          loading="lazy"
          style="width:100%;height:100%;object-fit:cover"
        >
      </div>

      {%- comment -%} Product info {%- endcomment -%}
      <div>
        <p class="product-info__vendor" data-quick-view-vendor></p>
        <div class="product-info__price mt-sm mb-md">
          <span data-quick-view-price style="font-size:1.125rem;letter-spacing:0.03em"></span>
          <span data-quick-view-compare style="text-decoration:line-through;color:var(--color-text-secondary);margin-left:var(--space-sm);font-size:0.9375rem;display:none"></span>
        </div>
        <p data-quick-view-error style="display:none;color:var(--color-error);font-size:0.8125rem;margin-bottom:var(--space-sm)"></p>

        {%- comment -%} Stock indicator {%- endcomment -%}
        <div data-quick-view-stock class="stock-indicator" style="display:none">
          <span class="stock-indicator__dot"></span>
          <span data-quick-view-stock-text></span>
        </div>

        {%- comment -%} Variant selectors (dynamically populated) {%- endcomment -%}
        <div data-quick-view-variants style="margin-bottom:var(--space-lg)"></div>

        {%- comment -%} Quantity + Add to Cart {%- endcomment -%}
        <div style="display:flex;gap:var(--space-sm);margin-bottom:var(--space-md)">
          <div class="quantity-selector">
            <button type="button" class="quantity-selector__btn" data-quick-view-qty-minus aria-label="{{ 'products.decrease_quantity' | t }}">&minus;</button>
            <input type="number" class="quantity-selector__input" data-quick-view-qty value="1" min="1" aria-label="{{ 'products.quantity' | t }}">
            <button type="button" class="quantity-selector__btn" data-quick-view-qty-plus aria-label="{{ 'products.increase_quantity' | t }}">&plus;</button>
          </div>

          <button
            class="btn btn--primary btn--lg"
            style="flex:1"
            data-quick-view-atc
            data-add-to-cart
            data-add-text="{{ 'products.add_to_cart' | t }}"
            data-sold-out-text="{{ 'products.sold_out' | t }}"
          >
            {{ 'products.add_to_cart' | t }}
          </button>
        </div>

        <a
          href=""
          data-quick-view-link
          class="text-accent"
          style="display:inline-block;font-size:0.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px"
        >
          {{ 'products.view_product' | t }} &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  @media (max-width: 767px) {
    .quick-view__grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  /**
   * Quick View Module
   * Fetches product data via Shopify AJAX API and populates the modal
   * with image, price, variant selector, quantity, and add to cart.
   */
  (function() {
    var currentProduct = null;
    var selectedOptions = {};
    var isLoading = false;

    function getSwatchColor(value) {
      var key = String(value || '').toLowerCase();
      var map = {
        onyx: '#0a0a0a',
        black: '#0a0a0a',
        cloud: '#f5f4f2',
        white: '#f5f4f2',
        bone: '#e7dfd1',
        butter: '#eadf9d',
        slate: '#73767b',
        grey: '#73767b',
        gray: '#73767b',
        olive: '#677056',
        gold: '#c4a46a',
        silver: '#bfc3c7'
      };
      return map[key] || '#d4d1cc';
    }

    document.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-quick-view]');
      if (btn) {
        e.preventDefault();
        loadProduct(btn.dataset.quickView);
        return;
      }

      /* Variant option click inside quick view */
      var optBtn = e.target.closest('[data-qv-option]');
      if (optBtn) {
        e.preventDefault();
        selectOption(optBtn);
        return;
      }

      /* Quantity buttons */
      var qtyMinus = e.target.closest('[data-quick-view-qty-minus]');
      if (qtyMinus) {
        e.preventDefault();
        var input = document.querySelector('[data-quick-view-qty]');
        if (input) input.value = Math.max(1, parseInt(input.value, 10) - 1);
        return;
      }

      var qtyPlus = e.target.closest('[data-quick-view-qty-plus]');
      if (qtyPlus) {
        e.preventDefault();
        var input = document.querySelector('[data-quick-view-qty]');
        if (input) input.value = parseInt(input.value, 10) + 1;
      }
    });

    function loadProduct(handle) {
      if (!handle || isLoading) return;
      isLoading = true;
      setLoadingState(true);
      setError('');

      fetch('/products/' + encodeURIComponent(handle) + '.js')
        .then(function(r) { return r.json(); })
        .then(function(product) {
          if (!product || !product.variants || product.variants.length === 0) {
            throw new Error('Invalid product payload');
          }

          currentProduct = product;
          selectedOptions = {};

          /* Set basic info */
          setText('[data-quick-view-title]', product.title);
          if (product.featured_image) {
            setAttr('[data-quick-view-image]', 'src', product.featured_image);
          } else {
            removeAttr('[data-quick-view-image]', 'src');
          }
          setAttr('[data-quick-view-image]', 'alt', product.title);
          setText('[data-quick-view-vendor]', product.vendor);
          setText('[data-quick-view-price]', FlyFlow.formatMoney(product.price));
          setAttr('[data-quick-view-link]', 'href', product.url);

          /* Compare at price */
          var compare = document.querySelector('[data-quick-view-compare]');
          if (compare) {
            if (product.compare_at_price && product.compare_at_price > product.price) {
              compare.textContent = FlyFlow.formatMoney(product.compare_at_price);
              compare.style.display = '';
            } else {
              compare.style.display = 'none';
            }
          }

          /* Build variant selectors */
          buildVariants(product);

          /* Set initial variant */
          var firstAvailable = product.variants.find(function(v) { return v.available; }) || product.variants[0];
          updateVariant(firstAvailable);

          /* Reset quantity */
          var qtyInput = document.querySelector('[data-quick-view-qty]');
          if (qtyInput) qtyInput.value = 1;

          /* Open modal */
          FlyFlow.Modal.open('quick-view-modal');
        })
        .catch(function() {
          setError('Unable to load this product right now. Please try again.');
        })
        .finally(function() {
          isLoading = false;
          setLoadingState(false);
        });
    }

    function buildVariants(product) {
      var container = document.querySelector('[data-quick-view-variants]');
      if (!container) return;

      if (product.variants.length === 1 && product.variants[0].title === 'Default Title') {
        container.innerHTML = '';
        return;
      }

      var html = '';
      product.options.forEach(function(optionName, idx) {
        var values = [];
        product.variants.forEach(function(v) {
          var val = v.options[idx];
          if (values.indexOf(val) === -1) values.push(val);
        });

        /* Pre-select first available */
        var firstAvailable = product.variants.find(function(v) { return v.available; });
        var selectedVal = firstAvailable ? firstAvailable.options[idx] : values[0];
        selectedOptions[optionName] = selectedVal;

        var isColor = optionName.toLowerCase() === 'color' || optionName.toLowerCase() === 'colour';

        html += '<div class="variant-selector" style="margin-bottom:var(--space-md)">';
        html += '<div class="variant-selector__label"><span>' + optionName + ':</span> <span class="variant-selector__selected" data-qv-selected="' + optionName + '">' + selectedVal + '</span></div>';
        html += '<div class="variant-selector__options">';

        values.forEach(function(val) {
          /* Check availability for this value */
          var available = product.variants.some(function(v) {
            return v.options[idx] === val && v.available;
          });

          if (isColor) {
            html += '<button type="button" class="swatch' + (val === selectedVal ? ' swatch--active' : '') + (!available ? ' swatch--sold-out' : '') + '" '
              + 'style="background-color:' + getSwatchColor(val) + '" '
              + 'data-qv-option data-qv-option-name="' + optionName + '" data-qv-option-value="' + val + '" '
              + 'title="' + val + '" aria-label="' + val + '"'
              + (!available ? ' aria-disabled="true"' : '') + '></button>';
          } else {
            html += '<button type="button" class="size-btn' + (val === selectedVal ? ' size-btn--active' : '') + (!available ? ' size-btn--sold-out' : '') + '" '
              + 'data-qv-option data-qv-option-name="' + optionName + '" data-qv-option-value="' + val + '" '
              + 'aria-label="' + val + '"'
              + (!available ? ' aria-disabled="true"' : '') + '>' + val + '</button>';
          }
        });

        html += '</div></div>';
      });

      container.innerHTML = html;
    }

    function selectOption(btn) {
      if (!currentProduct || !currentProduct.variants) return;
      if (btn.getAttribute('aria-disabled') === 'true') return;
      var name = btn.dataset.qvOptionName;
      var value = btn.dataset.qvOptionValue;
      selectedOptions[name] = value;

      /* Update active states */
      var group = btn.closest('.variant-selector');
      if (group) {
        group.querySelectorAll('[data-qv-option]').forEach(function(b) {
          var isColor = b.classList.contains('swatch');
          var cls = isColor ? 'swatch--active' : 'size-btn--active';
          b.classList.toggle(cls, b.dataset.qvOptionValue === value);
        });
        var label = group.querySelector('[data-qv-selected]');
        if (label) label.textContent = value;
      }

      /* Find matching variant */
      var variant = currentProduct.variants.find(function(v) {
        return currentProduct.options.every(function(optName, idx) {
          return !selectedOptions[optName] || selectedOptions[optName] === v.options[idx];
        });
      });

      if (variant) {
        updateVariant(variant);
      } else {
        setError('This combination is currently unavailable.');
      }
    }

    function updateVariant(variant) {
      if (!variant) return;
      setError('');
      setText('[data-quick-view-price]', FlyFlow.formatMoney(variant.price));

      var compare = document.querySelector('[data-quick-view-compare]');
      if (compare) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          compare.textContent = FlyFlow.formatMoney(variant.compare_at_price);
          compare.style.display = '';
        } else {
          compare.style.display = 'none';
        }
      }

      /* Update image if variant has one */
      if (variant.featured_image) {
        setAttr('[data-quick-view-image]', 'src', variant.featured_image.src);
      }

      /* Update stock */
      var stockEl = document.querySelector('[data-quick-view-stock]');
      var stockText = document.querySelector('[data-quick-view-stock-text]');
      if (stockEl && stockText) {
        stockEl.style.display = '';
        if (!variant.available) {
          stockEl.className = 'stock-indicator stock-indicator--out-of-stock';
          stockText.textContent = 'Out of stock';
        } else if (variant.inventory_management && variant.inventory_quantity > 0 && variant.inventory_quantity <= 5) {
          stockEl.className = 'stock-indicator stock-indicator--low-stock';
          stockText.textContent = 'Only ' + variant.inventory_quantity + ' left';
        } else {
          stockEl.className = 'stock-indicator stock-indicator--in-stock';
          stockText.textContent = 'In stock';
        }
      }

      /* Update ATC button */
      var atc = document.querySelector('[data-quick-view-atc]');
      if (atc) {
        atc.dataset.variantId = variant.id;
        if (variant.available) {
          atc.disabled = false;
          atc.textContent = atc.dataset.addText || 'Add to Bag';
        } else {
          atc.disabled = true;
          atc.textContent = atc.dataset.soldOutText || 'Sold Out';
        }
      }
    }

    function setText(sel, text) {
      var el = document.querySelector(sel);
      if (el) el.textContent = text;
    }
    function setAttr(sel, attr, val) {
      var el = document.querySelector(sel);
      if (el) el.setAttribute(attr, val);
    }
    function removeAttr(sel, attr) {
      var el = document.querySelector(sel);
      if (el) el.removeAttribute(attr);
    }
    function setError(message) {
      var el = document.querySelector('[data-quick-view-error]');
      if (!el) return;
      el.textContent = message || '';
      el.style.display = message ? '' : 'none';
    }
    function setLoadingState(isBusy) {
      var atc = document.querySelector('[data-quick-view-atc]');
      if (!atc) return;
      if (isBusy) {
        atc.disabled = true;
        atc.textContent = 'Loading...';
      } else {
        var addText = atc.dataset.addText || 'Add to Bag';
        if (!atc.dataset.variantId) {
          atc.disabled = false;
          atc.textContent = addText;
          return;
        }
        atc.textContent = atc.disabled ? (atc.dataset.soldOutText || 'Sold Out') : addText;
      }
    }
  })();
</script>
