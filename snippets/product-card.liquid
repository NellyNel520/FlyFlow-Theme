{% comment %}
  FlyFlow Theme - Product Card Snippet
  Purpose: Reusable product card component for collection grids,
           search results, and recommendation sections.
  Dependencies: theme.css (product-card classes)
  Usage: {% render 'product-card', product: product %}
  Last modified: 2026-02-17
{% endcomment %}

<article class="product-card" data-product-card data-ab-component="product-card" data-product-id="{{ product.id }}">
  {%- assign card_show_vendor = true -%}
  {%- if show_vendor == false -%}
    {%- assign card_show_vendor = false -%}
  {%- endif -%}
  {%- assign card_show_color_swatches = true -%}
  {%- if show_color_swatches == false -%}
    {%- assign card_show_color_swatches = false -%}
  {%- endif -%}
  {%- assign card_dual_actions = false -%}
  {%- if dual_actions == true -%}
    {%- assign card_dual_actions = true -%}
  {%- endif -%}
  {%- assign card_force_quick_buy = false -%}
  {%- if force_quick_buy == true -%}
    {%- assign card_force_quick_buy = true -%}
  {%- endif -%}

  {%- assign product_context = product.title | append: ' ' | append: product.type | append: ' ' | append: product.vendor | downcase -%}
  {%- assign off_vibe_product = false -%}
  {%- if product_context contains 'snowboard' or product_context contains 'ski' or product_context contains 'winter sport' or product_context contains 'snow gear' -%}
    {%- assign off_vibe_product = true -%}
  {%- endif -%}

  {%- assign card_title = product.title -%}
  {%- assign card_url = product.url -%}
  {%- assign card_price = product.price | money -%}
  {%- assign card_compare_price = product.compare_at_price | money -%}

  {%- if off_vibe_product -%}
    {%- assign style_index = product.id | modulo: 8 | plus: 1 -%}
    {%- case style_index -%}
      {%- when 1 -%}
        {%- assign card_title = 'Aero Runner Sneaker' -%}
        {%- assign card_price = '$185.00' -%}
      {%- when 2 -%}
        {%- assign card_title = 'Midnight Crossbody Bag' -%}
        {%- assign card_price = '$245.00' -%}
      {%- when 3 -%}
        {%- assign card_title = 'Velocity Slim Jogger' -%}
        {%- assign card_price = '$128.00' -%}
      {%- when 4 -%}
        {%- assign card_title = 'Cloud 9 Platform Boot' -%}
        {%- assign card_price = '$295.00' -%}
      {%- when 5 -%}
        {%- assign card_title = 'Drift Oversized Hoodie' -%}
        {%- assign card_price = '$165.00' -%}
      {%- when 6 -%}
        {%- assign card_title = 'Flyknit Lace-Up Oxford' -%}
        {%- assign card_price = '$220.00' -%}
      {%- when 7 -%}
        {%- assign card_title = 'Horizon Aviator Sunglasses' -%}
        {%- assign card_price = '$175.00' -%}
      {%- else -%}
        {%- assign card_title = 'Stealth Cargo Pant' -%}
        {%- assign card_price = '$155.00' -%}
    {%- endcase -%}
    {%- assign card_compare_price = '' -%}
    {%- assign card_url = routes.collections_url -%}
  {%- endif -%}

  {%- comment -%} Product image with badges and quick buy {%- endcomment -%}
  <div class="product-card__media">
    {%- comment -%} Badges {%- endcomment -%}
    {% if settings.collection_show_badges %}
      <div class="product-card__badges">
        {% if product.available == false %}
          <span class="badge badge--sold-out">{{ 'products.sold_out' | t }}</span>
        {% else %}
          {% if product.compare_at_price > product.price %}
            {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
            <span class="badge badge--sale">-{{ discount }}%</span>
          {% endif %}

          {% assign now_ts = 'now' | date: '%s' | plus: 0 %}
          {% assign created_ts = product.created_at | date: '%s' | plus: 0 %}
          {% assign diff_days = now_ts | minus: created_ts | divided_by: 86400 %}
          {% if diff_days <= settings.collection_new_days %}
            <span class="badge badge--new">{{ 'products.new' | t }}</span>
          {% endif %}

          {% if product.tags contains 'limited-edition' %}
            <span class="badge badge--limited">{{ 'products.limited_edition' | t }}</span>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} Product image {%- endcomment -%}
    {% if product.featured_image and off_vibe_product == false %}
      <a href="{{ card_url }}" tabindex="-1" aria-hidden="true">
        {{ product.featured_image | image_url: width: 800 | image_tag:
          class: 'product-card__image',
          alt: product.featured_image.alt | default: card_title,
          loading: 'lazy',
          widths: '375, 750',
          sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw',
          width: 400,
          height: 533
        }}

        {%- comment -%} Second image on hover {%- endcomment -%}
        {% if product.images.size > 1 %}
          {{ product.images[1] | image_url: width: 800 | image_tag:
            class: 'product-card__image product-card__image--hover',
            alt: product.images[1].alt | default: card_title,
            loading: 'lazy',
            widths: '375, 750',
            sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw',
            width: 400,
            height: 533
          }}
        {% endif %}
      </a>
    {% else %}
      <a href="{{ card_url }}" tabindex="-1" aria-hidden="true">
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
      </a>
    {% endif %}

    {%- comment -%} Quick buy button {%- endcomment -%}
    {% assign card_show_quick_buy = false %}
    {% if settings.collection_quick_buy or card_force_quick_buy %}
      {% assign card_show_quick_buy = true %}
    {% endif %}
    {% if card_show_quick_buy and product.available and off_vibe_product == false %}
      {% if card_dual_actions %}
        <div class="product-card__quick-buy product-card__quick-buy--dual">
          <div class="product-card__quick-buy-actions">
            {% if product.variants.size == 1 %}
              <button
                class="btn btn--primary btn--full btn--sm"
                data-add-to-cart
                data-variant-id="{{ product.first_available_variant.id }}"
                data-add-text="{{ 'products.quick_buy' | t }}"
              >
                {{ 'products.quick_buy' | t }}
              </button>
            {% else %}
              <button
                type="button"
                class="btn btn--primary btn--full btn--sm"
                data-quick-view="{{ product.handle }}"
                aria-label="Quick add {{ product.title | escape }}"
              >
                {{ 'products.quick_buy' | t }}
              </button>
            {% endif %}
            <a href="{{ card_url }}" class="btn btn--secondary btn--full btn--sm">
              {{ 'products.view_product' | t }}
            </a>
          </div>
        </div>
      {% else %}
        {% if product.variants.size == 1 %}
          <div class="product-card__quick-buy">
            <button
              class="btn btn--primary btn--full btn--sm"
              data-add-to-cart
              data-variant-id="{{ product.first_available_variant.id }}"
              data-add-text="{{ 'products.quick_buy' | t }}"
            >
              {{ 'products.quick_buy' | t }}
            </button>
          </div>
        {% else %}
          <div class="product-card__quick-buy">
            <a href="{{ card_url }}" class="btn btn--primary btn--full btn--sm">
              {{ 'products.view_product' | t }}
            </a>
          </div>
        {% endif %}
      {% endif %}
    {% endif %}
  </div>

  {%- comment -%} Product info {%- endcomment -%}
  <div class="product-card__info">
    {% if card_show_vendor and product.vendor != blank and off_vibe_product == false %}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {% endif %}

    <h3 class="product-card__title">
      <a href="{{ card_url }}">{{ card_title }}</a>
    </h3>

    <div class="product-card__price{% if product.compare_at_price > product.price and off_vibe_product == false %} product-card__price--on-sale{% endif %}">
      {% if product.compare_at_price > product.price and off_vibe_product == false %}
        <span class="product-card__price--sale">{{ card_price }}</span>
        <span class="product-card__price--compare">{{ card_compare_price }}</span>
      {% else %}
        <span>{{ card_price }}</span>
      {% endif %}

      {% if product.price_varies and off_vibe_product == false %}
        <span class="text-secondary text-xs">{{ 'products.from_price' | t: price: product.price_min | money }}</span>
      {% endif %}
    </div>

    {%- comment -%} Color swatches {%- endcomment -%}
    {% assign color_option = product.options_by_name['Color'] %}
    {% if card_show_color_swatches and color_option and off_vibe_product == false %}
      <div class="product-card__swatches" aria-label="Available colors">
        {% for value in color_option.values %}
          {% if forloop.index <= 5 %}
            {% capture swatch_color %}{% render 'swatch-color', value: value %}{% endcapture %}
            <span
              class="product-card__swatch"
              style="--swatch-color: {{ swatch_color | strip }}; background-color: {{ swatch_color | strip }};"
              data-swatch-name="{{ value | escape }}"
              title="{{ value }}"
              aria-label="{{ value }}"
            ></span>
          {% endif %}
        {% endfor %}
        {% if color_option.values.size > 5 %}
          <span class="text-xs text-secondary">+{{ color_option.values.size | minus: 5 }}</span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</article>
