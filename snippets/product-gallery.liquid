{% comment %}
  FlyFlow Theme - Product Gallery Snippet
  Purpose: Product media gallery with variant media grouping support.
  Dependencies: theme.js (ProductGallery module)
  Usage: {% render 'product-gallery', product: product, parent_section_id: section.id, section_settings: section.settings %}
{% endcomment %}

{% assign gallery_settings = section_settings %}
{% assign group_option_name = gallery_settings.variant_media_group_option_name | default: 'Color' %}
{% assign group_option_name_downcase = group_option_name | downcase %}
{% assign group_method = gallery_settings.variant_media_group_method | default: 'auto' %}
{% assign group_behavior = gallery_settings.variant_media_behavior | default: 'filter_thumbnails' %}
{% assign transition_style = gallery_settings.transition_style | default: 'fade' %}
{% assign show_global_media = false %}
{% if gallery_settings.show_global_media_with_variant %}
  {% assign show_global_media = true %}
{% endif %}

{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign active_media_id = selected_variant.featured_media.id | default: product.featured_media.id | default: product.media.first.id %}

<div
  class="product-gallery"
  data-product-gallery
  data-section-id="{{ parent_section_id | default: section.id | default: product.id }}"
  data-enable-variant-media-groups="{{ gallery_settings.enable_variant_media_groups }}"
  data-group-option-name="{{ group_option_name | escape }}"
  data-group-method="{{ group_method }}"
  data-group-behavior="{{ group_behavior }}"
  data-show-global-media="{{ show_global_media }}"
  data-transition-style="{{ transition_style }}"
>
  <div class="product-gallery__main" data-gallery-main>
    <div class="product-gallery__media-stage" data-gallery-media-stage>
      {% for media in product.media %}
        {% assign media_alt = media.alt | default: '' %}
        {% assign media_alt_downcase = media_alt | downcase %}
        {% assign group_key = group_option_name_downcase | append: ':' %}
        {% assign group_value = '' %}
        {% if media_alt_downcase contains group_key %}
          {% assign group_after = media_alt | split: ':' | last %}
          {% assign group_value = group_after | split: '|' | first | strip %}
        {% endif %}
        {% assign is_global_media = false %}
        {% if group_value == blank %}
          {% assign is_global_media = true %}
        {% endif %}

        <div
          class="product-gallery__media-item{% if media.id == active_media_id %} is-active{% endif %}"
          data-gallery-media-item
          data-media-id="{{ media.id }}"
          data-media-type="{{ media.media_type }}"
          data-alt="{{ media_alt | escape }}"
          data-group-value="{{ group_value | downcase | escape }}"
          data-has-group="{% if group_value != blank %}true{% else %}false{% endif %}"
          data-global="{% if is_global_media %}true{% else %}false{% endif %}"
          {% unless media.id == active_media_id %}hidden{% endunless %}
        >
          {% case media.media_type %}
            {% when 'image' %}
              {{ media | image_url: width: 1500 | image_tag:
                class: 'product-gallery__main-image',
                loading: 'eager',
                widths: '375, 750, 1100, 1500',
                sizes: '(min-width: 1024px) 55vw, (min-width: 768px) 50vw, 100vw',
                alt: media.alt | default: product.title
              }}
            {% when 'video' %}
              <div class="product-gallery__rich-media">
                {{ media | media_tag: controls: true, preload: 'metadata', image_size: '1100x' }}
              </div>
            {% when 'external_video' %}
              <div class="product-gallery__rich-media">
                {{ media | media_tag: image_size: '1100x' }}
              </div>
            {% when 'model' %}
              <div class="product-gallery__rich-media">
                {{ media | model_viewer_tag: image_size: '1100x', reveal: 'interaction', toggleable: true }}
              </div>
            {% else %}
              {{ media | image_url: width: 1500 | image_tag:
                class: 'product-gallery__main-image',
                loading: 'eager',
                widths: '375, 750, 1100, 1500',
                sizes: '(min-width: 1024px) 55vw, (min-width: 768px) 50vw, 100vw',
                alt: media.alt | default: product.title
              }}
          {% endcase %}
        </div>
      {% endfor %}
    </div>

    <button
      class="header__icon-btn"
      data-gallery-fullscreen
      aria-label="{{ 'products.gallery.fullscreen' | t }}"
      style="position:absolute;top:var(--space-sm);right:var(--space-sm);background:var(--color-background);border-radius:50%;box-shadow:0 2px 8px rgba(0,0,0,.1)"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true">
        <polyline points="15 3 21 3 21 9"/>
        <polyline points="9 21 3 21 3 15"/>
        <line x1="21" y1="3" x2="14" y2="10"/>
        <line x1="3" y1="21" x2="10" y2="14"/>
      </svg>
    </button>
  </div>

  {% if product.media.size > 1 %}
    <div class="product-gallery__dots" aria-hidden="true" data-gallery-dots>
      {% for media in product.media %}
        <button
          class="product-gallery__dot{% if media.id == active_media_id %} product-gallery__dot--active{% endif %}"
          data-gallery-dot
          data-media-id="{{ media.id }}"
          aria-label="{{ 'accessibility.slide_number' | t: number: forloop.index, total: product.media.size }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}

  {% if product.media.size > 1 %}
    <div class="product-gallery__thumbnails" role="list" data-gallery-thumbnails>
      {% for media in product.media %}
        {% assign media_alt = media.alt | default: '' %}
        {% assign media_alt_downcase = media_alt | downcase %}
        {% assign group_key = group_option_name_downcase | append: ':' %}
        {% assign group_value = '' %}
        {% if media_alt_downcase contains group_key %}
          {% assign group_after = media_alt | split: ':' | last %}
          {% assign group_value = group_after | split: '|' | first | strip %}
        {% endif %}
        {% assign is_global_media = false %}
        {% if group_value == blank %}
          {% assign is_global_media = true %}
        {% endif %}
        <button
          class="product-gallery__thumbnail{% if media.id == active_media_id %} product-gallery__thumbnail--active{% endif %}"
          data-gallery-thumbnail
          data-media-id="{{ media.id }}"
          data-media-type="{{ media.media_type }}"
          data-alt="{{ media_alt | escape }}"
          data-group-value="{{ group_value | downcase | escape }}"
          data-has-group="{% if group_value != blank %}true{% else %}false{% endif %}"
          data-global="{% if is_global_media %}true{% else %}false{% endif %}"
          aria-label="{{ 'products.gallery.thumbnail' | t: number: forloop.index }}"
          role="listitem"
        >
          {{ media.preview_image | image_url: width: 160 | image_tag:
            alt: media.alt | default: product.title,
            loading: 'lazy',
            width: 76,
            height: 96
          }}
        </button>
      {% endfor %}
    </div>
  {% endif %}

  <div class="product-gallery__fullscreen" data-gallery-fullscreen-view aria-hidden="true">
    <div class="product-gallery__fullscreen-media" data-gallery-fullscreen-media></div>
    <button
      class="header__icon-btn"
      type="button"
      data-gallery-fullscreen-close
      aria-label="{{ 'products.gallery.close_fullscreen' | t }}"
      style="position:absolute;top:var(--space-md);right:var(--space-md);z-index:10"
    >
      <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <script type="application/json" data-variant-media-map>
    {
      {% assign has_variant_media_map = false %}
      {% for variant in product.variants %}
        {% assign media_refs = variant.metafields.custom.media_group.value %}
        {% assign ids_csv = '' %}
        {% if media_refs != blank %}
          {% for ref in media_refs %}
            {% if ref.id != blank %}
              {% if ids_csv != blank %}
                {% assign ids_csv = ids_csv | append: ',' %}
              {% endif %}
              {% assign ids_csv = ids_csv | append: ref.id %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if ids_csv != blank %}
          {% if has_variant_media_map %},{% endif %}
          "{{ variant.id }}":[{{ ids_csv }}]
          {% assign has_variant_media_map = true %}
        {% endif %}
      {% endfor %}
    }
  </script>

  {% if product.metafields.custom.variant_media_map.value != blank %}
    <script type="application/json" data-option-media-map>{{ product.metafields.custom.variant_media_map.value | json }}</script>
  {% endif %}
</div>
