{% comment %}
  FlyFlow Theme - Product Gallery Snippet
  Purpose: Product image gallery with thumbnails, swipe navigation,
           zoom, pagination dots, and fullscreen mode.
  Dependencies: theme.js (ProductGallery module)
  Usage: {% render 'product-gallery', product: product, parent_section_id: section.id %}
{% endcomment %}

<div class="product-gallery" data-product-gallery data-section-id="{{ parent_section_id | default: section.id | default: product.id }}">
  {%- comment -%} Main image {%- endcomment -%}
  <div class="product-gallery__main" data-gallery-main>
    {% if product.featured_image %}
      <img
        class="product-gallery__main-image"
        data-gallery-main-image
        src="{{ product.featured_image | image_url: width: 1200 }}"
        srcset="
          {{ product.featured_image | image_url: width: 375 }} 375w,
          {{ product.featured_image | image_url: width: 750 }} 750w,
          {{ product.featured_image | image_url: width: 1100 }} 1100w,
          {{ product.featured_image | image_url: width: 1500 }} 1500w
        "
        sizes="(min-width: 1024px) 55vw, (min-width: 768px) 50vw, 100vw"
        alt="{{ product.featured_image.alt | escape | default: product.title }}"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
        loading="eager"
      >
    {% else %}
      <div class="product-gallery__placeholder">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {%- comment -%} Fullscreen button {%- endcomment -%}
    <button
      class="header__icon-btn"
      data-gallery-fullscreen
      aria-label="{{ 'products.gallery.fullscreen' | t }}"
      style="position:absolute;top:var(--space-sm);right:var(--space-sm);background:var(--color-background);border-radius:50%;box-shadow:0 2px 8px rgba(0,0,0,.1)"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true">
        <polyline points="15 3 21 3 21 9"/>
        <polyline points="9 21 3 21 3 15"/>
        <line x1="21" y1="3" x2="14" y2="10"/>
        <line x1="3" y1="21" x2="10" y2="14"/>
      </svg>
    </button>
  </div>

  {%- comment -%} Pagination dots (mobile) {%- endcomment -%}
  {% if product.images.size > 1 %}
    <div class="product-gallery__dots" aria-hidden="true">
      {% for image in product.images %}
        <button
          class="product-gallery__dot{% if forloop.first %} product-gallery__dot--active{% endif %}"
          data-gallery-dot
          aria-label="{{ 'accessibility.slide_number' | t: number: forloop.index, total: product.images.size }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}

  {%- comment -%} Thumbnail navigation {%- endcomment -%}
  {% if product.images.size > 1 %}
    <div class="product-gallery__thumbnails" role="list">
      {% for image in product.images %}
        <button
          class="product-gallery__thumbnail{% if forloop.first %} product-gallery__thumbnail--active{% endif %}"
          data-gallery-thumbnail
          data-full-src="{{ image | image_url: width: 1200 }}"
          data-srcset="
            {{ image | image_url: width: 375 }} 375w,
            {{ image | image_url: width: 750 }} 750w,
            {{ image | image_url: width: 1100 }} 1100w
          "
          {% if image.attached_to_variant? %}data-media-id="{{ image.id }}"{% endif %}
          aria-label="{{ 'products.gallery.thumbnail' | t: number: forloop.index }}"
          role="listitem"
        >
          {{ image | image_url: width: 128 | image_tag:
            alt: image.alt | default: product.title,
            loading: 'lazy',
            width: 64,
            height: 80
          }}
        </button>
      {% endfor %}
    </div>
  {% endif %}

  {%- comment -%} Fullscreen gallery overlay {%- endcomment -%}
  <div class="product-gallery__fullscreen" data-gallery-fullscreen-view aria-hidden="true">
    <button
      class="header__icon-btn"
      data-modal-close
      aria-label="{{ 'products.gallery.close_fullscreen' | t }}"
      style="position:absolute;top:var(--space-md);right:var(--space-md);z-index:10"
    >
      <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
</div>
