{% comment %}
  FlyFlow Theme - Product Share Row
  Purpose: Native social sharing actions + copy product link.
  Usage: {% render 'product-share', product: product, current_variant: product.selected_or_first_available_variant %}
{% endcomment %}

{% assign resolved_variant = current_variant | default: product.selected_or_first_available_variant %}
{% assign share_url = shop.url | append: product.url %}
{% if resolved_variant and resolved_variant.id %}
  {% assign share_url = share_url | append: '?variant=' | append: resolved_variant.id %}
{% endif %}
{% assign share_title = product.title | strip_html | strip %}
{% assign share_image = '' %}
{% if product.featured_image %}
  {% assign share_image = product.featured_image | image_url: width: 1200 %}
{% endif %}

<div class="product-share" data-product-share>
  <span class="product-share__label">Share:</span>

  <a
    href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}"
    target="_blank"
    rel="noopener"
    class="product-share__icon"
    aria-label="Share on Facebook"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 8H16V5h-2.5c-2.5 0-4 1.7-4 4.2V11H7v3h2.5v5H13v-5h2.7l.3-3H13V9.5c0-.9.4-1.5 1.5-1.5z" fill="currentColor"/></svg>
  </a>

  <a
    href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}&text={{ share_title | url_encode }}"
    target="_blank"
    rel="noopener"
    class="product-share__icon"
    aria-label="Share on X"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.2 3h2.9l-6.3 7.1L22 21h-5.6l-4.4-5.8L6.9 21H4l6.8-7.7L2 3h5.7l4 5.3L18.2 3zm-1 16h1.6L7.1 4.9H5.4L17.2 19z" fill="currentColor"/></svg>
  </a>

  <a
    href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}{% if share_image != blank %}&media={{ share_image | url_encode }}{% endif %}&description={{ share_title | url_encode }}"
    target="_blank"
    rel="noopener"
    class="product-share__icon"
    aria-label="Share on Pinterest"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c0-.8 0-2 .4-2.8l1.3-5.3s-.3-.7-.3-1.8c0-1.7 1-2.9 2.2-2.9 1 0 1.5.8 1.5 1.7 0 1-.7 2.6-1.1 4.1-.3 1.2.6 2.1 1.8 2.1 2.1 0 3.8-2.3 3.8-5.6 0-2.9-2.1-5-5.1-5a5.3 5.3 0 0 0-5.5 5.4c0 1.1.4 2.2.9 2.8.1.1.1.2.1.4l-.3 1.2c0 .2-.2.2-.4.1-1.4-.7-2.2-2.8-2.2-4.4 0-3.6 2.6-6.9 7.4-6.9 3.9 0 6.9 2.8 6.9 6.5 0 3.9-2.4 7-5.8 7-1.1 0-2.2-.6-2.5-1.4l-.7 2.6c-.2 1-.8 2.1-1.2 2.8A10 10 0 1 0 12 2z" fill="currentColor"/></svg>
  </a>

  <a
    href="mailto:?subject={{ share_title | url_encode }}&body={{ share_url | url_encode }}"
    class="product-share__icon"
    aria-label="Share by email"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
  </a>

  <button
    type="button"
    class="product-share__copy"
    data-copy-link
    data-copy-url="{{ share_url }}"
    data-copy-default="Copy link"
    data-copy-success="Copied"
    aria-label="Copy product link"
  >
    Copy link
  </button>
</div>
