{% comment %}
  FlyFlow Theme - Bottom Navigation Snippet
  Purpose: Fixed bottom navigation bar for mobile using the same source menu
           as the mobile sidebar navigation.
  Dependencies: theme.css (bottom-nav classes), theme.js (Navigation module)
  Usage: {% render 'bottom-nav', menu: section.settings.menu %}
  Last modified: 2026-02-17
{% endcomment %}

<nav class="bottom-nav" data-bottom-nav aria-label="Mobile navigation">
  <div class="bottom-nav__items">
    {% if menu and menu.links.size > 0 %}
      {% for link in menu.links limit: 5 %}
        <a href="{{ link.url }}" class="bottom-nav__item{% if link.active %} bottom-nav__item--active{% endif %}">
          <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none" aria-hidden="true">
            {% case forloop.index %}
              {% when 1 %}
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              {% when 2 %}
                <rect x="2" y="2" width="20" height="20" rx="2"/>
                <line x1="2" y1="8" x2="22" y2="8"/>
              {% when 3 %}
                <circle cx="12" cy="12" r="9"/>
                <line x1="12" y1="7" x2="12" y2="17"/>
              {% when 4 %}
                <path d="M4 7h16v13H4z"/>
                <line x1="4" y1="11" x2="20" y2="11"/>
              {% else %}
                <circle cx="12" cy="12" r="9"/>
                <circle cx="12" cy="12" r="2"/>
              {% endcase %}
          </svg>
          <span>{{ link.title }}</span>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</nav>
