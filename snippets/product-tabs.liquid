{% comment %}
  FlyFlow Theme - Product Tabs (OS 2.0)
  Real ARIA tabs for product details, size guide, reviews, and shipping/returns.
  Usage: {% render 'product-tabs', product: product, section: section %}
{% endcomment %}

{% assign show_details_tab = section.settings.show_details_tab %}
{% assign show_size_guide_tab = section.settings.show_size_guide_tab %}
{% assign show_reviews_tab = section.settings.show_reviews_tab %}
{% assign show_shipping_tab = section.settings.show_shipping_returns_tab %}

{% assign active_tab = section.settings.initial_active_tab | default: 'details' %}
{% if active_tab == 'details' and show_details_tab == false %}
  {% assign active_tab = '' %}
{% elsif active_tab == 'size' and show_size_guide_tab == false %}
  {% assign active_tab = '' %}
{% elsif active_tab == 'reviews' and show_reviews_tab == false %}
  {% assign active_tab = '' %}
{% elsif active_tab == 'shipping' and show_shipping_tab == false %}
  {% assign active_tab = '' %}
{% endif %}
{% if active_tab == '' %}
  {% if show_details_tab %}
    {% assign active_tab = 'details' %}
  {% elsif show_size_guide_tab %}
    {% assign active_tab = 'size' %}
  {% elsif show_reviews_tab %}
    {% assign active_tab = 'reviews' %}
  {% elsif show_shipping_tab %}
    {% assign active_tab = 'shipping' %}
  {% endif %}
{% endif %}

{% assign has_reviews_app_block = false %}
{% for block in section.blocks %}
  {% if block.type == '@app' %}
    {% assign has_reviews_app_block = true %}
  {% endif %}
{% endfor %}

{% assign details_id = 'pdp-tab-details-' | append: section.id %}
{% assign size_id = 'pdp-tab-size-' | append: section.id %}
{% assign reviews_id = 'pdp-tab-reviews-' | append: section.id %}
{% assign shipping_id = 'pdp-tab-shipping-' | append: section.id %}

{% assign details_panel_id = 'pdp-panel-details-' | append: section.id %}
{% assign size_panel_id = 'pdp-panel-size-' | append: section.id %}
{% assign reviews_panel_id = 'pdp-panel-reviews-' | append: section.id %}
{% assign shipping_panel_id = 'pdp-panel-shipping-' | append: section.id %}

{% assign description_html = product.description | strip %}
{% assign description_parts = description_html | split: '</p>' %}
{% assign description_intro_text = description_parts.first | strip_html | strip %}
{% capture description_intro %}
  {% if description_intro_text != blank %}
    <p>{{ description_intro_text }}</p>
  {% endif %}
{% endcapture %}
{% assign description_remainder = '' %}
{% if description_parts.size > 1 %}
  {% for part in description_parts offset: 1 %}
    {% assign clean_part = part | strip %}
    {% if clean_part != blank %}
      {% assign description_remainder = description_remainder | append: clean_part | append: '</p>' %}
    {% endif %}
  {% endfor %}
{% endif %}
{% assign has_long_description = false %}
{% if description_remainder != blank %}
  {% assign has_long_description = true %}
{% endif %}

{% assign highlights_source = product.metafields.custom.highlights.value | default: product.metafields.custom.highlights | default: section.settings.default_highlights %}
{% assign highlights_lines = highlights_source | newline_to_br | split: '<br />' %}

{% assign material_value = product.metafields.custom.material.value | default: product.metafields.custom.material %}
{% assign care_value = product.metafields.custom.care.value | default: product.metafields.custom.care %}
{% assign fit_value = product.metafields.custom.fit.value | default: product.metafields.custom.fit %}

{% assign size_guide_ref = product.metafields.custom.size_guide.value %}
{% assign size_guide_page = blank %}
{% assign size_guide_html = '' %}
{% assign size_guide_headers = '' %}
{% assign size_guide_rows = '' %}

{% if size_guide_ref != blank %}
  {% if size_guide_ref.content != blank %}
    {% assign size_guide_page = size_guide_ref %}
  {% else %}
    {% assign size_guide_html = size_guide_ref.html | default: size_guide_ref.table_html %}
    {% assign size_guide_headers = size_guide_ref.headers.value | default: size_guide_ref.headers | default: size_guide_ref.columns.value | default: size_guide_ref.columns | default: size_guide_ref.column_headers.value | default: size_guide_ref.column_headers %}
    {% assign size_guide_rows = size_guide_ref.rows.value | default: size_guide_ref.rows | default: size_guide_ref.table_rows.value | default: size_guide_ref.table_rows %}
  {% endif %}
{% endif %}

{% if size_guide_page == blank and size_guide_html == blank and size_guide_rows == blank and section.settings.size_guide_default_page != blank %}
  {% assign size_guide_page = section.settings.size_guide_default_page %}
{% endif %}

{% assign size_measure_steps = section.settings.size_guide_measurement_steps | newline_to_br | split: '<br />' %}

{% assign shipping_page = blank %}
{% if section.settings.shipping_page_handle != blank %}
  {% assign shipping_page = pages[section.settings.shipping_page_handle] %}
{% endif %}
{% assign returns_page = blank %}
{% if section.settings.returns_page_handle != blank %}
  {% assign returns_page = pages[section.settings.returns_page_handle] %}
{% endif %}

{% assign shipping_content = '' %}
{% if shipping_page != blank and shipping_page.content != blank %}
  {% assign shipping_content = shipping_page.content %}
{% elsif section.settings.shipping_richtext != blank %}
  {% assign shipping_content = section.settings.shipping_richtext %}
{% else %}
  {% assign shipping_content = '<p>Shipping options and delivery estimates are shown at checkout.</p>' %}
{% endif %}

{% assign returns_content = '' %}
{% if returns_page != blank and returns_page.content != blank %}
  {% assign returns_content = returns_page.content %}
{% elsif section.settings.returns_richtext != blank %}
  {% assign returns_content = section.settings.returns_richtext %}
{% else %}
  {% assign returns_content = '<p>Returns are handled according to our return policy.</p>' %}
{% endif %}

{% assign faq_href = '' %}
{% if section.settings.faq_page_handle != blank and pages[section.settings.faq_page_handle] != blank %}
  {% assign faq_href = pages[section.settings.faq_page_handle].url %}
{% elsif section.settings.faq_link != blank %}
  {% assign faq_href = section.settings.faq_link %}
{% endif %}

{% assign return_policy_href = '' %}
{% assign return_policy_source = section.settings.return_policy_link_source | default: 'shop_policy' %}
{% if return_policy_source == 'shop_policy' %}
  {% if shop.refund_policy != blank and shop.refund_policy.url != blank %}
    {% assign return_policy_href = shop.refund_policy.url %}
  {% endif %}
{% elsif return_policy_source == 'page' %}
  {% if section.settings.return_policy_page_handle != blank and pages[section.settings.return_policy_page_handle] != blank %}
    {% assign return_policy_href = pages[section.settings.return_policy_page_handle].url %}
  {% endif %}
{% elsif return_policy_source == 'custom_url' and section.settings.return_policy_custom_url != blank %}
  {% assign return_policy_href = section.settings.return_policy_custom_url %}
{% endif %}

{% assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value %}
{% assign rating_count = product.metafields.reviews.rating_count | default: product.metafields.spr.reviews %}

{% if show_details_tab or show_size_guide_tab or show_reviews_tab or show_shipping_tab %}
  <div
    class="pdp-tabs pdp-tabs--{{ section.settings.tabs_style | default: 'tabs' }}"
    data-product-tabs
    data-sync-hash="true"
    data-mobile-style="{{ section.settings.tabs_style | default: 'tabs' }}"
  >
    <div class="pdp-tabs__frame">
      <div class="pdp-tabs__list" role="tablist" aria-label="Product information tabs">
        {% if show_details_tab %}
          <button
            type="button"
            class="pdp-tabs__tab{% if active_tab == 'details' %} is-active{% endif %}"
            id="{{ details_id }}"
            role="tab"
            aria-controls="{{ details_panel_id }}"
            aria-selected="{% if active_tab == 'details' %}true{% else %}false{% endif %}"
            tabindex="{% if active_tab == 'details' %}0{% else %}-1{% endif %}"
            data-tab
            data-tab-key="details"
            data-tab-hash="details"
          >
            Details
          </button>
        {% endif %}

        {% if show_size_guide_tab %}
          <button
            type="button"
            class="pdp-tabs__tab{% if active_tab == 'size' %} is-active{% endif %}"
            id="{{ size_id }}"
            role="tab"
            aria-controls="{{ size_panel_id }}"
            aria-selected="{% if active_tab == 'size' %}true{% else %}false{% endif %}"
            tabindex="{% if active_tab == 'size' %}0{% else %}-1{% endif %}"
            data-tab
            data-tab-key="size"
            data-tab-hash="size-guide"
          >
            Size Guide
          </button>
        {% endif %}

        {% if show_reviews_tab %}
          <button
            type="button"
            class="pdp-tabs__tab{% if active_tab == 'reviews' %} is-active{% endif %}"
            id="{{ reviews_id }}"
            role="tab"
            aria-controls="{{ reviews_panel_id }}"
            aria-selected="{% if active_tab == 'reviews' %}true{% else %}false{% endif %}"
            tabindex="{% if active_tab == 'reviews' %}0{% else %}-1{% endif %}"
            data-tab
            data-tab-key="reviews"
            data-tab-hash="reviews"
          >
            Reviews
          </button>
        {% endif %}

        {% if show_shipping_tab %}
          <button
            type="button"
            class="pdp-tabs__tab{% if active_tab == 'shipping' %} is-active{% endif %}"
            id="{{ shipping_id }}"
            role="tab"
            aria-controls="{{ shipping_panel_id }}"
            aria-selected="{% if active_tab == 'shipping' %}true{% else %}false{% endif %}"
            tabindex="{% if active_tab == 'shipping' %}0{% else %}-1{% endif %}"
            data-tab
            data-tab-key="shipping"
            data-tab-hash="shipping-returns"
          >
            Shipping &amp; Returns
          </button>
        {% endif %}
      </div>

      {% if show_details_tab %}
        <section
          class="pdp-tabs__panel rte"
          id="{{ details_panel_id }}"
          role="tabpanel"
          aria-labelledby="{{ details_id }}"
          {% unless active_tab == 'details' %}hidden{% endunless %}
          data-tab-panel
          data-tab-key="details"
        >
          <p class="pdp-tabs__eyebrow">Product Overview</p>
          {% if description_html != blank %}
            {{ description_intro }}
            {% if has_long_description %}
              <details class="pdp-tabs__more">
                <summary>Read more</summary>
                <div class="pdp-tabs__more-content">{{ description_remainder }}</div>
              </details>
            {% endif %}
          {% else %}
            {{ section.settings.details_intro_richtext }}
          {% endif %}

          <details class="pdp-tabs__accordion">
            <summary class="pdp-tabs__accordion-summary">
              <span class="pdp-tabs__subhead">Highlights</span>
            </summary>
            <div class="pdp-tabs__accordion-content">
              <ul class="pdp-tabs__bullet-list">
                {% if highlights_source contains '|' %}
                  {% assign highlights_list = highlights_source | split: '|' %}
                  {% for item in highlights_list %}
                    {% assign clean_item = item | strip %}
                    {% if clean_item != blank %}<li>{{ clean_item }}</li>{% endif %}
                  {% endfor %}
                {% elsif highlights_lines.size > 1 %}
                  {% for item in highlights_lines %}
                    {% assign clean_item = item | strip %}
                    {% if clean_item != blank %}<li>{{ clean_item }}</li>{% endif %}
                  {% endfor %}
                {% elsif highlights_source != blank %}
                  <li>{{ highlights_source }}</li>
                {% endif %}
              </ul>
            </div>
          </details>

          <details class="pdp-tabs__accordion">
            <summary class="pdp-tabs__accordion-summary">
              <span class="pdp-tabs__subhead">Specifications</span>
            </summary>
            <div class="pdp-tabs__accordion-content">
              <dl class="pdp-tabs__spec-grid">
                {% if material_value != blank %}
                  <div><dt>Material</dt><dd>{{ material_value }}</dd></div>
                {% endif %}
                {% if fit_value != blank %}
                  <div><dt>Fit</dt><dd>{{ fit_value }}</dd></div>
                {% endif %}
                {% for block in section.blocks %}
                  {% if block.type == 'tab_spec' and block.settings.label != blank and block.settings.value != blank %}
                    <div>
                      <dt>{{ block.settings.label }}</dt>
                      <dd>{{ block.settings.value }}</dd>
                    </div>
                  {% endif %}
                {% endfor %}
              </dl>
            </div>
          </details>

          <details class="pdp-tabs__accordion">
            <summary class="pdp-tabs__accordion-summary">
              <span class="pdp-tabs__subhead">Care &amp; Fit</span>
            </summary>
            <div class="pdp-tabs__accordion-content">
              <div class="pdp-tabs__care-fit">
                <div>
                  <h4>Care</h4>
                  {% if care_value != blank %}
                    <p>{{ care_value }}</p>
                  {% else %}
                    {{ section.settings.details_care_richtext }}
                  {% endif %}
                </div>
                <div>
                  <h4>Fit</h4>
                  {% if fit_value != blank %}
                    <p>{{ fit_value }}</p>
                  {% else %}
                    {{ section.settings.details_fit_richtext }}
                  {% endif %}
                </div>
              </div>
            </div>
          </details>
        </section>
      {% endif %}

      {% if show_size_guide_tab %}
        <section
          class="pdp-tabs__panel"
          id="{{ size_panel_id }}"
          role="tabpanel"
          aria-labelledby="{{ size_id }}"
          {% unless active_tab == 'size' %}hidden{% endunless %}
          data-tab-panel
          data-tab-key="size"
        >
          {{ section.settings.size_guide_intro_richtext }}

          {% if section.settings.size_guide_diagram_image != blank %}
            <div class="pdp-size-guide__diagram">
              {{ section.settings.size_guide_diagram_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Size guide diagram' }}
            </div>
          {% endif %}

          {% if size_measure_steps.size > 0 %}
            <p class="pdp-tabs__subhead">How to Measure</p>
            <ol class="pdp-tabs__steps">
              {% for step in size_measure_steps %}
                {% assign clean_step = step | strip %}
                {% if clean_step != blank %}
                  <li>{{ clean_step }}</li>
                {% endif %}
              {% endfor %}
            </ol>
          {% endif %}

          {% if size_guide_html != blank %}
            <div class="pdp-size-guide__table-wrap rte">{{ size_guide_html }}</div>
          {% elsif size_guide_page != blank %}
            <div class="pdp-size-guide__table-wrap rte">{{ size_guide_page.content }}</div>
          {% elsif size_guide_headers != blank and size_guide_rows != blank %}
            {% assign headers = size_guide_headers %}
            {% if size_guide_headers contains '|' %}
              {% assign headers = size_guide_headers | split: '|' %}
            {% elsif size_guide_headers contains ',' %}
              {% assign headers = size_guide_headers | split: ',' %}
            {% endif %}
            {% assign rows = size_guide_rows | newline_to_br | split: '<br />' %}
            <div class="pdp-size-guide__table-wrap">
              <table class="pdp-size-guide__table">
                <thead>
                  <tr>
                    {% for header in headers %}
                      <th scope="col">{{ header | strip }}</th>
                    {% endfor %}
                  </tr>
                </thead>
                <tbody>
                  {% for row in rows %}
                    {% assign clean_row = row | strip %}
                    {% if clean_row != blank %}
                      {% if clean_row contains '|' %}
                        {% assign row_cells = clean_row | split: '|' %}
                      {% elsif clean_row contains ',' %}
                        {% assign row_cells = clean_row | split: ',' %}
                      {% else %}
                        {% assign row_cells = clean_row | split: ';' %}
                      {% endif %}
                      <tr>
                        {% for cell in row_cells %}
                          <td>{{ cell | strip }}</td>
                        {% endfor %}
                      </tr>
                    {% endif %}
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            {% if request.design_mode %}
              <p class="pdp-tabs__compact-note">Add a size guide for this product.</p>
            {% endif %}
          {% endif %}

          {{ section.settings.size_guide_fit_notes_richtext }}

          {% if section.settings.size_guide_help_link != blank %}
            <div class="pdp-tabs__help-row">
              <a href="{{ section.settings.size_guide_help_link }}">{{ section.settings.size_guide_help_label | default: 'Need help choosing a size?' }}</a>
            </div>
          {% endif %}
        </section>
      {% endif %}

      {% if show_reviews_tab %}
        <section
          class="pdp-tabs__panel"
          id="{{ reviews_panel_id }}"
          role="tabpanel"
          aria-labelledby="{{ reviews_id }}"
          {% unless active_tab == 'reviews' %}hidden{% endunless %}
          data-tab-panel
          data-tab-key="reviews"
        >
          {% if rating_value != blank %}
            <div class="pdp-tabs__rating-summary" aria-label="Average rating {{ rating_value }} out of 5">
              <span>Average rating</span>
              <strong>{{ rating_value }}/5</strong>
              {% if rating_count != blank %}<span>({{ rating_count }})</span>{% endif %}
            </div>
          {% endif %}

          {% if has_reviews_app_block %}
            {% for app_block in section.blocks %}
              {% if app_block.type == '@app' %}
                <div class="pdp-tabs__app-block" {{ app_block.shopify_attributes }}>
                  {% render app_block %}
                </div>
              {% endif %}
            {% endfor %}
          {% else %}
            <div class="pdp-tabs__empty-state">
              <h3>{{ section.settings.reviews_empty_state_title }}</h3>
              {{ section.settings.reviews_empty_state_body_richtext }}

              <div class="pdp-tabs__faq-list">
                {% for block in section.blocks %}
                  {% if block.type == 'reviews_faq' %}
                    <details class="pdp-tabs__faq-item" {{ block.shopify_attributes }}>
                      <summary>{{ block.settings.question }}</summary>
                      <div>{{ block.settings.answer }}</div>
                    </details>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </section>
      {% endif %}

      {% if show_shipping_tab %}
        <section
          class="pdp-tabs__panel rte"
          id="{{ shipping_panel_id }}"
          role="tabpanel"
          aria-labelledby="{{ shipping_id }}"
          {% unless active_tab == 'shipping' %}hidden{% endunless %}
          data-tab-panel
          data-tab-key="shipping"
        >
          {{ section.settings.shipping_returns_intro_richtext }}

          <div class="pdp-tabs__shipping-accordion-group">
            <details class="pdp-tabs__shipping-accordion">
              <summary class="pdp-tabs__shipping-summary">
                <span>Shipping</span>
                <span class="pdp-tabs__chevron" aria-hidden="true"></span>
              </summary>
              <div class="pdp-tabs__shipping-content">
                <div class="pdp-tabs__shipping-content-inner">{{ shipping_content }}</div>
              </div>
            </details>

            <details class="pdp-tabs__shipping-accordion">
              <summary class="pdp-tabs__shipping-summary">
                <span>Returns</span>
                <span class="pdp-tabs__chevron" aria-hidden="true"></span>
              </summary>
              <div class="pdp-tabs__shipping-content">
                <div class="pdp-tabs__shipping-content-inner">{{ returns_content }}</div>
              </div>
            </details>
          </div>

          {{ section.settings.order_processing_note_richtext }}

          {% if faq_href != blank or return_policy_href != blank %}
            <div class="pdp-tabs__help-row pdp-tabs__help-row--links">
              {% if faq_href != blank %}
                <a href="{{ faq_href }}">{{ section.settings.faq_link_label | default: 'Read FAQ' }}</a>
              {% endif %}
              {% if return_policy_href != blank %}
                <a href="{{ return_policy_href }}">{{ section.settings.return_policy_link_label | default: 'View return policy' }}</a>
              {% endif %}
            </div>
          {% endif %}
        </section>
      {% endif %}
    </div>
  </div>
{% endif %}
